@@ -0,0 +1,37 @@
+# -*- coding: utf-8 -*-
+"""回归（issue #325）：世界门面的 size 有上限，超限在建世界前被拒，不再按 size² 吃内存。"""
+import warnings
+import pytest
+
+warnings.filterwarnings("ignore")
+from lingshu.core.core import SpacetimeMemoryEngine
+from lingshu.world.voxel_world import VoxelWorld, MAX_WORLD_SIZE
+
+
+@pytest.mark.parametrize("call", [
+    lambda e, n: e.scene_simulator("create", {"size": n, "trees": 0}),
+    lambda e, n: e.voxel_world("build", {"size": n}),
+    lambda e, n: e.wm_simloop("setup", {"size": n}),
+])
+def test_oversize_rejected_before_allocation(call):
+    e = SpacetimeMemoryEngine(":memory:")
+    with pytest.raises(ValueError, match="上限"):
+        call(e, 100000)          # 改前：按 size² 建 dict，直接 OOM 杀进程
+
+
+def test_world_class_rejects_oversize():
+    with pytest.raises(ValueError):
+        VoxelWorld(size=MAX_WORLD_SIZE + 1)
+
+
+def test_normal_sizes_still_work():
+    e = SpacetimeMemoryEngine(":memory:")
+    assert e.scene_simulator("create", {"size": 64, "trees": 0})["status"] == "ok"
+    assert VoxelWorld(size=MAX_WORLD_SIZE).size == MAX_WORLD_SIZE
+
+
+def test_env_override(monkeypatch):
+    monkeypatch.setenv("LINGSHU_MAX_WORLD_SIZE", "32")
+    with pytest.raises(ValueError):
+        VoxelWorld(size=33)
+    assert VoxelWorld(size=32).size == 32
