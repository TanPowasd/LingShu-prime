diff --git a/lingshu/world/voxel_world.py b/lingshu/world/voxel_world.py
index 9f55e6d..72ca189 100644
--- a/lingshu/world/voxel_world.py
+++ b/lingshu/world/voxel_world.py
@@ -59,6 +59,20 @@ class VoxelEntity:
         return asdict(self)
 
 
+# issue #325：build_flatland 按 size² 建 dict（size=1000 约 2.5 s / 236 MB，size=10000 约 24 GB），
+# 8 个世界门面都把 params["size"] 原样传到这里；上限在构造处统一设一道，超限直接 ValueError，不建世界。
+# needs-owner-decision：512（约 57 MB）为本提交自拟；可用环境变量 LINGSHU_MAX_WORLD_SIZE 调整。
+MAX_WORLD_SIZE = 512
+
+
+def _max_world_size() -> int:
+    import os as _os
+    try:
+        return max(1, int(_os.environ.get("LINGSHU_MAX_WORLD_SIZE", MAX_WORLD_SIZE)))
+    except ValueError:
+        return MAX_WORLD_SIZE
+
+
 class VoxelWorld:
     """体素世界：区块 + 方块 + 动态实体 + 时空轨迹。
 
@@ -72,6 +86,9 @@ class VoxelWorld:
     """
 
     def __init__(self, size: int = 16, ground_level: int = 1, seed: int = 0):
+        if int(size) > _max_world_size():
+            raise ValueError("size=%d 超过世界边长上限 %d（issue #325：内存/耗时按 size² 增长；"
+                             "可用 LINGSHU_MAX_WORLD_SIZE 调整）" % (int(size), _max_world_size()))
         self.size = size                  # 区块边长
         self.ground_level = ground_level  # 地面高度
         self.blocks: Dict[Tuple[int, int, int], int] = {}  # (x,y,z) -> block
