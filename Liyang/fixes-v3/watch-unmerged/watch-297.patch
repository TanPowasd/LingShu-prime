index 0000000..e238d52
--- /dev/null
+++ b/tests/test_issue297_dedup_beyond_top200.py
@@ -0,0 +1,29 @@
+"""issue #297：M5 去重视野不得只限于 importance/last_access 前 200 条知识节点。"""
+from lingshu.core.core import SpacetimeMemoryEngine, MemoryLayer
+
+TEXT = "用户对青霉素过敏，处方时须避开"
+
+
+def _copies(e):
+    return sum(1 for n in e.store.query_nodes(layer=MemoryLayer.KNOWLEDGE, limit=-1)
+               if n.content == TEXT)
+
+
+def test_dedup_sees_nodes_beyond_top200():
+    e = SpacetimeMemoryEngine()
+    target = e.add_perception(TEXT)
+    for i in range(210):
+        e.add_perception(f"第{i}条日常观测记录：编号{i*7919}，主题{i%13}", skip_dedup=True)
+    d = e.add_perception(TEXT)
+    assert d.id == target.id
+    assert _copies(e) == 1
+
+
+def test_dedup_beyond_top200_still_distinguishes_unrelated():
+    e = SpacetimeMemoryEngine()
+    e.add_perception(TEXT)
+    for i in range(210):
+        e.add_perception(f"第{i}条日常观测记录：编号{i*7919}，主题{i%13}", skip_dedup=True)
+    other = e.add_perception("明天下午三点在三号会议室评审预算方案")
+    assert other.content != TEXT
+    assert _copies(e) == 1
