+    def dedup_candidates(self, content: str, modality: str = "text",
+                         limit: int = 200, probe: int = 12) -> List[STNode]:
+        """M5 去重候选（issue #297）：知识层按活跃度取前 limit 条，再并上与 content
+        共享均匀抽样二元组的节点（SQL LIKE 预筛），使较早写入的逐字重复也可见。
+        Jaccard 阈值 ≥0.85 时，真重复必共享绝大多数二元组，抽样 probe 个即稳命中。"""
+        nodes = self.query_nodes(layer=MemoryLayer.KNOWLEDGE, modality=modality, limit=limit)
+        seen = {n.id for n in nodes}
+        s = "".join(content.split())
+        grams = sorted({s[i:i + 2] for i in range(len(s) - 1)}) if len(s) > 1 else [s]
+        if not grams:
+            return nodes
+        step = max(1, len(grams) // probe)
+        picked = grams[::step][:probe]
+        try:
+            like_max = self.conn.getlimit(sqlite3.SQLITE_LIMIT_LIKE_PATTERN_LENGTH)
+        except Exception:
+            like_max = 50000
+        parts, params = [], []
+        for g in picked:
+            pat = "%" + _like_escape(g) + "%"
+            if len(pat.encode("utf-8")) > like_max:
+                continue
+            parts.append("content LIKE ? ESCAPE '\\'")
+            params.append(pat)
+        if not parts:
+            return nodes
+        c = self.conn.cursor()
+        c.execute(f"SELECT * FROM nodes WHERE layer=? AND modality=? AND ({' OR '.join(parts)})",
+                  [MemoryLayer.KNOWLEDGE.value, modality] + params)
+        for row in c.fetchall():
+            n = STNode.from_row(tuple(row))
+            if n.id not in seen:
+                seen.add(n.id)
+                nodes.append(n)
+        return nodes
+
