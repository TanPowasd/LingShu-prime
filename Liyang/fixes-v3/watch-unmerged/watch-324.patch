diff --git a/lingshu/core/world_facade.py b/lingshu/core/world_facade.py
index 81c4bbd..0c613e5 100644
--- a/lingshu/core/world_facade.py
+++ b/lingshu/core/world_facade.py
@@ -300,6 +300,32 @@ class WorldFacadeMixin:
                     "load": sl.load_priors(str(p.get("mdcg_root", "")))}
         if action == "flush":
             out = p.get("out_path")
+            if out:
+                # issue #324：out_path 限定在输出根内（LINGSHU_FLUSH_ROOT，缺省 cwd）并只收 .md/.markdown，
+                # realpath+commonpath 判包含性（挡 ../、绝对路径、符号链接逃逸）；已存在且不是 flush 产物的文件不覆盖。
+                root = os.path.realpath(os.environ.get("LINGSHU_FLUSH_ROOT") or os.getcwd())
+                full = os.path.realpath(os.path.join(root, str(out)))
+                ext = os.path.splitext(full)[1].lower()
+                if ext not in (".md", ".markdown"):
+                    return {"status": "error",
+                            "error": "flush 输出扩展名 %r 不在白名单 (.md/.markdown)" % ext}
+                try:
+                    inside = os.path.commonpath([root, full]) == root
+                except ValueError:
+                    inside = False
+                if not inside:
+                    return {"status": "error",
+                            "error": "flush 输出路径越出输出根（LINGSHU_FLUSH_ROOT，缺省 cwd）"}
+                if os.path.exists(full):
+                    try:
+                        with open(full, "rb") as _f:
+                            head = _f.read(64)
+                    except OSError:
+                        head = b""
+                    if not head.startswith(b'---\nid: "wm_simloop_'):
+                        return {"status": "error",
+                                "error": "flush 目标已存在且不是 wm_simloop 产物，拒绝覆盖"}
+                out = full
             r = sl.flush_payloads(out_path=str(out) if out else None)
             return {"status": "ok",
                     "flush": {k: r[k] for k in ("payload", "written", "note")}}
