+# -*- coding: utf-8 -*-
+"""回归（issue #324）：wm_simloop("flush") 的 out_path 限定在输出根内、只收 .md、不覆盖非产物文件。"""
+import os
+import sqlite3
+import warnings
+import pytest
+
+warnings.filterwarnings("ignore")
+from lingshu.core.core import SpacetimeMemoryEngine
+
+
+@pytest.fixture
+def env(tmp_path, monkeypatch):
+    root = tmp_path / "out"
+    root.mkdir()
+    monkeypatch.setenv("LINGSHU_FLUSH_ROOT", str(root))
+    e = SpacetimeMemoryEngine(":memory:")
+    e.wm_simloop("setup", {"wal_path": str(tmp_path / "wal.jsonl")})
+    return e, root, tmp_path
+
+
+def test_inside_root_md_ok(env):
+    e, root, _ = env
+    r = e.wm_simloop("flush", {"out_path": "snap.md"})
+    assert r["status"] == "ok" and os.path.isfile(root / "snap.md")
+    r2 = e.wm_simloop("flush", {"out_path": "snap.md"})      # 覆盖自己的产物允许
+    assert r2["status"] == "ok"
+
+
+def test_no_out_path_still_returns_payload(env):
+    e, _, _ = env
+    assert e.wm_simloop("flush", {})["flush"]["payload"]["body_md"]
+
+
+@pytest.mark.parametrize("bad", ["../escaped.md", "ABS"])
+def test_escape_rejected(env, bad):
+    e, root, tmp = env
+    target = str(tmp / "escaped.md") if bad == "ABS" else bad
+    r = e.wm_simloop("flush", {"out_path": target})
+    assert r["status"] == "error" and not os.path.exists(tmp / "escaped.md")
+
+
+def test_extension_whitelist(env):
+    e, root, _ = env
+    r = e.wm_simloop("flush", {"out_path": "fake_bashrc"})
+    assert r["status"] == "error" and not os.path.exists(root / "fake_bashrc")
+
+
+def test_refuses_to_overwrite_non_product_file(env, tmp_path, monkeypatch):
+    e, root, _ = env
+    db = root / "brain.md"                                     # 即使扩展名合规，也不覆盖非产物
+    c = sqlite3.connect(str(db)); c.execute("create table nodes(x)"); c.commit(); c.close()
+    r = e.wm_simloop("flush", {"out_path": "brain.md"})
+    assert r["status"] == "error"
+    assert open(db, "rb").read(15) == b"SQLite format 3"
