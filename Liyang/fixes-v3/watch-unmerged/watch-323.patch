+# -*- coding: utf-8 -*-
+"""回归（issue #323）：假设节点摘除（回退/重生长）后，以它为源的推断边一并摘除，不再悬空累积。"""
+import os
+import tempfile
+import warnings
+
+warnings.filterwarnings("ignore")
+from lingshu.world.wm_simloop import SimulationLoop
+
+
+def _loop():
+    wal = os.path.join(tempfile.mkdtemp(), "wal.jsonl")
+    L = SimulationLoop(seed=42, wal_path=wal, clock=lambda: 0.0)
+    L.scene.create_scene(trees=4, water=False)
+    for i in range(6):
+        L.scene.add_entity("rabbit", behavior="wander", pos=(4 + i * 2, 1.5, 10 + i), speed=0.6)
+    for i in range(3):
+        L.scene.add_entity("wolf", behavior="wander", pos=(2 + i * 3, 1.5, 6), speed=0.8)
+    L.wm.perceive(observations=L._observe())
+    return L
+
+
+def _dangling(L):
+    live = set(L.wm.nodes)
+    return [e for e in L.wm.edges if e.source not in live or e.target not in live]
+
+
+def test_no_dangling_edges_after_long_run():
+    L = _loop()
+    L.step(500)                      # 改前：338 条边中 270 条悬空（源为已删假设）
+    assert _dangling(L) == []
+
+
+def test_edge_count_stays_proportional_to_nodes():
+    L = _loop()
+    L.step(800)                      # 改前：节点 ~16、边数随 tick 线性增长（500 tick 已 338 条）
+    assert len(L.wm.edges) <= 3 * len(L.wm.nodes)
+
+
+def test_revert_drops_edges_sourced_at_hypothesis():
+    from lingshu.world.world_model import WMEdge
+    L = _loop()
+    L.step(120)
+    subj = next(iter(L._hypotheses), None)
+    if subj is None:
+        return
+    h = L._hypotheses[subj]
+    other = next(k for k in L.wm.nodes if k != h["node"])
+    L.wm.edges.append(WMEdge(source=h["node"], relation="seek", target=other,
+                             confidence=0.5, evidence="inferred"))
+    L._revert(h, "test")
+    assert [e for e in L.wm.edges if e.source == h["node"]] == []
