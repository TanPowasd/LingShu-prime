+from lingshu.world.world_model import UnifiedWorldModel
+wm = UnifiedWorldModel(size=24)
+sc = wm.world
+D = sc.add_entity("rock",   behavior="wander", pos=(20, 1.5, 23), speed=0.0)
+B = sc.add_entity("rabbit", behavior="seek", goal=D, pos=(20, 1.5, 6), speed=0.1)   # B 直线慢行（方向一致性=1）
+C = sc.add_entity("deer",   behavior="wander", pos=(2, 1.5, 12), speed=0.0)
+A = sc.add_entity("wolf",   behavior="seek", goal=B, pos=(12, 1.5, 12), speed=0.5)
+name = {D: "D", B: "B", C: "C", A: "A"}
+wm.perceive()
+wm.verify_run(8)
+show = lambda: [(name[e.source], e.relation, name[e.target], e.confidence) for e in wm.edges if e.source == A]
+print("阶段1（A 追 B）A 的出边:", show())
+sc.entities[A].goal = C            # 世界里 A 改追 C（方向与 B 大致相反）
+hits = []
+for _ in range(15):
+    r = wm.verify_run(1)
+    d = [x for x in r["last"]["details"] if x["entity"] == A][0]
+    hits.append((d["mode"], d["hit"], d["distance"]))
+print("阶段2（A 改追 C，15 tick 后）A 的出边:", show())
+print("阶段2 A 的 (mode, hit, dist):")
+for x in hits: print("  ", x)
+print("最近 8 tick 趋向: A→B =", wm._pair_tendency(A, B), " A→C =", wm._pair_tendency(A, C))
+print("generate 实际使用的边:", next((name[e.target], e.relation) for e in wm.edges if e.source == A))
+print("A 命中率(阶段2) =", sum(h[1] for h in hits), "/", len(hits))
+stale = any(e.source == A and e.target == B for e in wm.edges)
+misses = sum(1 for m, h, _ in hits if m == "exact" and not h)
+print("BUG" if stale or misses > 2 else "OK", f"(旧边仍在={stale}, exact 未命中={misses}/15)")
