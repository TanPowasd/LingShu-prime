+# nn-07 · rust_bridge.make_plan 把参数总数写死为 375（K1=6/K2=6/head 9×9）：
+#   其它规模的网络要么 IndexError（K<6），要么一部分参数（含整个 head）永远不被采样
+# 运行：在仓库根目录 PYTHONPATH=. python _out/repro/nn-07.py（不需要 hex_nn.exe）
+import numpy as np
+from lingshu.nn.rust_bridge import make_plan, py_executor
+from lingshu.nn.hex_hier import HexHierNet, make_scene_dataset, OBJ, SHAPES
+from lingshu.nn.hex_cnn import image_to_grid
+from lingshu.nn.hex_train import normalize_lattices
+
+
+def plan_for(net, n, **kw):
+    try:                                   # 修复后：采样空间随网络规模
+        return make_plan(n, n_params=net.n_params(), **kw)
+    except TypeError:                      # 基线：签名里没有规模信息
+        return make_plan(n, **kw)
+
+
+imgs, lab = make_scene_dataset(40, 48, seed=1)
+lat = normalize_lattices(np.stack([image_to_grid(im, 16)[0] / 255.0 for im in imgs]))
+oi = np.array([OBJ.index(o) for o in lab["obj"]]); si = np.array([SHAPES.index(s) for s in lab["shape"]])
+
+bug = False
+for kw in [dict(n_kernels=6, n_kernels2=6), dict(n_kernels=6, n_kernels2=6, deep_norm=True, amp_sep=True),
+           dict(n_kernels=8, n_kernels2=8), dict(n_kernels=4, n_kernels2=4)]:
+    net = HexHierNet(**kw); n = net.n_params()
+    plan = plan_for(net, len(lat), steps=200, batch=8, samples=64, seed=7)
+    idx = set(i for s in plan["plan_sample"] for i in s)
+    never = n - len(idx & set(range(n))); oob = len([i for i in idx if i >= n])
+    bug |= bool(never or oob)
+    print(f"{str(kw):<62} n_params={n:<4} 采样上界={max(idx)}  永不采样参数={never:<4} 越界索引={oob}")
+
+for kw in (dict(n_kernels=8, n_kernels2=8), dict(n_kernels=4, n_kernels2=4)):
+    net = HexHierNet(**kw); v0 = net.get_vec().copy()
+    plan = plan_for(net, len(lat), steps=30, batch=8, samples=64, seed=7)
+    try:
+        py_executor(lat, oi, si, v0.copy(), plan, net)
+        v1 = net.get_vec(); head0 = v0.size - net.head.size
+        ch = int((v1[head0:] != v0[head0:]).sum()); bug |= ch == 0
+        print(kw, "head 参数变化个数 =", ch, "/", net.head.size,
+              "| 卷积参数变化个数 =", int((v1[:head0] != v0[:head0]).sum()), "/", head0)
+    except Exception as e:
+        bug = True
+        print(kw, "->", type(e).__name__, e)
+print("BUG" if bug else "OK")
