@@ -0,0 +1,44 @@
+# -*- coding: utf-8 -*-
+"""issue #192（部分）：F3 固化后假设节点 attrs.phase 同步为 confirmed；F4 run() 的 rolling_hit_rate 为本次窗口均值。
+F1（通道② persistence_min=0.45 落在随机游走分布内的假阳性）属阈值口径裁定，另记 design，不在本测。"""
+import math
+import warnings
+
+from lingshu.world.wm_simloop import SimulationLoop
+
+warnings.filterwarnings("ignore")
+
+
+def _selftest_loop():
+    sl = SimulationLoop(wal_path=None)
+    sl.scene.create_scene(trees=0, water=False)
+    t = sl.scene.add_entity("rabbit", behavior="wander", pos=(6, 1.5, 13), speed=0.0)
+    sl.scene.add_entity("wolf", behavior="seek", goal=t, pos=(2, 1.5, 13), speed=0.8)
+    sl._mask = {t}
+    sl.wm.perceive(observations=sl._observe())
+
+    def drifting(scene, tick):
+        scene.entities[t].pos = (3.0 + 0.55 * tick + 2.5 * math.sin(tick * 0.45), 1.5, 13.0)
+    return sl, drifting
+
+
+def test_confirmed_phase_written_to_node_attrs():
+    sl, drifting = _selftest_loop()
+    sl.step(n=1)
+    sl.step(n=30, external=drifting)
+    assert any(g["event"] == "confirm" for g in sl._growth_log)
+    confirmed = {v["node"] for v in sl._hypotheses.values() if v["phase"] == "confirmed"}
+    assert confirmed
+    for hid in confirmed:
+        assert sl.wm.nodes[hid].attrs["phase"] == "confirmed"
+
+
+def test_run_rolling_rate_is_window_mean():
+    sl, _ = _selftest_loop()
+    sl.run(n=5)
+    k0 = len(sl._rolling_rates)
+    r = sl.run(n=7)
+    win = sl._rolling_rates[k0:]
+    assert len(win) == 7
+    assert r["rolling_hit_rate"] == round(sum(win) / len(win), 4)
+    assert r["lifetime_hit_rate"] == round(sum(sl._rolling_rates) / len(sl._rolling_rates), 4)
