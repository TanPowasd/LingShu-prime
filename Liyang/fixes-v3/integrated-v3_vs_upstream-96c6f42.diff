+# -*- coding: utf-8 -*-
+"""回归：export_coggraph 的 derived_from 写成 YAML 列表时边不丢失（新发现 core2-new-02）。"""
+import importlib.util
+import json
+import os
+
+_TOOL = os.path.join(os.path.dirname(__file__), "..", "tools", "coggraph", "export_coggraph.py")
+
+
+def _main(argv):
+    spec = importlib.util.spec_from_file_location("export_coggraph_df_under_test", _TOOL)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod.main(argv)
+
+
+def _md(root, rel, fm):
+    p = os.path.join(root, rel)
+    os.makedirs(os.path.dirname(p), exist_ok=True)
+    with open(p, "w", encoding="utf-8") as f:
+        f.write("---\n" + fm.strip() + "\n---\n正文\n")
+
+
+def _edges(tmp_path):
+    out = tmp_path / "out"
+    assert _main(["--root", str(tmp_path / "r"), "--out", str(out), "--write"]) == 0
+    g = json.loads((out / "graph.json").read_text(encoding="utf-8"))
+    return sorted((e["s"], e["t"]) for e in g["edges"] if e["type"] == "derived_from")
+
+
+def test_derived_from_block_list(tmp_path):
+    r = tmp_path / "r"
+    _md(r, "knowledge/c/a.md", "id: a\nlayer: knowledge")
+    _md(r, "knowledge/c/b.md", "id: b\nlayer: knowledge")
+    _md(r, "knowledge/c/c.md", "id: c\nlayer: knowledge\nderived_from:\n  - a\n  - b")
+    assert _edges(tmp_path) == [("c", "a"), ("c", "b")]
+
+
+def test_derived_from_flow_list_and_scalar_string(tmp_path):
+    r = tmp_path / "r"
+    _md(r, "knowledge/c/a.md", "id: a\nlayer: knowledge")
+    _md(r, "knowledge/c/b.md", "id: b\nlayer: knowledge")
+    _md(r, "knowledge/c/c.md", "id: c\nlayer: knowledge\nderived_from: [a, b]")
+    _md(r, "knowledge/c/d.md", "id: d\nlayer: knowledge\nderived_from: a, b")  # 既有标量写法不回归
+    assert _edges(tmp_path) == [("c", "a"), ("c", "b"), ("d", "a"), ("d", "b")]
