+# -*- coding: utf-8 -*-
+"""回归（issue #259）：情境层 FIFO 与「最近情境」按写入顺序，不按墙钟 created_at。"""
+import time
+import warnings
+
+warnings.filterwarnings("ignore")
+from lingshu.core.core import SpacetimeMemoryEngine, Role, MemoryLayer  # noqa: E402
+
+
+def test_clock_rollback_does_not_evict_new_write():
+    e = SpacetimeMemoryEngine(":memory:")
+    e.set_context_cap(5)
+    for i in range(5):
+        e.add_context(f"校正前的情境 {i}")
+    e.store.conn.execute("UPDATE nodes SET created_at = created_at + 86400 WHERE layer='context'")
+    e.store.conn.commit()
+    new = e.add_context("用户：刚才说的地址写错了，正确的是 3 号楼 502")
+    assert e.store.get_node(new.id) is not None
+    assert e.get_recent_context(1)[0].id == new.id
+    alive = [e.store.get_node(e.add_context(f"校正后第 {i} 条").id) is not None for i in range(20)]
+    assert all(alive)
+    assert e.store.count_layer(MemoryLayer.CONTEXT) == 5
+
+
+def test_future_timestamps_cannot_pin_context_layer():
+    e = SpacetimeMemoryEngine(":memory:", role=Role.SUB)
+    e.set_context_cap(5)
+    for i in range(5):
+        n = e.add_context(f"占位 {i}", importance=0.1)
+        n.created_at = time.time() + 10 * 365 * 86400
+        e.store.add_node(n)
+    alive = [e.store.get_node(e.add_context(f"真实情境 {i}", importance=0.9).id) is not None
+             for i in range(20)]
+    assert all(alive)
+    assert all(n.content.startswith("真实情境") for n in e.get_recent_context(5))
diff --git a/tests/test_issue261_protection_sql_vars.py b/tests/test_issue261_protection_sql_vars.py
new file mode 100644
index 0000000..f2989f4
--- /dev/null
+++ b/tests/test_issue261_protection_sql_vars.py
@@ -0,0 +1,101 @@
+# -*- coding: utf-8 -*-
+"""回归（issue #261 / #257，同根）：保护名单不得展开成 SQL 绑定参数；保护登记随节点删除；
+不存在的节点不进保护名单；后台衰减线程遇异常不永久死亡、退出时复位 _running。"""
+import sqlite3
+import time
+import warnings
+
+warnings.filterwarnings("ignore")
+from lingshu.core.core import SpacetimeMemoryEngine  # noqa: E402
+
+
+def _engine(limit=999):
+    e = SpacetimeMemoryEngine(":memory:")
+    e.store.conn.setlimit(sqlite3.SQLITE_LIMIT_VARIABLE_NUMBER, limit)
+    return e
+
+
+def test_decay_survives_protections_over_variable_limit():
+    e = _engine(999)
+    a = e.add_context("用户说膝盖有旧伤，别推荐长距离徒步")
+    b = e.add_context("昨晚聊了周末去爬山")
+    edge = e.add_edge(a.id, b.id)
+    for i in range(1000):                       # 1000 条存活保护 > 999 // 2
+        k = e.add_perception(f"长期知识条目 {i}", importance=0.8, skip_dedup=True)
+        e.protect_node(k.id, "LongTermMemoryGate:chat")
+    imp0 = e.store.get_node(a.id).importance
+    conf0 = e.store.get_edge(edge.id).confidence
+    e.decay_cycle()                             # 改前：OperationalError too many SQL variables
+    assert e.store.get_node(a.id).importance < imp0
+    assert e.store.get_edge(edge.id).confidence < conf0
+    e.run_maintenance_cycle()                   # 维护链不被拖垮
+
+
+def test_protected_edges_still_excluded_from_decay():
+    e = _engine(999)
+    k = e.add_perception("受保护知识", importance=0.8, skip_dedup=True)
+    m = e.add_perception("普通知识", importance=0.5, skip_dedup=True)
+    e.protect_node(k.id, "x")
+    ed = e.add_edge(k.id, m.id)
+    c0 = e.store.get_edge(ed.id).confidence
+    for _ in range(5):
+        e.decay_cycle()
+    assert e.store.get_edge(ed.id).confidence == c0
+
+
+def test_protection_rows_follow_node_deletion():
+    e = _engine(999)
+    ids = []
+    for i in range(10):
+        k = e.add_perception(f"条目 {i}", importance=0.8, skip_dedup=True)
+        e.protect_node(k.id, "x")
+        ids.append(k.id)
+    for k in ids[:5]:
+        assert e.store.delete_node(k)
+    prot = set(e.get_protected_nodes())
+    assert prot == set(ids[5:])
+    # 情境层 FIFO 删除同样清登记
+    e.set_context_cap(3)
+    p = e.add_context("一次性验证码 482913")
+    e.protect_node(p.id, "demo")
+    for i in range(3):
+        e.add_context(f"闲聊 {i}")
+    if e.store.get_node(p.id) is None:
+        assert p.id not in e.get_protected_nodes()
+
+
+def test_nonexistent_id_not_protected_and_orphans_pruned():
+    e = _engine(999)
+    e.protect_node("no_such_id", "x")
+    assert "no_such_id" not in e.get_protected_nodes()
+    # 既有库里的孤儿行（如旧版本写入 / import_all 带入）在衰减周期内被回收
+    for i in range(20000):
+        e.store.conn.execute("INSERT INTO protections VALUES (?,?,?)", (f"gone_{i}", "old", 0.0))
+    e.store.conn.commit()
+    ctx = e.add_context("情境：用户十分钟后出发去机场", importance=0.4)
+    e.decay_cycle()
+    assert e.store.get_node(ctx.id).importance < 0.4
+    assert not any(x.startswith("gone_") for x in e.get_protected_nodes())
+
+
+def test_auto_decay_thread_survives_and_resets_running():
+    e = _engine(999)
+    calls = {"n": 0}
+    orig = e.store.decay_cycle
+
+    def flaky(*a, **k):
+        calls["n"] += 1
+        if calls["n"] == 1:
+            raise sqlite3.OperationalError("boom")
+        return orig(*a, **k)
+
+    e.store.decay_cycle = flaky
+    e.start_auto_decay(interval=0.02)
+    t = e._decay_thread
+    time.sleep(0.3)
+    assert t.is_alive(), "一轮异常不应让后台衰减线程退出"
+    assert calls["n"] >= 2
+    e.stop_auto_decay()
+    t.join(1.0)
+    assert not t.is_alive()
+    assert e._running is False
