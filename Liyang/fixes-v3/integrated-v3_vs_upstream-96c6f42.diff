+# -*- coding: utf-8 -*-
+"""回归（issue #239）：repro-bot 读数报告记录被测提交与 numpy/Pillow 版本；stdout/stderr 中的临时目录、
+workspace、HOME 中性化为占位符；执行核 --selftest 已接入 CI。"""
+import os
+import pathlib
+import subprocess
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+SCRIPT = ROOT / "scripts" / "extract_and_run_issue_repro.py"
+
+BODY = ('x\n```python\nimport os, sys\nprint(os.getcwd())\nprint(os.path.expanduser("~"))\n'
+        'raise SystemExit(open("nope.txt").read())\n```\n')
+
+
+def _run(tmp_path, *extra, env=None):
+    body = tmp_path / "body.md"
+    body.write_text(BODY, encoding="utf-8")
+    rep = tmp_path / "rep.md"
+    e = dict(os.environ, PYTHONUTF8="1")
+    e.update(env or {})
+    subprocess.run([sys.executable, "-X", "utf8", str(SCRIPT), "--body-file", str(body),
+                    "--report-file", str(rep), "--timeout", "60", *extra],
+                   capture_output=True, text=True, encoding="utf-8", env=e, timeout=90)
+    return rep.read_text(encoding="utf-8")
+
+
+def test_env_line_has_head_and_dep_versions(tmp_path):
+    rep = _run(tmp_path, "--head-sha", "0123456789abcdef0123456789abcdef01234567")
+    env_line = [l for l in rep.splitlines() if l.startswith("- **环境**")][0]
+    assert "HEAD=0123456789ab" in env_line
+    assert "numpy" in env_line and "Pillow" in env_line
+
+
+def test_head_defaults_to_git_rev_parse(tmp_path):
+    rep = _run(tmp_path)
+    env_line = [l for l in rep.splitlines() if l.startswith("- **环境**")][0]
+    assert "HEAD=" in env_line
+
+
+def test_output_paths_neutralized(tmp_path):
+    out = tmp_path / "outdir"
+    rep = _run(tmp_path, "--out-dir", str(out))
+    assert str(out) not in rep
+    assert os.path.realpath(str(out)) not in rep
+    assert "<临时目录>" in rep.split("#### 原始输出")[1]
+    home = os.path.expanduser("~")
+    if len(home) > 1:
+        assert home not in rep.split("#### 原始输出")[1]
+
+
+def test_selftest_wired_into_ci():
+    wf = "".join(p.read_text(encoding="utf-8") for p in (ROOT / ".github" / "workflows").glob("*.yml"))
+    assert "extract_and_run_issue_repro.py --selftest" in wf
+    assert "--head-sha" in (ROOT / ".github" / "workflows" / "repro-bot.yml").read_text(encoding="utf-8")
