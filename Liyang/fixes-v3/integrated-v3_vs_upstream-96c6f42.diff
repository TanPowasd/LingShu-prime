+# -*- coding: utf-8 -*-
+"""回归（issue #275）：组件 finder 只接管 lingshu 发起的组件导入；宿主脚本目录里的同名自有模块
+（vision/body/game_web/semantic_space）在 import lingshu.core 之后仍可导入（逃生口开关均然）。"""
+import os, subprocess, sys, tempfile
+import pytest
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+NAMES = ("vision", "body", "game_web", "semantic_space")
+
+
+@pytest.mark.parametrize("hatch", [None, "1"])
+def test_host_modules_with_component_names(hatch):
+    app = tempfile.mkdtemp(prefix="i275_")
+    for n in NAMES:
+        open(os.path.join(app, n + ".py"), "w").write("OWNER = 'host'\n")
+    open(os.path.join(app, "main.py"), "w").write(
+        "import lingshu.core.core\n"
+        "for m in %r:\n"
+        "    print(m, __import__(m).OWNER)\n" % (NAMES,))
+    env = {k: v for k, v in os.environ.items()
+           if k not in ("LINGSHU_ALLOW_CWD_IMPORTS", "LINGSHU_COMPONENT_ROOT")}
+    env["PYTHONPATH"] = REPO
+    if hatch:
+        env["LINGSHU_ALLOW_CWD_IMPORTS"] = hatch
+    r = subprocess.run([sys.executable, "-W", "ignore", os.path.join(app, "main.py")],
+                       cwd=tempfile.gettempdir(), env=env, capture_output=True, text=True, timeout=120)
+    assert r.returncode == 0, r.stderr[-400:]
+    assert r.stdout.split() == [w for n in NAMES for w in (n, "host")]
