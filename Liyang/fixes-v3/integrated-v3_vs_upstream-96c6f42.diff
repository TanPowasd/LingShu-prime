+# -*- coding: utf-8 -*-
+"""回归（issue #216 ①②③⑤）：负记忆同价、去重计数、技能带失败账、预测负记忆可按内容检索。
+（④ 被否决提案原文重提由 tests/test_issue216_rejected_promotion_loop.py 覆盖。）"""
+import warnings
+
+import pytest
+
+warnings.filterwarnings("ignore")
+from lingshu.core.core import SpacetimeMemoryEngine  # noqa: E402
+
+ACTS = ["停止服务", "rm -rf /data/db", "tar 恢复备份"]
+
+
+@pytest.fixture
+def eng():
+    e = SpacetimeMemoryEngine(":memory:")
+    yield e
+    e.close()
+
+
+def test_success_and_failure_same_importance(eng):          # ②
+    f = eng.record_action_sequence(ACTS, "数据全部丢失，备份为空", success=False)
+    s = eng.record_action_sequence(["部署 v1"], "成功上线", success=True)
+    assert f.importance == s.importance
+
+
+def test_rejected_path_dedup_and_count(eng):                 # ③
+    for _ in range(21):
+        eng.record_action_sequence(ACTS, "数据全部丢失，备份为空", success=False)
+    rows = [r for r in eng.list_rejected_paths("open") if r["path_type"] == "action_sequence"]
+    assert len(rows) == 1 and rows[0]["count"] == 21
+    hits = eng.find_rejected_paths(" > ".join(ACTS))
+    assert len(hits) == 1 and hits[0]["count"] == 21
+    # 不同序列仍各占一行
+    eng.record_action_sequence(["重启"], "无效", success=False)
+    assert len([r for r in eng.list_rejected_paths("open") if r["path_type"] == "action_sequence"]) == 2
+
+
+def test_register_rejected_path_returns_same_id_on_repeat(eng):
+    a = eng.register_rejected_path("manual", "某方案", "r1")
+    b = eng.register_rejected_path("manual", "某方案", "r2")
+    assert a == b
+    row = [r for r in eng.list_rejected_paths() if r["id"] == a][0]
+    assert row["count"] == 2 and row["reason"] == "r2"
+
+
+def test_skill_extracted_after_failures_carries_failure_count(eng):   # ①
+    for _ in range(21):
+        eng.record_action_sequence(ACTS, "数据全部丢失，备份为空", success=False)
+    eng.record_action_sequence(ACTS, "恢复成功", success=True, skill_hint="数据库恢复")
+    sk = eng.recall_skill("数据库恢复", limit=1)[0]
+    assert sk["name"] == "数据库恢复"
+    assert sk["failure_count"] == 21
+    assert sk["confidence"] < 0.5
+
+
+def test_skill_without_failures_unchanged(eng):
+    eng.record_action_sequence(["部署 v1"], "成功上线", success=True, skill_hint="部署")
+    sk = eng.recall_skill("部署", limit=1)[0]
+    assert sk["failure_count"] == 0 and sk["confidence"] == pytest.approx(0.5)
+
+
+def test_prediction_miss_searchable_by_content(eng):         # ⑤
+    from lingshu.world.prediction import PredictionEngine
+    a = eng.add_perception("按下红色按钮会让电梯上行", importance=0.7)
+    b = eng.add_perception("电梯实际下行", importance=0.7)
+    PredictionEngine(eng).update_prediction_feedback(a.id, b.id, hit=False)
+    rp = [r for r in eng.list_rejected_paths() if r["path_type"] == "prediction"]
+    assert len(rp) == 1 and "按下红色按钮会让电梯上行" in rp[0]["description"] and a.id in rp[0]["description"]
+    assert "电梯实际下行" in rp[0]["reason"]
+    assert len(eng.find_rejected_paths("按下红色按钮会让电梯上行")) == 1
