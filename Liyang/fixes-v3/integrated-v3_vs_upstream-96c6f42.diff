+# -*- coding: utf-8 -*-
+"""回归：LongTermMemoryGate.write_snapshot 回执层级与实际落库层一致（issue 草稿 core-rest-01）。"""
+import warnings
+
+import pytest
+
+warnings.filterwarnings("ignore")
+from lingshu.core.core import SpacetimeMemoryEngine, MemoryLayer  # noqa: E402
+
+
+@pytest.fixture
+def engine():
+    e = SpacetimeMemoryEngine()
+    yield e
+    try:
+        e.close()
+    except Exception:
+        pass
+
+
+def test_hint_below_knowledge_lands_in_context_layer(engine):
+    r = engine.longterm_snapshot("周三下午三点和导师讨论开题报告的修改意见", importance_hint=0.2)
+    node = engine.store.get_node(r["node_id"])
+    assert r["layer"] == "context"
+    assert node.layer == MemoryLayer.CONTEXT
+    assert r["stored_layer"] == node.layer.value
+
+
+def test_new_long_term_receipt_reports_stored_layer(engine):
+    r = engine.longterm_snapshot("实验室服务器的备份策略改为每日增量每周全量", importance_hint=0.9)
+    node = engine.store.get_node(r["node_id"])
+    assert r["layer"] == "long_term"
+    assert r["stored_layer"] == node.layer.value == MemoryLayer.KNOWLEDGE.value
+
+
+def test_existing_context_node_judged_long_term_leaves_context_layer(engine):
+    ctx = engine.add_context("服务器 root 密码轮换周期改为 30 天")
+    r = engine.longterm_snapshot("服务器 root 密码轮换周期改为 30 天", importance_hint=0.9)
+    assert r["node_id"] == ctx.id
+    node = engine.store.get_node(ctx.id)
+    assert node.layer == MemoryLayer.KNOWLEDGE
+    assert r["stored_layer"] == MemoryLayer.KNOWLEDGE.value
+    # 不再受情境层 FIFO 上限淘汰
+    engine.set_context_cap(2)
+    for i in range(3):
+        engine.add_context(f"闲聊 {i}")
+    assert engine.store.get_node(ctx.id) is not None
+
+
+def test_existing_knowledge_node_not_demoted_by_low_hint(engine):
+    k = engine.add_perception("实验室门禁卡统一在周五下午更换", importance=0.6)
+    r = engine.longterm_snapshot("实验室门禁卡统一在周五下午更换", importance_hint=0.1)
+    assert r["node_id"] == k.id
+    assert engine.store.get_node(k.id).layer == MemoryLayer.KNOWLEDGE
+    assert r["stored_layer"] == MemoryLayer.KNOWLEDGE.value
