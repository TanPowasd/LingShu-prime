+# -*- coding: utf-8 -*-
+"""回归（issue #231）：形状部件绘制后整体底部贴地（地面类 10/10），get_shape 返回快照不改全局库。"""
+import pytest
+
+pytest.importorskip("PIL")
+import lingshu.world.shapes as shapes
+from lingshu.world.vprim import VPrim
+from lingshu.world.world3d import World3D, Camera3D, DEFAULT_VISUAL_SPECS
+
+
+def _drawn_bottom(cat):
+    w = World3D(Camera3D())
+    obj = w.add_vprim(VPrim(category=cat, bbox=(200, 250, 400, 380)), 600, 400)
+    seen = []
+    orig = w._draw_part
+
+    def rec(draw, o, part, cam, sw, sh):
+        seen.append(o.center[1] + part["pos"][1] - part["size"][1] / 2)
+        return orig(draw, o, part, cam, sw, sh)
+
+    w._draw_part = rec
+    w.render(600, 400)
+    return obj, min(seen) if seen else None
+
+
+@pytest.mark.parametrize("cat", sorted(c for c in shapes.SHAPE_LIBRARY
+                                       if DEFAULT_VISUAL_SPECS.get(c) is None or DEFAULT_VISUAL_SPECS[c].ground))
+@pytest.mark.xfail(reason='#231 接地约定 needs-owner-decision：与 test_world3d_part_order 像素采样契约冲突，未改渲染', strict=True)
+def test_ground_shapes_touch_ground(cat):
+    obj, bottom = _drawn_bottom(cat)
+    if bottom is None:
+        pytest.skip("相机视野外未绘制")
+    assert abs(bottom - (obj.center[1] - obj.size[1] / 2)) < 1e-6, (cat, bottom)
+
+
+def test_get_shape_is_snapshot():
+    before = len(shapes.get_shape("chair"))
+    shapes.get_shape("chair").append({"kind": "box", "pos": (0, 0, 0), "size": (1, 1, 1), "color": (0, 0, 0)})
+    shapes.get_shape("chair")[0]["pos"] = (99, 99, 99)
+    assert len(shapes.get_shape("chair")) == before
+    assert shapes.get_shape("chair")[0]["pos"] != (99, 99, 99)
