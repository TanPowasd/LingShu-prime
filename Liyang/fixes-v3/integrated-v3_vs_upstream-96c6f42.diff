@@ -0,0 +1,37 @@
+"""PR #202（issue #81）复现：LayeredStore 全实例共用一条 sqlite3 连接，进程内多线程并发即异常。
+用法：cd <worktree> && PYTHONPATH=. python bench/probes/pr202.py"""
+import collections, os, tempfile, threading
+from lingshu.core.core import SpacetimeMemoryEngine
+
+TAG, SEED, PER = "并发回归填充", 40, 80
+e = SpacetimeMemoryEngine(os.path.join(tempfile.mkdtemp(), "conc.db"))
+for i in range(SEED):
+    e.add_perception(f"{TAG} {i}", skip_dedup=True)
+errs, stop = collections.Counter(), threading.Event()
+
+
+def writer(tid):
+    for i in range(SEED + tid * PER, SEED + tid * PER + PER):
+        try:
+            e.add_perception(f"{TAG} {i}", skip_dedup=True)
+        except Exception as ex:
+            errs[type(ex).__name__] += 1
+
+
+def reader():
+    while not stop.is_set():
+        try:
+            e.search_content(TAG)
+        except Exception as ex:
+            errs[type(ex).__name__] += 1
+
+
+ws = [threading.Thread(target=writer, args=(i,)) for i in range(4)]
+rs = [threading.Thread(target=reader) for _ in range(4)]
+for t in ws + rs: t.start()
+for t in ws: t.join()
+stop.set()
+for t in rs: t.join()
+tot = sum(errs.values())
+print(f"4 写 + 4 读（文件库）异常 {tot} 次 {dict(errs)}")
+print("BUG" if tot else "OK")
