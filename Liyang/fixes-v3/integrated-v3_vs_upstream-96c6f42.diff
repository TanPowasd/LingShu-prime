+# -*- coding: utf-8 -*-
+"""回归（issue #240）：coggraph 本地查看器 serve.py 校验 Host 头（防 DNS rebinding）。"""
+import http.client
+import importlib.util
+import json
+import os
+import shutil
+import threading
+
+TMPL = os.path.join(os.path.dirname(__file__), "..", "tools", "coggraph", "viewer_serve.tmpl")
+
+
+def _serve(tmp_path):
+    (tmp_path / "viewer_graph.json").write_text(json.dumps(
+        {"nodes": [{"id": "n2", "layer": "knowledge", "title": "t", "path": ""}]}), encoding="utf-8")
+    shutil.copy(TMPL, tmp_path / "serve.py")
+    spec = importlib.util.spec_from_file_location("coggraph_serve_under_test", tmp_path / "serve.py")
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    srv = mod.S(("127.0.0.1", 0), mod.H)
+    threading.Thread(target=srv.serve_forever, daemon=True).start()
+    return srv
+
+
+def _get(port, path, host, method="GET"):
+    c = http.client.HTTPConnection("127.0.0.1", port, timeout=5)
+    c.putrequest(method, path, skip_host=True)
+    c.putheader("Host", host)
+    c.endheaders()
+    r = c.getresponse()
+    body = r.read()
+    c.close()
+    return r.status, body
+
+
+def test_forged_host_rejected_and_loopback_allowed(tmp_path):
+    srv = _serve(tmp_path)
+    port = srv.server_address[1]
+    try:
+        evil = "rebind.attacker.example:%d" % port
+        assert _get(port, "/api/node?id=n2", evil)[0] == 403
+        assert _get(port, "/viewer_graph.json", evil)[0] == 403
+        assert _get(port, "/viewer_graph.json", evil, "HEAD")[0] == 403
+        for ok in ("127.0.0.1:%d" % port, "localhost:%d" % port):
+            st, body = _get(port, "/api/node?id=n2", ok)
+            assert st == 200 and json.loads(body)["id"] == "n2"
+            assert _get(port, "/viewer_graph.json", ok)[0] == 200
+    finally:
+        srv.shutdown()
+        srv.server_close()
