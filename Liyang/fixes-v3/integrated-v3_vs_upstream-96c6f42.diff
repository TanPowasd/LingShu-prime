+# -*- coding: utf-8 -*-
+"""回归（issue #243）：五个 world 门面的 init 动作按参数（重新）构造对象并返回 status=ok。"""
+import pytest
+from lingshu.core.core import SpacetimeMemoryEngine
+
+FACADES = [("spacetime_consistency", "_stc"), ("world_model", "_wmodel"), ("world_learner", "_wlearner"),
+           ("curiosity_explorer", "_curious"), ("seven_layer_loop", "_sll")]
+
+
+def _size(obj):
+    for path in (("size",), ("world", "size"), ("scene", "world", "size"), ("world", "world", "size"),
+                 ("explorer", "world", "size"), ("explorer", "size")):
+        o = obj
+        try:
+            for a in path:
+                o = getattr(o, a)
+            if isinstance(o, int):
+                return o
+        except AttributeError:
+            continue
+    return None
+
+
+@pytest.mark.parametrize("name,attr", FACADES)
+def test_init_after_state_rebuilds(name, attr):
+    e = SpacetimeMemoryEngine(":memory:")
+    getattr(e, name)("report" if name == "spacetime_consistency" else "state")
+    assert _size(getattr(e, attr)) == 24
+    r = getattr(e, name)("init", {"size": 40, "seed": 7})
+    assert r["status"] == "ok", r
+    assert _size(getattr(e, attr)) == 40
+
+
+@pytest.mark.parametrize("name,attr", FACADES)
+def test_init_first_call_ok(name, attr):
+    e = SpacetimeMemoryEngine(":memory:")
+    r = getattr(e, name)("init", {"size": 32})
+    assert r["status"] == "ok", r
+    assert _size(getattr(e, attr)) == 32
