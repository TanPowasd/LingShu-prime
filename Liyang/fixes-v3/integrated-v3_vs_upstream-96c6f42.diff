@@ -0,0 +1,23 @@
+"""issue #196 ①：core/verdict.assess 入口不校验数值有限性——part_fg_px=NaN/inf 时阈值链比较恒假，
+落到末尾 ACCEPT。非有限的 part_fg_px / part_area 必须显式拒收（ValueError），不得产生任何判定。"""
+import pytest
+
+from lingshu.core.verdict import assess
+
+NAN, INF = float("nan"), float("inf")
+D = {"clothing": "常服", "occlusion": "无遮挡", "contrast": "清晰"}
+
+
+@pytest.mark.parametrize("fg,area", [(NAN, 10000), (INF, 10000), (-INF, 10000),
+                                     (100, NAN), (100, INF), (100, -INF)])
+def test_nonfinite_counts_rejected(fg, area):
+    with pytest.raises(ValueError):
+        assess({"type": "head"}, D, part_fg_px=fg, part_area=area)
+
+
+def test_zero_area_still_reject_and_controls_unchanged():
+    assert assess({"type": "head"}, D, part_fg_px=1, part_area=0)["verdict"] == "REJECT"
+    assert assess({"type": "head"}, D, part_fg_px=9000, part_area=10000)["verdict"] == "ACCEPT"
+    assert assess({"type": "torso"}, D, part_fg_px=9000, part_area=10000)["verdict"] == "DEFER"
+    assert assess({"type": "head"}, D, part_fg_px=500, part_area=10000)["verdict"] == "REJECT"
+    assert assess({"type": "head"}, D, part_fg_px=2000, part_area=10000)["verdict"] == "BLINDSPOT"
diff --git a/tests/test_issue197_hexnet_vec_atomic.py b/tests/test_issue197_hexnet_vec_atomic.py
new file mode 100644
index 0000000..3c53c66
--- /dev/null
+++ b/tests/test_issue197_hexnet_vec_atomic.py
@@ -0,0 +1,58 @@
+"""issue #197：HexNet.get_vec/set_vec 是两次独立调用，并发「读-改-写」丢更新；需提供原子更新接口，
+且 get_vec/set_vec 各自不应读到半写状态。hex_hier.HexHierNet / hex_unit.UnitHeadNet 同形态一并处理。"""
+import copy
+import threading
+
+import numpy as np
+import pytest
+
+from lingshu.nn.hex_train import HexNet
+from lingshu.nn.hex_hier import HexHierNet
+from lingshu.nn.hex_unit import UnitHeadNet
+
+
+def _nets():
+    hier = HexHierNet()
+    return {"HexNet": HexNet(seed=7), "HexHierNet": hier, "UnitHeadNet": UnitHeadNet(HexHierNet())}
+
+
+@pytest.mark.parametrize("name", ["HexNet", "HexHierNet", "UnitHeadNet"])
+def test_concurrent_update_vec_loses_nothing(name):
+    net = _nets()[name]
+    v0 = net.get_vec().copy()
+    n_threads, n_iter = 8, 50
+    barrier = threading.Barrier(n_threads)
+    delta = np.zeros_like(v0); delta[-1] = 0.001   # 最后一维（UnitHeadNet 的 theta 无裁剪）
+
+    def worker():
+        barrier.wait(timeout=10)
+        for _ in range(n_iter):
+            net.apply_delta(delta)
+
+    ts = [threading.Thread(target=worker) for _ in range(n_threads)]
+    [t.start() for t in ts]; [t.join() for t in ts]
+    got = float(net.get_vec()[-1] - v0[-1])
+    assert abs(got - n_threads * n_iter * 0.001) < 1e-9, got
+
+
+def test_update_vec_fn_is_read_modify_write():
+    net = HexNet(seed=7)
+    v0 = net.get_vec().copy()
+    barrier = threading.Barrier(2)
+
+    def worker():
+        barrier.wait(timeout=10)
+        net.update_vec(lambda v: v + np.eye(1, v.size, 0).ravel())
+
+    ts = [threading.Thread(target=worker) for _ in range(2)]
+    [t.start() for t in ts]; [t.join() for t in ts]
+    assert abs(float(net.get_vec()[0] - v0[0]) - 2.0) < 1e-12
+
+
+def test_still_copyable_and_set_get_roundtrip():
+    net = HexNet(seed=7)
+    c = copy.deepcopy(net)
+    assert np.array_equal(c.get_vec(), net.get_vec())
+    v = net.get_vec() * 0.5
+    c.set_vec(v)
+    assert np.array_equal(c.get_vec(), v)
