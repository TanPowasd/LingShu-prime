+"""issue #245 探针：coggraph 查看器把层名/边类型原样拼进 innerHTML（存储型 XSS）。需要 node。"""
+import importlib.util, json, os, re, shutil, subprocess, tempfile
+spec = importlib.util.spec_from_file_location("bv", os.path.join("tools", "coggraph", "build_viewer.py"))
+m = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
+html = m.HTML.replace("%%LAYER_COLOR%%", json.dumps(m.LAYER_COLOR)).replace("%%RULE_COLOR%%", json.dumps(m.RULE_COLOR))
+if not shutil.which("node"):
+    print("ERR 无 node"); raise SystemExit(0)
+G = {"layer_count": {'<img src=x onerror=alert(1)>': 1}, "edge_type_count": {'"><svg onload=alert(1)>': 1}}
+js = ("const els={};const document={getElementById:id=>(els[id]=els[id]||{innerHTML:'',style:{}}),querySelectorAll:()=>[]};"
+      "const window={addEventListener(){}};async function fetch(){return {json:async()=>(%s)};}" % json.dumps(G)
+      + re.findall(r"<script>(.*?)</script>", html, re.S)[-1]
+      + "\nfunction build(){}\nfunction bind(){}\nload().then(()=>console.log(els.layers.innerHTML+els.etypes.innerHTML));")
+f = tempfile.NamedTemporaryFile("w", suffix=".js", delete=False, encoding="utf-8"); f.write(js); f.close()
