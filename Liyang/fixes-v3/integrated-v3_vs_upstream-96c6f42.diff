+# nn-08（仅 verify_consistency 部分；recall 白名单问题已是 #162）
+# SpatiotemporalMemory.verify_consistency 原为 len(recall()) == len(events)，恒真
+# 运行：在仓库根目录 PYTHONPATH=. python _out/repro/nn-08.py
+from lingshu.nn.stcnn import (SpatiotemporalMemory, extract_spatiotemporal_primitives,
+                              synth_ball_rolling, synth_static, synth_blinking)
+
+
+def fresh():
+    mem = SpatiotemporalMemory()
+    for frames, label in ((synth_ball_rolling(10, speed_px=2), "球"),
+                          (synth_blinking(12, period=3), "灯"),
+                          (synth_static(6), "背景")):
+        prims, _ = extract_spatiotemporal_primitives(frames)
+        mem.remember(prims, label)
+    return mem
+
+
+res = {}
+m = fresh(); res["正常"] = m.verify_consistency()
+m = fresh(); m.events.append({"label": "幻觉", "direction": None}); res["注入伪事件"] = m.verify_consistency()
+m = fresh(); m.events[0]["direction"] = "向左"; res["事后改写"] = m.verify_consistency()
+m = fresh(); m.events.pop(); res["丢失一条"] = m.verify_consistency()
+for k, v in res.items():
+    print(f"{k:<6} verify_consistency() = {v}")
+bad = res["正常"] is not True or any(res[k] for k in ("注入伪事件", "事后改写", "丢失一条"))
+print("BUG" if bad else "OK")
