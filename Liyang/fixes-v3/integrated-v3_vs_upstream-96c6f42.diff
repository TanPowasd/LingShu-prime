+"""world-n1：World3D._draw_box 按固定顺序画全部 6 面、不做背面剔除——被遮的底面/背面盖住可见面。打印 BUG/OK。"""
+from lingshu.world.world3d import World3D, Object3D, Camera3D
+
+W, H = 400, 300
+C = (200, 100, 50)
+SH = {"front": 0.95, "bottom": 0.6, "top": 1.15, "side": 0.85}
+col = lambda s: tuple(min(255, int(v * SH[s])) for v in C)
+
+def front_face_stats(center, size, cam=None):
+    """前面（z-）投影区域内部像素中，显示为「前面色」的比例 + 出现最多的其它颜色。"""
+    w = World3D(camera=cam) if cam else World3D()
+    w.objects = [Object3D("crate", center=center, size=size, color=C)]
+    img = w.render(W, H, background=(0, 0, 0), ground_color=(0, 0, 0))
+    x, y, z = center; hw, hh, hd = (s / 2 for s in size)
+    ok = tot = 0; other = {}
+    for i in range(1, 20):
+        for j in range(1, 20):
+            p = w.camera.project((x - hw + 2 * hw * i / 20, y - hh + 2 * hh * j / 20, z - hd), W, H)
+            if p is None or not (0 <= p[0] < W and 0 <= p[1] < H):
+                continue
+            px = img.getpixel((int(p[0]), int(p[1]))); tot += 1
+            if px == col("front"): ok += 1
+            else: other[px] = other.get(px, 0) + 1
+    top = max(other, key=other.get) if other else None
+    return round(ok / tot, 3), top
+
+r1 = front_face_stats((0, 0.5, 2.5), (1, 1, 1))          # 相机高 1.2m，俯视近处立方体
+r2 = front_face_stats((0, 2.0, 3.0), (1, 1, 1))          # 立方体高于相机，仰视
+name = {col(k): k for k in SH}
+print("① 俯视近处立方体：前面区域正确着色比例 =", r1[0], "| 盖在前面上最多的颜色:", r1[1], name.get(r1[1], ""))
+print("② 仰视高处立方体：前面区域正确着色比例 =", r2[0], "| 盖在前面上最多的颜色:", r2[1], name.get(r2[1], ""))
+print("BUG" if min(r1[0], r2[0]) < 0.95 else "OK")
