@@ -0,0 +1,36 @@
+# -*- coding: utf-8 -*-
+"""issue #180：cred_step(x, cred_factor(γ, dt)) 必须是连续核的离散等价物，不得单步归零。"""
+import math
+
+import pytest
+
+from lingshu.core.time_core import Retention, cred, cred_factor, cred_step
+from lingshu.world import time_core as wtc
+
+
+def test_retention_factor_is_smooth():
+    x1 = cred_step(100.0, cred_factor(0.1, 1.0))
+    assert x1 == pytest.approx(100 * math.exp(-0.1))
+    assert x1 == pytest.approx(cred(100.0, 0.0, 0.1, 1.0))
+    assert x1 > 80.0
+
+
+def test_n_steps_match_continuous_kernel():
+    x = 1.0
+    for _ in range(10):
+        x = cred_step(x, cred_factor(0.05, 2.0))
+    assert x == pytest.approx(math.exp(-0.05 * 20))
+
+
+def test_plain_float_keeps_forget_fraction_semantics():
+    # decay_cycle 的逐周期遗忘比例语义不变
+    assert cred_step(100.0, 0.02) == pytest.approx(98.0)
+    assert cred_step(1.0, 0.0) == 1.0
+
+
+def test_cred_factor_still_behaves_as_float():
+    f = cred_factor(0.1, 1.0)
+    assert isinstance(f, float) and isinstance(f, Retention)
+    assert float(f) == pytest.approx(math.exp(-0.1))
+    assert cred_factor(10.0, 10.0, floor=0.2) == pytest.approx(0.2)
+    assert wtc.cred_step is cred_step and wtc.cred_factor is cred_factor
