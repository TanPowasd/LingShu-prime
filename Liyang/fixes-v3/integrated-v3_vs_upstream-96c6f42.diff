+
+def test_facade_smoke_through_engine():
+    eng = SpacetimeMemoryEngine()
+    try:
+        r = eng.voxel_world("build", {"size": 12, "trees": 1})
+        assert r["status"] == "ok" and r["blocks"] > 0
