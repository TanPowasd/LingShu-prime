+# -*- coding: utf-8 -*-
+"""回归：session_chains 不把无会话 id 的节点串成伪「unknown」会话链（新发现 core2-new-04）。"""
+import importlib.util
+import json
+import os
+
+_TOOL = os.path.join(os.path.dirname(__file__), "..", "tools", "coggraph", "session_chains.py")
+
+
+def _run(tmp_path, audit_rows, n_nodes):
+    spec = importlib.util.spec_from_file_location("session_chains_under_test", _TOOL)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    g = {"nodes": [{"id": "n%d" % i, "title": "t%d" % i} for i in range(n_nodes)], "edges": []}
+    (tmp_path / "g.json").write_text(json.dumps(g), encoding="utf-8")
+    (tmp_path / "a.jsonl").write_text("\n".join(json.dumps(r) for r in audit_rows) + "\n", encoding="utf-8")
+    assert mod.main(["--audit", str(tmp_path / "a.jsonl"), "--graph", str(tmp_path / "g.json"),
+                     "--out", str(tmp_path), "--write"]) == 0
+    return json.loads((tmp_path / "session_chains.json").read_text(encoding="utf-8"))
+
+
+def test_nodes_without_session_are_not_chained(tmp_path):
+    rows = [{"op": "add", "id": "n%d" % i, "t": 1000 + i, "session": "s1"} for i in range(3)]
+    rows += [{"op": "add", "id": "n%d" % i, "t": 5000 + i * 100000} for i in range(3, 6)]
+    rows += [{"op": "add", "id": "n6", "t": 9000, "session": ""}]
+    out = _run(tmp_path, rows, 7)
+    assert [h["id"] for h in out["hubs"]] == ["session:s1"]
+    seq = sorted((e["s"], e["t"]) for e in out["edges"] if e["type"] == "sequential")
+    assert seq == [("n0", "n1"), ("n1", "n2")]
+    assert out["meta"]["no_session_nodes"] == 4
diff --git a/tests/test_core_auto_decay_restart.py b/tests/test_core_auto_decay_restart.py
new file mode 100644
index 0000000..5174ce0
--- /dev/null
+++ b/tests/test_core_auto_decay_restart.py
@@ -0,0 +1,40 @@
+"""回归：stop_auto_decay → start_auto_decay（一个 interval 内）不叠加衰减线程
+（issue 草稿 core-py-06）。"""
+import threading
+import time
+
+from lingshu.core.core import SpacetimeMemoryEngine
+
+
+def _restart_cycles(e, interval, n):
+    e.start_auto_decay(interval=interval)
+    for _ in range(n):
+        time.sleep(0.05)
+        e.stop_auto_decay()
+        e.start_auto_decay(interval=interval)
+
+
+def test_restart_does_not_stack_decay_threads():
+    e = SpacetimeMemoryEngine()
+    before = set(threading.enumerate())
+    _restart_cycles(e, interval=0.5, n=3)
+    time.sleep(0.2)  # 给旧线程留出退出时间（远小于 interval）
+    extra = [t for t in threading.enumerate() if t not in before and t.is_alive()]
+    try:
+        assert len(extra) == 1  # 修复前 4 条线程同时存活
+    finally:
+        e.stop_auto_decay()
+
+
+def test_restart_keeps_decay_rate():
+    e = SpacetimeMemoryEngine()
+    calls = []
+    orig = e.decay_cycle
+    e.decay_cycle = lambda *a, **k: (calls.append(1), orig(*a, **k))
+    _restart_cycles(e, interval=0.3, n=3)
+    t0 = len(calls)
+    time.sleep(1.5)
+    e.stop_auto_decay()
+    n = len(calls) - t0
+    # 单线程 1.5s / 0.3s ≈ 5 次；修复前 4 线程叠加 ≈ 20 次
+    assert n <= 7, n
