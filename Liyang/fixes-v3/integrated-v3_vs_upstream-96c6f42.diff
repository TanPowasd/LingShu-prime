+# -*- coding: utf-8 -*-
+"""issue #199 回归：ActivationEngine 空查询不得把全图当种子并给满分。
+
+改前：query="" ⇒ toks={""}，'"" in hay' 恒真 ⇒ 每个节点 s=1.0 全部入选；
+      而 "   "（空白）返回 0 个种子，二者行为相反。
+改后：空/纯空白查询显式短路为 0 个种子；正常查询不变。
+运行：python -X utf8 -m pytest tests/test_issue199_activation_empty_query.py -q
+"""
+import os
+import sys
+import tempfile
+
+import pytest
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from lingshu.core.core import SpacetimeMemoryEngine  # noqa: E402
+
+activation = pytest.importorskip("lingshu.core.activation")
+
+
+@pytest.fixture()
+def ae():
+    tmp = tempfile.mkdtemp()
+    db = os.path.join(tmp, "g.db")
+    eng = SpacetimeMemoryEngine(db)
+    for c in ["节点甲 内容一", "节点乙 内容二", "节点丙 内容三", "节点丁 内容四"]:
+        eng.add_perception(c, skip_dedup=True)
+    yield activation.ActivationEngine(db_path=db, audit_path=os.path.join(tmp, "a.jsonl"))
+    eng.close()
+
+
+@pytest.mark.parametrize("q", ["", "   ", "\t\n"])
+def test_empty_or_blank_query_yields_no_seeds(ae, q):
+    assert ae._seed_by_text(q) == []
+    r = ae.activate(q, workset="w")
+    assert r["seeds"] == 0 and r["size"] == 0
+
+
+def test_normal_query_still_seeds(ae):
+    seeds = ae._seed_by_text("节点甲")
+    assert seeds and seeds[0][1] == 1.0
