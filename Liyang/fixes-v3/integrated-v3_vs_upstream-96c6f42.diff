+# -*- coding: utf-8 -*-
+"""issue #280：自条件回注不得跨轮指数发散/溢出 inf，也不得永久锁死工作态。"""
+import math, os, tempfile, warnings
+warnings.filterwarnings("ignore")
+import pytest
+pytest.importorskip("numpy")
+from lingshu.core.core import SpacetimeMemoryEngine, EdgeType
+from lingshu.core.activation import ActivationEngine, SELF_CONDITION_WEIGHT
+
+
+def _setup():
+    d = tempfile.mkdtemp(); db = os.path.join(d, "b.db")
+    e = SpacetimeMemoryEngine(db)
+    ids = [e.add_perception(f"项目{i}进度汇报", skip_dedup=True).id for i in range(6)]
+    for a in ids:
+        for b in ids:
+            if a != b:
+                e.add_edge(a, b, EdgeType.SIMILAR)
+    w = e.add_perception("明天台风天气预报", skip_dedup=True).id
+    e.close()
+    return ActivationEngine(db_path=db, audit_path=os.path.join(d, "a.jsonl")), ids, w
+
+
+def test_activation_bounded_and_finite_over_many_rounds():
+    act, ids, w = _setup()
+    for _ in range(60):
+        r = act.activate("项目进度", workset="s", self_condition=SELF_CONDITION_WEIGHT)
+        for _, a in r["top"]:
+            assert math.isfinite(a) and a <= 1.0 + 1e-6
+
+
+def test_topic_switch_not_locked_by_old_workset():
+    act, ids, w = _setup()
+    for _ in range(60):
+        act.activate("项目进度", workset="s", self_condition=SELF_CONDITION_WEIGHT)
+    r = act.activate("台风天气预报", workset="s", self_condition=SELF_CONDITION_WEIGHT)
+    top = dict(r["top"])
+    assert math.isfinite(max(top.values()))
+    assert top.get(w, 0.0) >= max(top.values()) - 1e-6   # 新话题节点不得被旧节点压制
