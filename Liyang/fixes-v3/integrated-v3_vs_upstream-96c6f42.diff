+# -*- coding: utf-8 -*-
+"""回归（issue #245）：build_viewer 生成的查看器不得把层名/边类型原样拼进 innerHTML（存储型 XSS）。
+用 node + stub DOM 执行生成页面里的 load()，检查写进 innerHTML 的字符串。"""
+import importlib.util
+import json
+import os
+import re
+import shutil
+import subprocess
+
+import pytest
+
+_TOOL = os.path.join(os.path.dirname(__file__), "..", "tools", "coggraph", "build_viewer.py")
+LAYER = '<img src=x onerror="fetch(`/api/node?id=n2`)">'
+ETYPE = '"><svg onload=alert(document.domain)>'
+
+
+def _html():
+    spec = importlib.util.spec_from_file_location("build_viewer_under_test", _TOOL)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return (mod.HTML.replace("%%LAYER_COLOR%%", json.dumps(mod.LAYER_COLOR))
+                    .replace("%%RULE_COLOR%%", json.dumps(mod.RULE_COLOR)))
+
+
+@pytest.mark.skipif(shutil.which("node") is None, reason="需要 node 执行生成页面脚本")
+def test_layer_and_edge_type_escaped_in_innerhtml(tmp_path):
+    scripts = re.findall(r"<script>(.*?)</script>", _html(), re.S)
+    assert scripts, "未找到内联脚本"
+    G = {"layer_count": {LAYER: 1, "knowledge": 2}, "edge_type_count": {ETYPE: 1, "causal": 3}}
+    stub = """
+const els = {};
+const document = { getElementById: id => (els[id] = els[id] || {innerHTML: '', value: '', style: {}}),
+                   querySelectorAll: () => [] };
+const window = { addEventListener(){} };
+async function fetch(){ return { json: async () => (%s) }; }
+""" % json.dumps(G)
+    js = stub + scripts[-1] + "\nfunction build(){}\nfunction bind(){}\n" \
+        "load().then(()=>{console.log(JSON.stringify({l: els.layers.innerHTML, e: els.etypes.innerHTML}));});\n"
+    f = tmp_path / "v.js"
+    f.write_text(js, encoding="utf-8")
+    out = subprocess.run(["node", str(f)], capture_output=True, text=True, timeout=30)
+    assert out.returncode == 0, out.stderr
+    got = json.loads(out.stdout.strip().splitlines()[-1])
+    for html in (got["l"], got["e"]):
+        assert "<img" not in html and "<svg" not in html
+        # 属性值内不得出现未转义的引号（否则可提前闭合属性）
+        for attr in re.findall(r'(?:title|value)="([^"]*)"', html):
+            assert "<" not in attr and ">" not in attr
+    assert "&lt;img" in got["l"] and "&quot;&gt;&lt;svg" in got["e"]
+    assert 'value="knowledge"' in got["l"] and 'value="causal"' in got["e"]
