@@ -0,0 +1,63 @@
+# -*- coding: utf-8 -*-
+"""issue #195（= #44）：长期层/前馈关联边必须真的建成，links 报实际建边数；relation_type 字符串不再静默失败。"""
+import warnings
+
+import pytest
+
+from lingshu.core.core import EdgeType, SpacetimeMemoryEngine
+from lingshu.core.longterm_gate import LongTermMemoryGate
+
+warnings.filterwarnings("ignore")
+
+
+def _edges(e):
+    return e.store.conn.execute("SELECT COUNT(*) FROM edges").fetchone()[0]
+
+
+def test_add_edge_accepts_value_string_and_rejects_unknown():
+    e = SpacetimeMemoryEngine(":memory:")
+    try:
+        a = e.add_perception("甲：灵枢 认知图 条件空间", skip_dedup=True)
+        b = e.add_perception("乙：灵枢 认知图 条件空间 演化", skip_dedup=True)
+        ed = e.add_edge(a.id, b.id, relation_type="similar")
+        assert ed.relation_type is EdgeType.SIMILAR and _edges(e) == 1
+        with pytest.raises(ValueError):
+            e.add_edge(a.id, b.id, relation_type="no-such-type")
+        assert _edges(e) == 1
+    finally:
+        e.close()
+
+
+def test_write_snapshot_long_term_builds_links():
+    e = SpacetimeMemoryEngine(":memory:")
+    try:
+        e.add_perception("长期记忆写入决策器：信息差 信任 二阶变化 提及次数 重要性评估", tags=["seed"])
+        gate = LongTermMemoryGate(e)
+        before = _edges(e)
+        r = gate.write_snapshot("长期记忆写入决策器：信息差 信任 二阶变化 提及次数 重要性评估 关联边",
+                                source="probe", importance_hint=1.0)
+        if r.get("layer") != "long_term":
+            pytest.skip(f"本配置未判入长期层：{r.get('layer')}")
+        assert r["links"] >= 1
+        assert _edges(e) - before == r["links"]
+        nid = r.get("node_id")
+        if nid:
+            rels = {x.relation_type for x in e.store.get_outgoing_edges(nid)}
+            assert EdgeType.SIMILAR in rels
+    finally:
+        e.close()
+
+
+def test_links_count_matches_threshold():
+    e = SpacetimeMemoryEngine(":memory:")
+    try:
+        e.add_perception("实验室服务器的备份策略改为每日增量", skip_dedup=True)
+        e.add_perception("实验室服务器的备份策略需要监控", skip_dedup=True)
+        e.add_perception("今天午饭吃了面条", skip_dedup=True)
+        gate = LongTermMemoryGate(e)
+        before = _edges(e)
+        r = gate.write_snapshot("实验室服务器的备份策略改为每日增量每周全量", source="probe", importance_hint=0.9)
+        if r.get("layer") == "long_term":
+            assert r["links"] == _edges(e) - before
+    finally:
+        e.close()
diff --git a/tests/test_issue196_nan_threshold_gates.py b/tests/test_issue196_nan_threshold_gates.py
