+print("渐变蓝底，左上有红色圆 ->", len(r["parts"]), "个部件", [(p["shape"], p["color"], p["zone"]) for p in r["parts"]])
+bad |= len(r["parts"]) != 1
+print("BUG" if bad else "OK")
