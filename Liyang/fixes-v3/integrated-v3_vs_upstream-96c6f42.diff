+# -*- coding: utf-8 -*-
+"""回归（issue #272）：recall_skill 不再先无序截前 100 行——同名高置信卡排第一；语序/空格/「的」变化可召回；步骤字段参与检索。"""
+from lingshu.core.core import SpacetimeMemoryEngine
+
+
+def test_exact_name_beyond_100_cards_ranks_first():
+    e = SpacetimeMemoryEngine(":memory:")
+    for i in range(150):
+        e.store_skill(f"项目{i:03d}日志备份", f"把项目{i:03d}的日志打包备份", "tar > scp", confidence=0.5)
+    good = e.store_skill("备份", "数据库全量备份（已验证）", "pg_dump > gzip > 校验", confidence=0.9)
+    r = e.recall_skill("备份", limit=1)
+    assert r and r[0]["id"] == good
+
+
+def test_fuzzy_and_procedure_queries():
+    f = SpacetimeMemoryEngine(":memory:")
