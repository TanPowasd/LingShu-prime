+球  ×0.05   {'direction': '静止', 'speed': 0.0, 'period': None, 'moving': True, 'trajectory_len': 0}
+球  ×255.0  {'direction': '向右', 'speed': 2.0, 'period': None, 'moving': True, 'trajectory_len': 9}
