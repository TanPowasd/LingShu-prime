+# -*- coding: utf-8 -*-
+"""回归（issue #213）：LongTermMemoryGate 新奇检测不再对非汉字内容失明；
+中文事实只改数字/标识符时判为变更（高新奇），而不是「完全已知」。"""
+import os
+import tempfile
+import warnings
+
+import pytest
+
+warnings.filterwarnings("ignore")
+from lingshu.core.core import SpacetimeMemoryEngine  # noqa: E402
+
+
+def _eng():
+    return SpacetimeMemoryEngine(os.path.join(tempfile.mkdtemp(), "h.db"))
+
+
+NON_CJK = ["The production database password was rotated today",
+           "rm -rf /var/lib/postgresql/data",
+           "CVE-2026-31337 remote code execution in libfoo 2.4.1",
+           "3.14159265358979",
+           "서울은 한국의 수도이다", "Москва столица России", "ひらがなだけのぶんしょう"]
+
+
+@pytest.mark.parametrize("s", NON_CJK)
+def test_first_seen_non_cjk_is_novel(s):
+    e = _eng()
+    e.add_perception("水在标准大气压下一百度沸腾。")
+    g = e._ensure_gate()
+    assert g._novelty(s) >= 0.75
+    r = e.prefeed_input(s)
+    assert r["action"] == "prefeed_boost"
+
+
+@pytest.mark.parametrize("s", NON_CJK)
+def test_repeated_non_cjk_is_known(s):
+    e = _eng()
+    e.add_perception(s, skip_dedup=True)
+    assert e._ensure_gate()._novelty(s) <= 0.25
+
+
+@pytest.mark.parametrize("old,new", [
+    ("收款账户改为 6222020200112233", "收款账户改为 6222029999999999"),
+    ("数据库地址 db-prod-01.internal", "数据库地址 db-prod-02.evil.com"),
+    ("服务器IP改为10.0.0.4", "服务器IP改为10.0.0.5"),
+    ("每日剂量上限 10 毫克", "每日剂量上限 100 毫克"),
+])
+def test_identifier_only_change_is_novel(old, new):
+    e = _eng()
+    e.add_perception(old, skip_dedup=True)
+    g = e._ensure_gate()
+    assert g._novelty(new) >= 0.75
+    assert g._novelty(old) <= 0.25          # 逐字重复仍判已知
+    assert e.prefeed_input(new)["action"] == "prefeed_boost"
+
+
+def test_chinese_one_char_change_still_detected():
+    e = _eng()
+    e.add_perception("管理员账号已停用", skip_dedup=True)
+    assert e._ensure_gate()._novelty("管理员账号已启用") > 0.25
+
+
+def test_blind_input_reports_basis_none():
+    e = _eng()
+    e.add_perception("水在标准大气压下一百度沸腾。")
+    r = e.prefeed_input("！？……")
+    assert r["action"] == "routine" and r["novelty_basis"] == "none"
diff --git a/tests/test_issue214_context_consolidation.py b/tests/test_issue214_context_consolidation.py
