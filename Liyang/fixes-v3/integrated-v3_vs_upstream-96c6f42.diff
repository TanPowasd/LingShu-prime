+# -*- coding: utf-8 -*-
+"""回归：verify_constructive 必须看渲染像素，渲染器失效时不得报兑现（issue 草稿 nn-04）。"""
+import pytest
+
+import lingshu.nn.hex_gen as hg
+
+PARTS = [{"shape": "circle", "color": "red", "zone": "r0", "pattern": "solid", "size": "medium"},
+         {"shape": "triangle", "color": "green", "zone": "r8", "pattern": "solid", "size": "medium"},
+         {"shape": "diamond", "color": "blue", "zone": "r4", "pattern": "striped", "size": "large"}]
+
+
+def _rate(parts, **kw):
+    img, log = hg.render_relations(parts, size=96, seed=3, noise=False, **kw)
+    return hg.verify_constructive(parts, log)["rate"]
+
+
+def test_normal_render_is_fulfilled():
+    assert _rate(PARTS) == 1.0
+
+
+def test_noop_renderer_is_not_fulfilled(monkeypatch):
+    monkeypatch.setattr(hg, "_paint", lambda *a, **k: None)
+    monkeypatch.setattr(hg, "_paint_polygon", lambda *a, **k: None)
+    assert _rate(PARTS) == 0.0
+
+
+def test_misplaced_renderer_is_not_fulfilled(monkeypatch):
+    orig = hg._paint
+    # 渲染器把部件画到水平镜像位置：r0 的圆落到 r2
+    monkeypatch.setattr(hg, "_paint", lambda img, shape, cx, cy, *a: orig(img, shape, img.shape[1] - 1 - cx, cy, *a))
+    parts = [PARTS[0]]
+    assert _rate(parts) == 0.0
+
+
+def test_wrong_color_renderer_is_not_fulfilled(monkeypatch):
+    orig = hg._paint
+    monkeypatch.setattr(hg, "_paint", lambda img, shape, cx, cy, rad, col, pat: orig(img, shape, cx, cy, rad, (40, 60, 220), pat))
+    assert _rate([PARTS[0]]) == 0.0
+
+
+def test_wrong_pattern_renderer_is_not_fulfilled(monkeypatch):
+    orig = hg._paint_polygon
+    monkeypatch.setattr(hg, "_paint_polygon", lambda img, shape, cx, cy, rad, col, pat: orig(img, shape, cx, cy, rad, col, "solid"))
+    assert _rate([PARTS[2]]) == 0.0
+
+
+def test_invisible_part_is_not_fulfilled():
+    p = [{"shape": "square", "color": "white", "zone": "r4", "pattern": "solid", "size": "large"}]
+    assert _rate(p, background="clean_white") == 0.0
+
+
+def test_unrenderable_shape_is_not_fulfilled():
+    p = [{"shape": "oval", "color": "red", "zone": "r4", "pattern": "solid", "size": "medium"}]
+    assert _rate(p) == 0.0
+
+
+def test_fully_occluded_part_is_not_fulfilled():
+    p = [{"shape": "circle", "color": "red", "zone": "r4", "pattern": "solid", "size": "small"},
+         {"shape": "square", "color": "blue", "zone": "r4", "pattern": "solid", "size": "large"}]
+    img, log = hg.render_relations(p, size=96, seed=3, noise=False)
+    v = hg.verify_constructive(p, log)
+    assert v["matched"] == 1 and v["misses"][0]["part"] == 0
+
+
+def test_readback_tolerates_invisible_part():
+    # 被完全遮挡的部件 zone_landed=None：verify_readback 计未命中，不得 TypeError
+    p = [{"shape": "circle", "color": "red", "zone": "r4", "pattern": "solid", "size": "small"},
+         {"shape": "square", "color": "blue", "zone": "r4", "pattern": "solid", "size": "large"}]
+    img, log = hg.render_relations(p, size=96, seed=0)
+    assert log[0]["zone_landed"] is None
+    rb = hg.verify_readback(img, p, log)
+    assert rb["n_pattern"] == 2 and any(m["part"] == 0 for m in rb["misses"])
