+    return r.returncode, (r.stderr.strip().splitlines() or [""])[-1]
+
+bad = []
+tmp = tempfile.mkdtemp()
+r1 = os.path.join(tmp, "r1")
+md(r1, "knowledge/cond_a/a.md", "id: 20261008\nlayer: knowledge")
+md(r1, "knowledge/cond_a/b.md", "id: node_b\nlayer: knowledge\nedges:\n  - {type: causal, target: 20261008}")
+rc = run(r1, os.path.join(tmp, "o1")); print("场景1 数字 id:", rc)
+if rc[0] != 0: bad.append("numeric-id")
