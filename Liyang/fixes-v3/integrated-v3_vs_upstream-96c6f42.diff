+++ b/tests/test_issue270_backup_obs_tables.py
@@ -0,0 +1,45 @@
+# -*- coding: utf-8 -*-
+"""回归（issue #270）：export_all 覆盖库内全部表（或显式 skipped），OBS-REV1 三表往返恢复；新库恢复不叠出重复升级点。"""
+import json, os
+from lingshu.core.core import SpacetimeMemoryEngine
+
+
+def _cnt(e, t):
+    return e.store.conn.execute(f"SELECT COUNT(*) FROM {t}").fetchone()[0]
+
+
+def test_roundtrip_obs_tables_and_escalation(tmp_path):
+    A = SpacetimeMemoryEngine(str(tmp_path / "live.db"))
+    A.add_perception("用户对青霉素过敏", importance=0.9)
+    for x in (0.10, 0.12, 0.15, 0.30, 0.60):
+        A.record_info_gap(x)
+    A.store.set_meta("flywheel_baseline", "0.42")
+    A.store.conn.execute("INSERT INTO action_logs (ts, action_type, summary) VALUES (1,'heartbeat','心跳')")
+    A.store.conn.commit()
+    esc = A.list_escalation_points(enabled_only=False)
+    A.store.conn.execute("UPDATE escalation_points SET enabled=0 WHERE code='ESC-003'")
+    A.store.conn.commit()
+
+    bk = str(tmp_path / "b.json")
+    r = A.export_all(bk)
+    dumped = set(json.load(open(bk, encoding="utf-8"))) - {"meta"}
+    live = {t for (t,) in A.store.conn.execute(
+        "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'")}
+    assert live <= dumped | set(r["skipped_tables"]), sorted(live - dumped)
+
+    B = SpacetimeMemoryEngine(str(tmp_path / "restored.db"))
+    B.import_all(bk)
+    for t in ("gap_history", "action_logs"):
+        assert _cnt(B, t) == _cnt(A, t), t
+    assert B.store.get_meta("flywheel_baseline") == A.store.get_meta("flywheel_baseline")
+    assert B.get_gap_trend()["trend"] == A.get_gap_trend()["trend"] != "insufficient"
+    assert _cnt(B, "escalation_points") == len(esc)
+    assert sum(p["code"] == "ESC-001" for p in B.list_escalation_points(enabled_only=False)) == 1
+    assert not any(p["code"] == "ESC-003" for p in B.list_escalation_points(enabled_only=True))
+
+    # 再备份→恢复、重复导入：不翻倍
+    bk2 = str(tmp_path / "b2.json"); B.export_all(bk2)
+    C = SpacetimeMemoryEngine(str(tmp_path / "r2.db")); C.import_all(bk2); C.import_all(bk2)
+    assert _cnt(C, "escalation_points") == len(esc)
+    assert _cnt(C, "gap_history") == _cnt(A, "gap_history")
+    assert _cnt(C, "action_logs") == _cnt(A, "action_logs")
