+    ("中间有红色实心菱形", "diamond", "solid"),
+    ("中间有蓝色条纹菱形", "diamond", "striped"),
+    ("中间有红色条纹", "stripe", "striped"),   # hex_text 词表里「条纹」本身是形状词，保留
+])
