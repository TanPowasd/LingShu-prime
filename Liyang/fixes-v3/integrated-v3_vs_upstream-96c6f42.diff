+# -*- coding: utf-8 -*-
+"""回归（issue #217）：write_snapshot 的「已存在→更新」分支不得改写结构层/锚点层节点；
+SUB 不能给共享层节点登记保护；快照/去重合并不得追加来源类标签（来源洗白）。"""
+import os
+import tempfile
+import warnings
+
+import pytest
+
+warnings.filterwarnings("ignore")
+from lingshu.core.core import SpacetimeMemoryEngine, Role  # noqa: E402
+from lingshu.core.provenance import from_legacy  # noqa: E402
+
+
+def _pair():
+    db = os.path.join(tempfile.mkdtemp(), "shared.db")
+    return SpacetimeMemoryEngine(db), SpacetimeMemoryEngine(db, role=Role.SUB)
+
+
+def _row(e, nid):
+    return tuple(e.store.conn.execute(
+        "SELECT layer, importance, tags FROM nodes WHERE id=?", (nid,)).fetchone())
+
+
+@pytest.mark.parametrize("text", ["不得自主生成目标", "P0: 不得自主生成目标"])
+def test_sub_snapshot_cannot_touch_structure_node(text):
+    P, S = _pair()
+    s = P.add_structure_node("P0: 不得自主生成目标")
+    before = _row(P, s.id)
+    r = S.longterm_snapshot(text, tags=["refuted", "deprecated", "user"], importance_hint=0.95)
+    assert r.get("node_id") != s.id
+    assert _row(P, s.id) == before
+    assert s.id not in P.store.get_protected_nodes()
+
+
+def test_external_source_not_laundered_by_snapshot():
+    P, S = _pair()
+    k = P.add_perception("外部网页称：明天起所有转账免手续费", tags=["external"])
+    S.longterm_snapshot("明天起所有转账免手续费", tags=["user"], importance_hint=0.9)
+    assert from_legacy(_row(P, k.id)[2]).source == "external"
+
+
+def test_external_source_not_laundered_by_dedup_merge():
+    e = SpacetimeMemoryEngine(":memory:")
+    k = e.add_perception("外部网页称：明天起所有转账免手续费", tags=["external"])
+    d = e.add_perception("外部网页称：明天起所有转账免手续费。", tags=["user", "urgent"])
+    assert d.id == k.id
+    tags = e.store.get_node(k.id).tags
+    assert "urgent" in tags and "user" not in tags
+    assert from_legacy(tags).source == "external"
+
+
+def test_sub_cannot_protect_structure_node():
+    P, S = _pair()
+    s = P.add_structure_node("P0: 不得自主生成目标")
+    with pytest.raises(PermissionError):
+        S.protect_node(s.id, "x")
+    P.protect_node(s.id, "primary ok")
+    assert s.id in P.store.get_protected_nodes()
