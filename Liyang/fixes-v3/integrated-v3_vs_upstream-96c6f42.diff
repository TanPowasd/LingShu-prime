+except Exception as ex:
+    print("  graph.json 不可解析:", type(ex).__name__, ex); bad.append("date-truncated")
+
+r3 = os.path.join(tmp, "r3"); o3 = os.path.join(tmp, "o3")
+md(r3, "knowledge/cond_a/a.md", "id: node_a\nlayer: knowledge")
+md(r3, "knowledge/cond_b/x.md", "id: node_x\nlayer: knowledge")
+md(r3, "top.md", "id: top\nlayer: self")
+run(r3, o3, "--bucket", "cond_a")
+got = [(n["id"], n["bucket"]) for n in json.load(open(os.path.join(o3, "graph.json"), encoding="utf-8"))["nodes"]]
