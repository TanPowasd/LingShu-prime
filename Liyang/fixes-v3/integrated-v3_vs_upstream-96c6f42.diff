+tags / entities 并入已由 2711e11（core-py-02）修复；本提交补：importance 取较大值、
+modality 不同的输入不参与去重、返回值为合并后的最新节点。"""
+import warnings
+
+warnings.filterwarnings("ignore")
+from lingshu.core.core import SpacetimeMemoryEngine  # noqa: E402
+
+
+def test_issue223_merge_keeps_tags_entities_importance():
+    e = SpacetimeMemoryEngine(":memory:")
+    a = e.add_perception("用户说明天上午十点去机场接人", importance=0.3)
+    b = e.add_perception("用户说明天上午十点去机场接人", importance=0.95, tags=["urgent"],
+                         entities=["王五"])
+    assert a.id == b.id
+    n = e.store.get_node(a.id)
+    assert "urgent" in n.tags and "ent:王五" in n.tags
+    assert abs(n.importance - 0.95) < 1e-9
+    assert abs(b.importance - 0.95) < 1e-9     # 返回值反映合并后的状态
