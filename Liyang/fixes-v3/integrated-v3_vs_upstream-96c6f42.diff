+# -*- coding: utf-8 -*-
+"""issue #186：_ray_intersect_2d 必须同时检查两条射线的参数；身后交点无效。"""
+import math
+
+from lingshu.world.wm_simloop import _ray_intersect_2d, estimate_hidden_target
+
+
+def test_point_behind_second_ray_rejected():
+    u = (1 / math.sqrt(2), 1 / math.sqrt(2))
+    assert _ray_intersect_2d((0, 0), (1, 0), (5, 1), u) is None
+
+
+def test_point_behind_first_ray_rejected_and_front_kept():
+    assert _ray_intersect_2d((5, 0), (1, 0), (0, -1), (0, 1)) is None
+    p = _ray_intersect_2d((0, 0), (1, 0), (3, -2), (0, 1))
+    assert p is not None and abs(p[0] - 3) < 1e-9 and abs(p[1]) < 1e-9
+
+
+def test_curved_chase_estimate_ahead_of_chaser():
+    T = [12.0, 16.0]
+    x, z = 12.0, 4.0
+    traj = [(x, 1.5, z)]
+    for _ in range(6):
+        d = math.hypot(T[0] - x, T[1] - z)
+        x += 0.8 * (T[0] - x) / d
+        z += 0.8 * (T[1] - z) / d
+        traj.append((round(x, 3), 1.5, round(z, 3)))
+        T[0] += 0.6
+        T[1] += 0.3
+    pos, q = estimate_hidden_target(traj, 24)
+    assert q > 0.5
+    # 估计点在追逐者前方（沿最后位移方向投影为正）
+    dx, dz = traj[-1][0] - traj[-2][0], traj[-1][2] - traj[-2][2]
+    assert (pos[0] - traj[-1][0]) * dx + (pos[2] - traj[-1][2]) * dz > 0
+    assert math.dist((pos[0], pos[2]), T) < 6.0
