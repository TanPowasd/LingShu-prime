+# -*- coding: utf-8 -*-
+"""回归（issue #251）：cytoscape 复用/下载都校验 sha256、<script> 带 SRI integrity；
+workflow 的 uses: 固定到完整提交 SHA；dsh-memory 按固定 SHA 取，不再 clone HEAD。"""
+import hashlib
+import pathlib
+import re
+
+import pytest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+import sys
+sys.path.insert(0, str(ROOT / "tools" / "coggraph"))
+import build_viewer as bv  # noqa: E402
+
+
+def test_existing_fake_cytoscape_rejected(tmp_path, monkeypatch):
+    fake = tmp_path / "cytoscape.min.js"
+    fake.write_text("/*" + "x" * 200000 + "*/", encoding="utf-8")
+    calls = []
+
+    def no_net(*a, **k):
+        calls.append(a)
+        raise OSError("offline")
+
+    monkeypatch.setattr(bv.urllib.request, "urlopen", no_net)
+    monkeypatch.setattr(bv.time, "sleep", lambda s: None)
+    with pytest.raises(SystemExit):
+        bv.fetch_cytoscape(str(tmp_path))
+    assert calls, "哈希不符的已有文件不得被复用，应尝试重新下载"
+    assert not fake.exists() or hashlib.sha256(fake.read_bytes()).hexdigest() != bv.CYTO_SHA256
+
+
+def test_downloaded_content_verified(tmp_path, monkeypatch):
+    class R:
+        def __enter__(self): return self
+        def __exit__(self, *a): return False
+        def read(self): return b"/*" + b"y" * 200000 + b"*/"
+    monkeypatch.setattr(bv.urllib.request, "urlopen", lambda *a, **k: R())
+    monkeypatch.setattr(bv.time, "sleep", lambda s: None)
+    with pytest.raises(SystemExit):
+        bv.fetch_cytoscape(str(tmp_path))
+    assert not (tmp_path / "cytoscape.min.js").exists()
+
+
+def test_good_file_reused(tmp_path, monkeypatch):
+    data = b"z" * 10
+    monkeypatch.setattr(bv, "CYTO_SHA256", hashlib.sha256(data).hexdigest())
+    (tmp_path / "cytoscape.min.js").write_bytes(data)
+    p, how = bv.fetch_cytoscape(str(tmp_path))
+    assert how == "已有"
+
+
+def test_script_tag_has_integrity():
+    html = bv.HTML.replace("%%CYTO_SRI%%", bv.CYTO_SRI)
+    assert re.search(r'<script src="cytoscape\.min\.js" integrity="sha384-[A-Za-z0-9+/=]{64}"', html)
+    assert "%%CYTO_SRI%%" in bv.HTML
+
+
+def test_workflow_refs_pinned():
+    for wf in (ROOT / ".github" / "workflows").glob("*.yml"):
+        txt = wf.read_text(encoding="utf-8")
+        for m in re.finditer(r"uses:\s*(\S+)", txt):
+            ref = m.group(1)
+            assert re.search(r"@[0-9a-f]{40}$", ref), (wf.name, ref)
+        assert "git clone --depth 1 https://github.com/FuRongJun-1999/dsh-memory.git" not in txt, wf.name
+        if "dsh-memory" in txt:
+            assert re.search(r"DSH_MEMORY_SHA:\s*[0-9a-f]{40}", txt), wf.name
