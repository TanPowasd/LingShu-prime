+"""issue #211：world3d("build", multiview=True) 编造环绕相机位姿三角化；objects 报调用次数而非物体数。"""
+from lingshu.core.core import SpacetimeMemoryEngine
+
+TREES = ["tree@(380,250,420,350)", "tree@(381,250,421,350)", "tree@(382,250,422,350)"]
+
+
+def _engine(poses=None):
+    e = SpacetimeMemoryEngine(":memory:")
+    for i, t in enumerate(TREES):
+        n = e.add_perception(content=f"帧{i} 视觉锚点 {t}", tags=["vprim"], skip_dedup=True)
+        if poses:
+            n.state_attributes["camera_pose"] = poses[i]
+            e.store.add_node(n)   # INSERT OR REPLACE
+    return e
+
+
+def test_multiview_without_pose_does_not_invent_views():
+    e = _engine()
+    r = e.world3d("build", {"multiview": True})
+    assert r["mode"] == "single_view" and r.get("reason") == "no_camera_pose", r
+    assert r["objects"] == len(r["detail"]["objects"]) == 1, r   # 同一棵树 ⇒ 1 个物体
+    assert r["observations"] == 3
+
+
+def test_single_view_objects_is_world_object_count():
+    e = _engine()
+    r = e.world3d("build", {"multiview": False})
+    assert r["objects"] == r["detail"]["count"] == 1, r
+    assert r["observations"] == 3
+
+
+def test_multiview_uses_real_poses_and_triangulates():
+    from lingshu.world.world3d import Camera3D
+    W, H = 800, 600
+    P = (0.0, 1.0, 6.0)
+    poses = [dict(cx=-1.0, cy=1.2, cz=0.0, yaw=0.0, pitch=0.0), dict(cx=1.0, cy=1.2, cz=0.0, yaw=0.0, pitch=0.0)]
+    e = SpacetimeMemoryEngine(":memory:")
+    for i, pose in enumerate(poses):
+        u, v = Camera3D(**pose).project(P, W, H)
+        bb = (int(round(u)) - 20, int(round(v)) - 20, int(round(u)) + 20, int(round(v)) + 20)
+        n = e.add_perception(content="帧%d 视觉锚点 ball@(%d,%d,%d,%d)" % ((i,) + bb), tags=["vprim"], skip_dedup=True)
+        n.state_attributes["camera_pose"] = pose
+        e.store.add_node(n)
+    r = e.world3d("build", {"multiview": True, "screen_w": W, "screen_h": H})
+    assert r["mode"] == "multiview" and "reason" not in r, r
+    objs = r["detail"]["objects"]
+    assert r["objects"] == len(objs) == 1, r
+    c = objs[0]["center"]
+    assert all(abs(a - b) < 0.3 for a, b in zip(c, P)), c
