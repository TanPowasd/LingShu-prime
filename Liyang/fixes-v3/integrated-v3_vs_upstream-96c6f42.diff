+"""回归：scene_model 的 present=skeleton 实体须走骨架通道渲染（新发现 world-n4）。
+
+修复前：build() 构建并摆好姿态的 Skeleton3D 被丢弃，只往 World3D 塞一根占位 pillar 盒，
+render 没有骨架通道——person 被画成米色盒柱，state=happy 与 neutral 渲染逐字节相同。
+"""
+from lingshu.world.scene_model import WorldModel
+
+BONE = (40, 60, 90)
+
+
+def _render(state):
+    wm = WorldModel()
+    wm.add_entity("访客", "person", pos=(0, 0.85, 5.0), state=state)
+    wm.build()
+    return wm, wm.render(300, 300)
+
+
+def _count(img, rgb):
+    raw = img.tobytes()
+    return sum(1 for i in range(0, len(raw), 3) if tuple(raw[i:i + 3]) == rgb)
+
+
+def test_skeleton_is_drawn_not_a_box():
+    wm, img = _render("neutral")
+    assert all(o.category != "skeleton_person" for o in wm.scene.objects)
+    assert _count(img, BONE) > 100
+
+
+def test_state_pose_changes_render():
+    _, a = _render("neutral")
+    _, b = _render("happy")
+    assert a.tobytes() != b.tobytes()
+
+
+def test_box_entities_unchanged():
+    wm = WorldModel()
+    wm.add_entity("桌子", "table", pos=(0, 0.45, 5.0))
+    wm.build()
+    assert [(o.category, o.shape) for o in wm.scene.objects] == [("table", "box")]
