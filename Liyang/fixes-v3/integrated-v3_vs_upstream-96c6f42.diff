+def pair():
+    db = os.path.join(tempfile.mkdtemp(), "shared.db")
+    return SpacetimeMemoryEngine(db), SpacetimeMemoryEngine(db, role=Role.SUB)
+
+
+def test_sub_cannot_add_or_verify_shared_edge(pair):
+    P, S = pair
+    a = P.add_structure_node("P0")
+    anc = P.set_anchor("anchor")
+    with pytest.raises(PermissionError):
+        S.add_edge(anc.id, a.id, EdgeType.OPPOSITE, confidence=1.0)
+    e = P.add_edge(a.id, anc.id, EdgeType.CAUSAL, confidence=0.4)
+    with pytest.raises(PermissionError):
+        S.verify_edge(e.id, 1.0)
+    assert P.store.get_edge(e.id).verified is False
+
+
+def test_sub_cannot_overwrite_primary_shared_edge(pair):
+    P, S = pair
+    a = P.add_structure_node("P0")
+    b = P.add_structure_node("P1")
+    e = P.add_edge(a.id, b.id, EdgeType.CAUSAL, confidence=0.9)
+    P.verify_edge(e.id, 1.0)
+    k = S.add_perception("k", skip_dedup=True)
+    with pytest.raises(PermissionError):          # 改挂到自己的知识层节点同样拒（查旧行端点）
+        S.store.add_edge(dataclasses.replace(P.store.get_edge(e.id), source_id=k.id, target_id=k.id,
+                                             relation_type=EdgeType.SIMILAR, confidence=0.05,
+                                             verified=False))
+    ov = P.store.get_edge(e.id)
+    assert (ov.relation_type, ov.verified, ov.target_id) == (EdgeType.CAUSAL, True, b.id)
+    assert len(P.reason_causal(a.id, b.id)) == 1
+
+
+def test_sub_cascade_delete_cannot_remove_shared_edge(pair):
+    P, S = pair
+    a = P.add_structure_node("P0")
+    k = P.add_perception("知识", skip_dedup=True)
+    e = P.add_edge(k.id, a.id, EdgeType.CAUSAL, confidence=0.9)
+    assert S.store.delete_node(k.id) is False
+    assert P.store.get_edge(e.id) is not None
+
+
+def test_sub_cannot_tag_or_conflict_shared_nodes(pair):
+    P, S = pair
+    a = P.add_structure_node("P0")
+    b = P.add_structure_node("P1")
+    with pytest.raises(PermissionError):
+        S.store.tag_node(a.id, "promotion_pending")
+    with pytest.raises(PermissionError):
+        S.register_conflict(a.id, b.id)
+    assert "promotion_pending" not in P.store.get_node(a.id).tags
+    assert "conflict" not in P.store.get_node(a.id).tags
+
+
+def test_sub_local_layers_and_primary_unaffected(pair):
+    P, S = pair
+    x = S.add_perception("x", skip_dedup=True)
+    y = S.add_perception("y", skip_dedup=True)
+    e = S.add_edge(x.id, y.id)
+    S.verify_edge(e.id, 0.9)
+    S.store.tag_node(x.id, "t")
+    assert S.register_conflict(x.id, y.id) is not None
+    assert S.store.delete_node(x.id) is True
+    a = P.add_structure_node("P0")
+    b = P.add_structure_node("P1")
+    pe = P.add_edge(a.id, b.id, EdgeType.CAUSAL)
+    P.verify_edge(pe.id, 1.0)
+    P.store.tag_node(a.id, "ok")
+    assert P.register_conflict(a.id, b.id) is not None
