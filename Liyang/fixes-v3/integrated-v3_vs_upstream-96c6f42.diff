+"""issue #240 探针：coggraph serve.py 不校验 Host 头（DNS rebinding 可读 /api/node）。"""
+import http.client, importlib.util, json, os, shutil, tempfile, threading
+d = tempfile.mkdtemp()
+open(os.path.join(d, "viewer_graph.json"), "w").write(json.dumps({"nodes": [{"id": "n2", "path": ""}]}))
+shutil.copy(os.path.join("tools", "coggraph", "viewer_serve.tmpl"), os.path.join(d, "serve.py"))
+spec = importlib.util.spec_from_file_location("srv", os.path.join(d, "serve.py"))
+m = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
+s = m.S(("127.0.0.1", 0), m.H); threading.Thread(target=s.serve_forever, daemon=True).start()
+port = s.server_address[1]
+c = http.client.HTTPConnection("127.0.0.1", port, timeout=5)
+c.putrequest("GET", "/api/node?id=n2", skip_host=True); c.putheader("Host", "rebind.attacker.example:%d" % port); c.endheaders()
