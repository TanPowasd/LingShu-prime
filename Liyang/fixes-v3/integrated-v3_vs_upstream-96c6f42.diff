+# -*- coding: utf-8 -*-
+"""回归：SpatiotemporalMemory.remember 的时间锚点须落在运动实际发生的帧区间（issue NEW-nn-03）。"""
+import numpy as np
+
+from lingshu.nn.stcnn import (SpatiotemporalMemory, extract_spatiotemporal_primitives,
+                              synth_ball_rolling, synth_static)
+
+
+def _late_ball(n_idle=40, n_move=4, size=32):
+    fr = [np.zeros((size, size), np.float32) for _ in range(n_idle + n_move)]
+    for t in range(n_idle):
+        fr[t][16:19, 3:6] = 1.0
+    for k in range(n_move):
+        fr[n_idle + k][16:19, 3 + 2 * k:6 + 2 * k] = 1.0
+    return fr
+
+
+def _event(frames, t0):
+    p, _ = extract_spatiotemporal_primitives(frames)
+    return SpatiotemporalMemory().remember(p, "x", t_start=t0)
+
+
+def test_late_motion_is_anchored_when_it_happens():
+    e = _event(_late_ball(), 200)
+    assert (e["t_start"], e["t_end"]) == (240, 243)
+
+
+def test_ball_event_covers_all_frames():
+    e = _event(synth_ball_rolling(10, speed_px=2), 0)
+    assert (e["t_start"], e["t_end"]) == (0, 9)
+
+
+def test_static_event_covers_whole_clip():
+    e = _event(synth_static(6), 100)
+    assert (e["t_start"], e["t_end"]) == (100, 105)
+
+
+def test_legacy_prims_without_span_keep_old_formula():
+    e = SpatiotemporalMemory().remember({"trajectory_len": 5}, "x", t_start=10)
+    assert (e["t_start"], e["t_end"]) == (10, 14)
