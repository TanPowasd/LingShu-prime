+# -*- coding: utf-8 -*-
+"""issue #281：CER 报告对 tone 按取值分组（calm vs 其它）可检验；证伪后 importance 回落。"""
+import os, tempfile, warnings
+warnings.filterwarnings("ignore")
+from lingshu.core.core import SpacetimeMemoryEngine
+
+
+def _engine():
+    return SpacetimeMemoryEngine(os.path.join(tempfile.mkdtemp(), "b.db"))
+
+
+def test_tone_condition_testable_and_refuted_importance_falls_back():
+    s = _engine().store
+    last = None
+    for i in range(20):
+        a = s.insight_record(f"低压力洞见{i}", conditions={"pressure": "low", "tone": "calm"})
+        s.insight_verify(a["node_id"], level="V3", evidence="复现")
+        b = s.insight_record(f"高压力洞见{i}", conditions={"pressure": "high", "tone": "anxious"})
+        s.insight_verify(b["node_id"], level="V3", evidence="初看成立")
+        last = s.insight_verify(b["node_id"], level="REFUTED", evidence="证伪")
+    rep = s.insight_report()
+    conds = {c["condition"]: c for c in rep["conditions"]}
+    assert "pressure" in conds and "tone" in conds
+    assert conds["tone"]["cer_with"] == 1.0 and conds["tone"]["cer_without"] == 0.0
+    assert rep["refuted"] == 20 and rep["pending"] == 0
+    assert last["status"] == "refuted" and last["importance"] < 0.9
+    assert abs(last["importance"] - 0.7) < 1e-9          # 回落到记录时的初始值
+
+
+def test_verified_importance_still_promoted():
+    s = _engine().store
+    a = s.insight_record("普通洞见")
+    r = s.insight_verify(a["node_id"], level="V2", evidence="e")
+    assert r["importance"] == 0.9
