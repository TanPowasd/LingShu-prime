+    monkeypatch.setattr(rust_bridge, "pack_plan", lambda *a, **k: None)
+    monkeypatch.setattr(rust_bridge, "pack_vec", lambda *a, **k: None)
+    monkeypatch.setattr(rust_bridge, "unpack_out", lambda *a, **k: ("ok",))
+    monkeypatch.setattr(rust_bridge.subprocess, "run", lambda *a, **k: seen.update(env=k.get("env")))
+    rust_bridge.run_rust_train(None, None, None, None, {}, workdir=tmp_path)
