+# -*- coding: utf-8 -*-
+"""回归（issue #208）：_note_reuse 同轮同节点只落库一行（DB 部分已由 22a4fe5 / core-py-08 修复），
+且内存 _reuse_tracker 有上界、不随轮次无限增长（本提交）。"""
+import warnings
+
+warnings.filterwarnings("ignore")
+from lingshu.core.core import SpacetimeMemoryEngine  # noqa: E402
+
+
+def test_issue208_same_round_rows_deduped():
+    e = SpacetimeMemoryEngine(":memory:")
+    for t in ("苹果是红色的水果", "香蕉是黄色的水果", "葡萄是紫色的水果"):
+        e.add_perception(t, skip_dedup=True)
+    for q in ("苹果", "香蕉", "葡萄", "水果"):
+        e.search_content(q)
+    rows = e.store.conn.execute(
+        "select round, node_id, count(*) from flywheel_reuse group by round, node_id").fetchall()
+    assert all(r[2] == 1 for r in rows) and len(rows) == 3
