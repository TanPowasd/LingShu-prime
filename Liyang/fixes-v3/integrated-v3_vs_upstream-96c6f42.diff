@@ -0,0 +1,36 @@
+# -*- coding: utf-8 -*-
+"""issue #205：decay_cycle 边衰减只排除 anchor/structure，漏掉同属 IMMUTABLE_LAYERS 的 SELF。"""
+from lingshu.core.core import SpacetimeMemoryEngine, MemoryLayer, LayeredStore, EdgeType
+
+
+def _edges(e, sid):
+    c = e.store.conn.cursor()
+    c.execute("SELECT confidence FROM edges WHERE source_id=?", (sid,))
+    return [r[0] for r in c.fetchall()]
+
+
+def test_self_edge_survives_decay():
+    e = SpacetimeMemoryEngine(":memory:")
+    m = e.add_perception("关键经历：第一次被用户纠正后改正了错误", importance=0.8)
+    mid = getattr(m, "id", m)
+    e.update_self({"current_goal": "从纠正中学习"}, link_to_node_id=mid)
+    s = e.store.get_layer_nodes(MemoryLayer.SELF)[-1]
+    assert _edges(e, s.id) == [1.0]
+    for _ in range(300):
+        e.decay_cycle()
+    assert _edges(e, s.id) == [1.0]
+
+
+def test_ordinary_edge_still_decays():
+    e = SpacetimeMemoryEngine(":memory:")
+    a = e.add_perception("普通经历甲内容", importance=0.8, skip_dedup=True)
+    b = e.add_perception("普通经历乙内容不同", importance=0.8, skip_dedup=True)
+    e.add_edge(a.id, b.id, EdgeType.CAUSAL, confidence=1.0)
+    e.decay_cycle()
+    assert _edges(e, a.id) and _edges(e, a.id)[0] < 1.0
+
+
+def test_exclusion_tracks_immutable_layers():
+    assert MemoryLayer.SELF in LayeredStore.IMMUTABLE_LAYERS
+    assert set(LayeredStore._decay_excluded_layer_values()) == {
+        l.value for l in LayeredStore.IMMUTABLE_LAYERS}
diff --git a/tests/test_issue206_trust_state_range.py b/tests/test_issue206_trust_state_range.py
