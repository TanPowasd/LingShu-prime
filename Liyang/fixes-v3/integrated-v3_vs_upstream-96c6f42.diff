+"""issue #219：split_subjects 的不确定带 `簇数 ≤ 实例数 ≤ 提议数` 被面积 < min_px 的孤立小簇打破
+（小簇被 continue 跳过，却已计入 n_clusters）。"""
+import numpy as np
+import pytest
+
+from lingshu.gen.hexgen_subject_split import split_subjects
+
+SIZE = 512
+YY, XX = np.mgrid[0:SIZE, 0:SIZE]
+
+
+def _img(circles):
+    im = np.full((SIZE, SIZE, 3), 255, np.float64)
+    for cy, cx, r in circles:
+        im[(YY - cy) ** 2 + (XX - cx) ** 2 <= r ** 2] = 0
+    return im
+
+
+@pytest.mark.parametrize("r_small", [2, 3, 4])
+def test_band_holds_with_tiny_isolated_cluster(r_small):
+    d = split_subjects(_img([(150, 150, 20), (400, 400, r_small)]))["diag"]
+    assert d["n_clusters"] <= d["n_instances"] <= d["n_proposed"], d
+    # 原始前景簇数仍可读（不丢信息）
+    assert d["n_fg_clusters"] == 2 and d["n_clusters"] == 1, d
+
+
+def test_band_control_cases_unchanged():
+    d = split_subjects(_img([(150, 150, 20)]))["diag"]
+    assert (d["n_clusters"], d["n_instances"], d["n_proposed"]) == (1, 1, 1)
+    d3 = split_subjects(_img([(100, 100, 18), (250, 380, 18), (420, 150, 18)]))["diag"]
+    assert (d3["n_clusters"], d3["n_instances"], d3["n_proposed"]) == (3, 3, 3)
+    assert d3["n_fg_clusters"] == 3
