+"""world-02：World3D 画家排序/球半径用世界 z 当相机深度。打印 BUG/OK。"""
+from lingshu.world.world3d import World3D, Object3D, Camera3D
+
+W, H = 400, 300
+# ① 相机在 z=20 回看原点：红盒距相机 10m（近），蓝盒 18m（远、更大）
+cam = Camera3D.look_at(eye=(0, 1.2, 20), target=(0, 1.2, 0))
+w = World3D(camera=cam)
+w.objects = [Object3D("redbox", center=(0, 1.2, 10), size=(2, 2, 2), color=(255, 0, 0)),
+             Object3D("bluebox", center=(0, 1.2, 2), size=(6, 6, 2), color=(0, 0, 255))]
+px = w.render(W, H).getpixel((W // 2, H // 2))
+print("① 画面中心像素:", px, "（近处红盒应遮住远处蓝盒 → 期望红色）")
+occl_bug = px[2] > px[0]
+
+# ② 球距相机 5m（相机 z=20，球 z=15）：量渲染出的水平直径
+def sphere_diam(camera, center):
+    w = World3D(camera=camera)
+    w.objects = [Object3D("ball", center=center, size=(1, 1, 1), color=(0, 255, 0), shape="sphere")]
+    img = w.render(W, H, background=(0, 0, 0), ground_color=(0, 0, 0))
+    y = H // 2
+    xs = [x for x in range(W) if img.getpixel((x, y))[1] > 100]
+    return (max(xs) - min(xs)) if xs else 0
+f = cam.focal(W)
+d_used = sphere_diam(cam, (0, 1.2, 15))
+d_true = 2 * f * 0.5 / 5.0
+print(f"② 球距相机 5m：渲染直径 {d_used}px，透视应为 ≈{d_true:.1f}px")
+size_bug = abs(d_used - d_true) > 3
+print("BUG" if occl_bug or size_bug else "OK", f"(遮挡颠倒={occl_bug}, 球尺寸错={size_bug})")
