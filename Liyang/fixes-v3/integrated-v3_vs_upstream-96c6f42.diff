+# -*- coding: utf-8 -*-
+"""回归（issue #225）：M5 去重不得把对立极性（success/failure）的经验合并并为对方增信。"""
+import warnings
+
+warnings.filterwarnings("ignore")
+from lingshu.core.core import SpacetimeMemoryEngine  # noqa: E402
+
+ACTS = ["登录生产服务器", "停止数据库服务", "执行 migrate_v2.sql", "启动数据库服务"]
+OK = "迁移脚本 migrate_v2.sql 执行结束，详细日志见 /var/log/migrate/20261008.log，退出码 0"
+BAD = "迁移脚本 migrate_v2.sql 执行结束，详细日志见 /var/log/migrate/20261008.log，退出码 1（表损坏）"
+
+
+def _seq_nodes(e):
+    return [n for n in e.store.query_nodes(limit=50) if n.content.startswith("[action_seq]")]
+
+
+def test_failures_not_merged_into_success():
+    e = SpacetimeMemoryEngine(":memory:")
+    s = e.record_action_sequence(ACTS, OK, success=True)
+    fails = [e.record_action_sequence(ACTS, BAD, success=False) for _ in range(5)]
+    assert all(f.id != s.id for f in fails)
+    assert abs(e.store.get_node(s.id).confidence - 0.5) < 1e-9
+    pols = sorted(n.tags[1] for n in _seq_nodes(e))
+    assert pols == ["failure", "success"]
+    # 同极性仍去重：5 次失败只有一个失败节点
+    assert len({f.id for f in fails}) == 1
+    got = {n.tags[1] for n, _ in e.recall("migrate_v2.sql 迁移", limit=5)}
+    assert {"success", "failure"} <= got
+
+
+def test_success_not_merged_into_failure():
+    e = SpacetimeMemoryEngine(":memory:")
+    f = e.record_action_sequence(ACTS, BAD, success=False)
+    s = e.record_action_sequence(ACTS, OK, success=True, skill_hint="数据库迁移")
+    assert f.id != s.id
+    assert abs(e.store.get_node(f.id).confidence - 0.5) < 1e-9
+    assert "success" in e.store.get_node(s.id).tags
