+"""issue #143 探针：MCPClient 不消费 stderr，脑侧日志 > 管道缓冲即 call() 永久挂起（外层 15s watchdog）。"""
+import os, subprocess, sys, tempfile, textwrap
+d = tempfile.mkdtemp(); srv = os.path.join(d, "fake_mcp.py")
+open(srv, "w").write(textwrap.dedent('''
+    import sys, json
+    def send(o): sys.stdout.write(json.dumps(o) + "\\n"); sys.stdout.flush()
+    for line in sys.stdin:
+        m = json.loads(line)
+        if m.get("method") == "initialize":
+            send({"jsonrpc": "2.0", "id": m["id"], "result": {"serverInfo": {"name": "fake"}}})
+        elif m.get("method") == "tools/call":
+            sys.stderr.write("W" * 200000); sys.stderr.flush()
+            send({"jsonrpc": "2.0", "id": m["id"], "result": {"content": [{"text": "{}"}]}})
+'''))
+code = f"from lingshu.world.brain_store import MCPClient\nc=MCPClient(pythonpath={d!r}, args=[{srv!r}])\nprint('RES', c.call('x', {{}}))\nc.close()"
+try:
+    out = subprocess.run([sys.executable, "-c", code], capture_output=True, text=True, timeout=15).stdout
+    hung = "RES {}" not in out
+except subprocess.TimeoutExpired:
+    hung = True
+print("call() 挂起 =", hung)
+print("BUG MCPClient stderr 未消费导致死锁" if hung else "OK")
