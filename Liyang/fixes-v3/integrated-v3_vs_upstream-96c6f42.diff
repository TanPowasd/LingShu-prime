+# PR #72 · world/skeleton3d.world_pos 父链旋转合成顺序反了（深度≥2 的世界坐标随祖先旋转漂移）
+import math
+from lingshu.world.skeleton3d import Skeleton3D
+def mm(a, b): return [[sum(a[i][k] * b[k][j] for k in range(3)) for j in range(3)] for i in range(3)]
+def mv(m, v): return tuple(sum(m[i][k] * v[k] for k in range(3)) for i in range(3))
+sk = Skeleton3D(center=(0.0, 0.0, 5.0))
+sk.add_joint("root", (0.0, 0.0, 0.0)); sk.add_joint("mid", (0.1, 0.0, 0.0), parent="root")
+sk.add_joint("leaf", (0.0, -0.3, 0.0), parent="mid")
+sk.joints["root"].rot = (0.0, 0.0, 1.0); sk.joints["mid"].rot = (0.6, 0.0, 0.0)
+R = {n: sk.joints[n]._rot_matrix() for n in sk.joints}
+mid = sk.world_pos("mid")
+want = tuple(mid[i] + mv(mm(R["root"], R["mid"]), mv(R["leaf"], sk.joints["leaf"].pos))[i] for i in range(3))
+got = sk.world_pos("leaf")
+err = math.dist(got, want)
+print("leaf 世界坐标与 A_parent·R_child 参照的偏差 =", round(err, 6), "m")
+print("BUG" if err > 1e-9 else "OK", {"err_m": round(err, 6)})
