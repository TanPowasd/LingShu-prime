+# -*- coding: utf-8 -*-
+"""issue #276：viewer_serve 的 node_detail 须把 path 限定在 MDCG_ROOT 内。"""
+import importlib.util, json, os, shutil, sys, tempfile
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+TMPL = os.path.join(REPO, "tools", "coggraph", "viewer_serve.tmpl")
+
+
+def _load(tmp, nodes, monkeypatch):
+    srv = os.path.join(tmp, "viewer")
+    os.makedirs(srv)
+    shutil.copy(TMPL, os.path.join(srv, "serve.py"))
+    with open(os.path.join(srv, "viewer_graph.json"), "w", encoding="utf-8") as f:
+        json.dump({"nodes": nodes, "edges": []}, f)
+    root = os.path.join(tmp, "mdcg")
+    os.makedirs(os.path.join(root, "sub"))
+    monkeypatch.setenv("MDCG_ROOT", root)
+    monkeypatch.setattr(sys, "argv", ["serve.py"])
+    spec = importlib.util.spec_from_file_location("viewer_serve_t", os.path.join(srv, "serve.py"))
+    m = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(m)
+    return m, root
+
+
+def test_traversal_blocked_and_normal_read_ok(tmp_path, monkeypatch):
+    tmp = str(tmp_path)
+    nodes = [{"id": "evil", "path": "../secret.md"},
+             {"id": "abs", "path": "/etc/hostname"},
+             {"id": "ok", "path": "sub/a.md"}]
+    m, root = _load(tmp, nodes, monkeypatch)
+    with open(os.path.join(tmp, "secret.md"), "w", encoding="utf-8") as f:
+        f.write("TOPSECRET")
+    with open(os.path.join(root, "sub", "a.md"), "w", encoding="utf-8") as f:
+        f.write("---\nk: v\n---\nHELLO")
+    assert "TOPSECRET" not in json.dumps(m.node_detail("evil"), ensure_ascii=False)
+    assert "TOPSECRET" not in json.dumps(m.node_detail("abs"), ensure_ascii=False)
+    assert "HELLO" in m.node_detail("ok")["content"]
