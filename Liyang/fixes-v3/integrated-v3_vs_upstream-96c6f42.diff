+"""world-08：D-006 动态阈值是死代码；返回的 threshold 不是判据边界。打印 BUG/OK（保守修复口径）。"""
+import random
+from lingshu.world.prediction import PredictionEngine
+
+pe = PredictionEngine(engine=None)
+# 场景：长期 0.9，最近 50 次骤降到 0.5
+pe._hit_history = ([True] * 135 + [False] * 15 + [True, False] * 25)[-200:]
+print("① 长期 0.9 → 近期 0.5:", pe._dynamic_hit_threshold())
+
+def run(k, n=200):
+    h = [True] * k + [False] * (n - k); random.Random(k).shuffle(h)
+    pe._hit_history = h
+    return pe._dynamic_hit_threshold()
+r = run(190)
+thr = r["threshold"]
+r2 = run(int(thr * 200) - 1)
+print(f"② mean=0.95 时报 threshold={thr}；命中率真跌到 {r2['mean']}（<{thr}）时 reflect={r2['reflect']}")
+rng = random.Random(0); bad = 0
+for _ in range(20000):
+    n = rng.randint(50, 200); p = rng.random()
+    pe._hit_history = [rng.random() < p for _ in range(n)]
+    rr = pe._dynamic_hit_threshold()
+    bad += rr["reflect"] != (rr["mean"] < pe.BASE_HIT_RATE)
+print("③ 20000 组随机历史中 reflect 与「mean < 0.40」不一致次数 =", bad, "（动态项零影响）")
+print("BUG" if not r2["reflect"] else "OK", "(所报 threshold 是否为真实判据边界；动态退化检测本身 needs-owner-decision)")
