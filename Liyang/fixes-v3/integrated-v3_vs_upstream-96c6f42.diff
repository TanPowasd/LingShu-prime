+# nn-04 · hex_gen.verify_constructive 只比对「日志回显的输入字段」：渲染器什么都不画也报 100%
+# 运行：在仓库根目录 PYTHONPATH=. python nn-04.py
+import numpy as np
+import lingshu.nn.hex_gen as hg
+
+parts = [{"shape": "circle", "color": "red", "zone": "r0", "pattern": "solid", "size": "medium"},
+         {"shape": "triangle", "color": "green", "zone": "r8", "pattern": "solid", "size": "medium"}]
+
+img0, log0 = hg.render_relations(parts, size=96, seed=3, noise=False)
+print("A 正常渲染     rate =", hg.verify_constructive(parts, log0)["rate"],
+      "| 前景像素(max>30) =", int((img0.max(-1) > 30).sum()))
+
+# B：把两个绘制函数换成空操作——图上一个部件都没有
+orig = hg._paint, hg._paint_polygon
+hg._paint = lambda *a, **k: None
+hg._paint_polygon = lambda *a, **k: None
+img1, log1 = hg.render_relations(parts, size=96, seed=3, noise=False)
+print("B 渲染器置空   rate =", hg.verify_constructive(parts, log1)["rate"],
+      "| 前景像素(max>30) =", int((img1.max(-1) > 30).sum()))
+hg._paint, hg._paint_polygon = orig
+
+# C：公开参数组合下的「画了等于没画」：白色部件 + clean_white 背景（两者 RGB 都是 245）
+p2 = [{"shape": "square", "color": "white", "zone": "r4", "pattern": "solid", "size": "large"}]
+img2, log2 = hg.render_relations(p2, size=96, seed=3, noise=False, background="clean_white")
+print("C 白方块@白底  rate =", hg.verify_constructive(p2, log2)["rate"],
+      "| 与背景不同的像素 =", int((np.abs(img2.astype(int) - 245).sum(-1) > 0).sum()))
+
+# D：词表外形状落进 _paint 的 else 分支（被画成 stripe 块），日志仍记原形状
+p3 = [{"shape": "oval", "color": "red", "zone": "r4", "pattern": "solid", "size": "medium"}]
+img3, log3 = hg.render_relations(p3, size=96, seed=3, noise=False)
+print("D oval        rate =", hg.verify_constructive(p3, log3)["rate"], "| 日志 shape =", log3[0]["shape"])
+
+# E：仓内验收件 tests/test_hex_gen.py 在「渲染器置空」下的 P1①/P1③ 判定
+import io, contextlib, sys, os
+sys.path.insert(0, "tests")
+import test_hex_gen as T
+hg._paint = lambda *a, **k: None
+hg._paint_polygon = lambda *a, **k: None
+buf = io.StringIO()
+with contextlib.redirect_stdout(buf):
+    try:
+        T.run_checks()
+    except Exception as e:
+        print("EXC", type(e).__name__, e)
+hg._paint, hg._paint_polygon = orig
+lines = [l for l in buf.getvalue().splitlines() if ("P1①" in l or "P1③" in l) and ("PASS" in l or "FAIL" in l)]
+print("E 渲染器置空时 test_hex_gen 的 P1①/P1③ 判定:")
+for l in lines:
+    print("  ", l.strip())
+
+rB = hg.verify_constructive(parts, log1)["rate"]; rC = hg.verify_constructive(p2, log2)["rate"]; rD = hg.verify_constructive(p3, log3)["rate"]
+print("BUG" if max(rB, rC, rD) > 0 else "OK", {"B": rB, "C": rC, "D": rD})
