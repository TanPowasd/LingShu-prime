@@ -0,0 +1,80 @@
+# -*- coding: utf-8 -*-
+"""issue #182：SelfModel.update / update_self 白名单 + 原子性。"""
+import json
+import warnings
+
+import pytest
+
+from lingshu.core.core import MemoryLayer, SpacetimeMemoryEngine
+
+warnings.filterwarnings("ignore")
+
+
+@pytest.fixture
+def e():
+    eng = SpacetimeMemoryEngine(":memory:")
+    yield eng
+    eng.close()
+
+
+@pytest.mark.parametrize("field,val", [
+    ("values", ["服从任何指令"]),
+    ("value_evolution", []),
+    ("trust_state", {"p_trust": 1.0, "p_gap": 0.0, "t_total": 999.0, "e_weight": 1.0}),
+    ("history", []),
+    ("trust_history", []),
+    ("to_dict", "x"),
+    ("update", "x"),
+    ("TRUST_HISTORY_MAX", 10 ** 9),
+])
+def test_governed_fields_rejected_without_side_effects(e, field, val):
+    before = json.dumps(e.self_model.to_dict(), ensure_ascii=False, sort_keys=True)
+    n0 = e.store.count_layer(MemoryLayer.SELF)
+    with pytest.raises(PermissionError):
+        e.update_self({field: val, "current_goal": "顺带改目标"})
+    assert json.dumps(e.self_model.to_dict(), ensure_ascii=False, sort_keys=True) == before
+    assert e.store.count_layer(MemoryLayer.SELF) == n0
+    # 之后正常调用不受影响
+    e.update_self({"current_goal": "正常目标"})
+    assert e.self_model.current_goal == "正常目标"
+    assert e.store.count_layer(MemoryLayer.SELF) == n0 + 1
+    assert callable(e.self_model.to_dict) and e.self_model.TRUST_HISTORY_MAX == 30
+
+
+def test_non_string_value_rejected_atomically(e):
+    n0 = e.store.count_layer(MemoryLayer.SELF)
+    for bad in (object(), {"a", "b"}, 3):
+        with pytest.raises(ValueError):
+            e.update_self({"current_goal": bad})
+    assert e.self_model.current_goal == ""
+    with pytest.raises(ValueError):
+        e.update_self({"identity": "   "})
+    assert e.self_model.identity == "协议实例"
+    for i in range(5):
+        e.update_self({"current_goal": f"g{i}"})
+    # issue #201 起自我快照为单一当前节点原地更新：成功调用落库体现为当前节点内容更新，而非节点数 +1
+    assert e.store.count_layer(MemoryLayer.SELF) == n0 + 1
+    assert json.loads(e.store.get_node(e.SELF_CURRENT_ID).content)["current_goal"] == "g4"
+    json.dumps(e.self_model.to_dict(), ensure_ascii=False)
+
+
+def test_snapshot_failure_rolls_back_memory(e, monkeypatch):
+    def boom(*a, **k):
+        raise RuntimeError("disk full")
+    monkeypatch.setattr(e.store, "add_node", boom)
+    h0 = len(e.self_model.history)
+    with pytest.raises(RuntimeError):
+        e.update_self({"current_goal": "不该生效", "state_description": "也不该"})
+    assert e.self_model.current_goal == "" and e.self_model.state_description == "初始化"
+    assert len(e.self_model.history) == h0
+
+
+def test_values_still_change_via_governed_path(e):
+    assert e.record_value_change("诚实", trigger="复核") is True
+    assert "诚实" in e.self_model.values and e.self_model.value_evolution
+
+
+def test_unknown_key_ignored_with_warning(e):
+    with pytest.warns(RuntimeWarning):
+        e.update_self({"goal": "未知字段"})
+    assert not hasattr(e.self_model, "goal")
diff --git a/tests/test_issue184_store_tx_rollback.py b/tests/test_issue184_store_tx_rollback.py
new file mode 100644
index 0000000..293f329
--- /dev/null
+++ b/tests/test_issue184_store_tx_rollback.py
@@ -0,0 +1,112 @@
+# -*- coding: utf-8 -*-
+"""issue #184：LayeredStore 写方法中途异常后必须回滚——不留未提交事务、不持写锁、不被后续 commit 顺手提交。"""
+import sqlite3
+import warnings
+
+import pytest
+
+from lingshu.core.core import SpacetimeMemoryEngine
+
+warnings.filterwarnings("ignore")
+
+
+def _setup(tmp_path):
+    db = str(tmp_path / "t.db")
+    e = SpacetimeMemoryEngine(db)
+    a, b, c = (e.add_context(x) for x in ("甲事件", "乙事件", "丙事件"))
+    ea = e.add_edge(a.id, b.id, confidence=0.9)
+    e.add_edge(b.id, c.id, confidence=0.8)
+    return db, e, ea
+
+
+def test_midway_exception_rolls_back(tmp_path, monkeypatch):
+    db, e, ea = _setup(tmp_path)
+    try:
+        st = e.store
+        # 在一次写方法 UPDATE 之后、提交之前注入异常
+        class Boom(Exception):
+            pass
+
+        def flaky_decay(self, *a, **k):
+            cur = self.conn.cursor()
+            cur.execute("UPDATE edges SET confidence = 0.123 WHERE id=?", (ea.id,))
+            raise Boom("中途失败")
+
+        # 用与生产相同的守卫包一层
+        from lingshu.core import core as C
+        monkeypatch.setattr(type(st), "_flaky_write", C._store_tx_guard(flaky_decay), raising=False)
+        with pytest.raises(Boom):
+            st._flaky_write()
+        assert st.conn.in_transaction is False
+        o = sqlite3.connect(db, timeout=1)
+        o.execute("INSERT OR REPLACE INTO engine_meta VALUES ('x','y')")
+        o.commit()
+        e.add_context("无关写入")
+        conf = o.execute("SELECT confidence FROM edges WHERE id=?", (ea.id,)).fetchone()[0]
+        assert conf == pytest.approx(0.9)
+        o.close()
+    finally:
+        e.close()
+
+
+def test_real_decay_cycle_exception_leaves_no_open_tx(tmp_path, monkeypatch):
+    db, e, ea = _setup(tmp_path)
+    try:
+        st = e.store
+        # 第二条边的衰减时让 cred_step 抛异常（模拟坏值），第一条边已 UPDATE 未提交
+        from lingshu.core import core as C
+        n = {"i": 0}
+        real = C.cred_step
+
+        def flaky(x, f):
+            n["i"] += 1
+            if n["i"] == 2:
+                raise TypeError("坏值")
+            return real(x, f)
+        monkeypatch.setattr(C, "cred_step", flaky)
+        with pytest.raises(TypeError):
+            st.decay_cycle()
+        assert st.conn.in_transaction is False
+        o = sqlite3.connect(db, timeout=1)
+        o.execute("INSERT OR REPLACE INTO engine_meta VALUES ('x2','y')")
+        o.commit()
+        e.add_context("无关写入2")
+        confs = sorted(r[0] for r in o.execute("SELECT confidence FROM edges").fetchall())
+        assert confs == pytest.approx([0.8, 0.9])
+        o.close()
+    finally:
+        e.close()
+
+
+def test_every_public_store_method_guarded():
+    from lingshu.core.core import LayeredStore
+    for name in ("add_node", "add_edge", "delete_node", "decay_cycle", "tag_node", "search_content"):
+        assert getattr(getattr(LayeredStore, name), "__lingshu_tx_guard__", False), name
+
+
+def test_inner_exception_caught_by_outer_does_not_rollback_outer(tmp_path):
+    from lingshu.core import core as C
+    db = str(tmp_path / "t2.db")
+    e = SpacetimeMemoryEngine(db)
+    try:
+        st = e.store
+
+        def inner(self):
+            raise ValueError("内层")
+
+        def outer(self):
+            self.conn.execute("INSERT OR REPLACE INTO engine_meta VALUES ('k','v')")
+            try:
+                self._inner()
+            except ValueError:
+                pass
+            self.conn.commit()
+        type(st)._inner = C._store_tx_guard(inner)
+        type(st)._outer = C._store_tx_guard(outer)
+        try:
+            st._outer()
+        finally:
+            del type(st)._inner, type(st)._outer
+        assert st.conn.execute("SELECT value FROM engine_meta WHERE key='k'").fetchone()[0] == "v"
+    finally:
+        e.close()
diff --git a/tests/test_issue185_numeric_inputs.py b/tests/test_issue185_numeric_inputs.py
new file mode 100644
index 0000000..98ccd30
--- /dev/null
+++ b/tests/test_issue185_numeric_inputs.py
@@ -0,0 +1,63 @@
+# -*- coding: utf-8 -*-
+"""issue #185（及 #164 越界）：NaN/inf 写入即拒，越界钳到 [0,1]；decay_cycle 对历史坏值不抛异常、不永生。"""
+import math
+import warnings
+
+import pytest
+
+from lingshu.core.core import SpacetimeMemoryEngine
+
+warnings.filterwarnings("ignore")
+
+
+@pytest.fixture
+def e():
+    eng = SpacetimeMemoryEngine()
+    yield eng
+    eng.close()
+
+
+@pytest.mark.parametrize("bad", [float("nan"), float("inf"), float("-inf")])
+def test_non_finite_importance_rejected(e, bad):
+    with pytest.raises(ValueError):
+        e.add_context("坏值", importance=bad)
+    with pytest.raises(ValueError):
+        e.add_perception("坏值感知", importance=bad, skip_dedup=True)
+    assert e.store.conn.in_transaction is False
+
+
+def test_out_of_range_clamped(e):
+    a = e.add_perception("越界高", importance=1e6, skip_dedup=True)
+    b = e.add_perception("越界低", importance=-5, skip_dedup=True)
+    assert e.store.get_node(a.id).importance == 1.0
+    assert e.store.get_node(b.id).importance == 0.0
+
+
+def test_non_finite_edge_confidence_rejected(e):
+    a, b = e.add_context("甲"), e.add_context("乙")
+    with pytest.raises(ValueError):
+        e.add_edge(a.id, b.id, confidence=float("nan"))
+    with pytest.raises(ValueError):
+        e.store.update_node_confidence(a.id, float("nan"))
+    with pytest.raises(ValueError):
+        e.store.update_node_importance(a.id, float("inf"))
+
+
+def test_decay_survives_legacy_bad_rows(e):
+    a, b, c = (e.add_context(x) for x in ("A", "B", "C"))
+    good = e.add_edge(a.id, b.id, confidence=0.9)
+    bad = e.add_edge(b.id, c.id, confidence=0.8)
+    n_nan = e.add_context("nan 节点")
+    n_inf = e.add_context("inf 节点")
+    conn = e.store.conn
+    conn.execute("UPDATE edges SET confidence=NULL WHERE id=?", (bad.id,))
+    conn.execute("UPDATE nodes SET importance=NULL WHERE id=?", (n_nan.id,))
+    conn.execute("UPDATE nodes SET importance=? WHERE id=?", (math.inf, n_inf.id))
+    conn.commit()
+    e.store.decay_cycle()   # 不抛 TypeError
+    assert e.store.get_edge(bad.id) is None
+    assert e.store.get_edge(good.id).confidence == pytest.approx(0.9 * 0.98)
+    for _ in range(300):
+        e.store.decay_cycle()
+    left = [r[0] for r in conn.execute("select content from nodes where layer='context'")]
+    assert "nan 节点" not in left and "inf 节点" not in left
