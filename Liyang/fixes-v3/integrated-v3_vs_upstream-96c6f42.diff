+# -*- coding: utf-8 -*-
+"""issue #187：synonym_merge L2 的序数守卫须生效——仅序数互换的标题不归并，真正的语序变体仍归并。"""
+import json
+
+from tools.coggraph.synonym_merge import is_ordinal_diff, main
+
+
+def _run(tmp_path, titles):
+    g = {"nodes": [{"id": f"n{i}", "title": t, "bucket": "doc"} for i, t in enumerate(titles)]}
+    gp = tmp_path / "g.json"
+    gp.write_text(json.dumps(g, ensure_ascii=False), encoding="utf-8")
+    out = tmp_path / "out"
+    main(["--graph", str(gp), "--out", str(out), "--write"])
+    return [sorted(x["title"] for x in m["members"])
+            for m in json.loads((out / "synonym_groups.json").read_text(encoding="utf-8"))["groups"]
+            if m["kind"] == "synonym"]
+
+
+def test_ordinal_swaps_not_merged(tmp_path):
+    groups = _run(tmp_path, ["第一章第二节", "第二章第一节", "一号线换二号线", "二号线换一号线"])
+    assert groups == []
+
+
+def test_true_word_order_variant_still_merged(tmp_path):
+    groups = _run(tmp_path, ["知识图谱构建", "构建知识图谱"])
+    assert groups == [sorted(["知识图谱构建", "构建知识图谱"])]
+
+
+def test_l3_edit_distance_one_unchanged():
+    assert is_ordinal_diff("第一章", "第二章") is True
+    assert is_ordinal_diff("记忆层", "记忆库") is False
