+"""core-py-06 复现：stop/start_auto_decay 在一个 interval 内交替会叠加衰减线程。
+用法：cd <worktree> && PYTHONPATH=. python _out/repro/core-py-06.py"""
+import threading, time
+from lingshu.core.core import SpacetimeMemoryEngine
+
+e = SpacetimeMemoryEngine()
+calls = []
+orig = e.decay_cycle
+e.decay_cycle = lambda *a, **k: (calls.append(time.time()), orig(*a, **k))
+before = set(threading.enumerate())
+e.start_auto_decay(interval=0.5)
+time.sleep(0.1); e.stop_auto_decay(); e.start_auto_decay(interval=0.5)
+time.sleep(0.1); e.stop_auto_decay(); e.start_auto_decay(interval=0.5)
+time.sleep(0.2)
+alive = len([t for t in threading.enumerate() if t not in before and t.is_alive()])
+print("decay threads alive:", alive)
+time.sleep(1.8)
+e.stop_auto_decay()
+print("decay_cycle calls in ~2.2s with interval=0.5 (expected ~4):", len(calls))
+print("BUG" if alive > 1 or len(calls) > 6 else "OK")
