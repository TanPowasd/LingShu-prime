+# -*- coding: utf-8 -*-
+"""回归（issue #246）：情境层容量上限随库持久（重启 / 同库第二实例不按默认 200 批删）；
+浮点整值容量归一为 int，非法容量在配置点即报错。"""
+import os
+import tempfile
+import warnings
+
+import pytest
+
+warnings.filterwarnings("ignore")
+from lingshu.core.core import SpacetimeMemoryEngine, MemoryLayer  # noqa: E402
+
+
+def test_cap_survives_restart():
+    db = os.path.join(tempfile.mkdtemp(), "ctx.db")
+    e = SpacetimeMemoryEngine(db)
+    e.set_context_cap(1000)
+    first = e.add_context("用户：我对青霉素过敏，开药前务必提醒")
+    for i in range(299):
+        e.add_context(f"会话第 {i} 轮的情境")
+    e.store.conn.close()
+    e = SpacetimeMemoryEngine(db)
+    assert e._context_max == 1000
+    e.add_context("重启后的第一条情境")
+    assert e.store.count_layer(MemoryLayer.CONTEXT) == 301
+    assert e.store.get_node(first.id) is not None
+
+
+def test_second_instance_respects_shared_cap():
+    db = os.path.join(tempfile.mkdtemp(), "ctx2.db")
+    a = SpacetimeMemoryEngine(db)
+    b = SpacetimeMemoryEngine(db)          # 先于 A 调容量构造
+    a.set_context_cap(500)
+    for i in range(250):
+        a.add_context(f"A 实例情境 {i}")
+    b.add_context("B 实例写一条")
+    assert a.store.count_layer(MemoryLayer.CONTEXT) == 251
+
+
+def test_float_cap_normalised_and_invalid_rejected():
+    c = SpacetimeMemoryEngine(":memory:")
+    c.set_context_cap(200.0)
+    assert c._context_max == 200 and isinstance(c._context_max, int)
+    for i in range(205):
+        c.add_context(f"x{i}")
+    assert c.store.count_layer(MemoryLayer.CONTEXT) == 200
+    for bad in (200.5, "abc", None, True):
+        with pytest.raises((ValueError, TypeError)):
+            c.set_context_cap(bad)
+    assert c._context_max == 200
