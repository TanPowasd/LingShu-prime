+# -*- coding: utf-8 -*-
+"""回归：naming_report Q4 规范标识词在中文标题 / GB/T 编号上可命中（新发现 core2-new-01）。"""
+import importlib.util
+import json
+import os
+
+import pytest
+
+_TOOL = os.path.join(os.path.dirname(__file__), "..", "tools", "coggraph", "naming_report.py")
+_spec = importlib.util.spec_from_file_location("naming_report_under_test", _TOOL)
+nr = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(nr)
+
+HITS = ["GB/T 7714-2015 文后参考文献著录规则", "GB 2312 字符集编码", "GB/T7714 著录",
+        "ISO9001质量体系", "ISO 9001 质量体系", "中国药典2020版收载品种",
+        "《中华人民共和国药典》", "符合国家标准的接口规范", "发明专利申请流程", "RFC2616 协议"]
+MISSES = ["ISOLATION 隔离级别说明", "INNER JOIN 用法", "spinning 纺纱工艺记录", "16GB 2条内存配置"]
+
+
+@pytest.mark.parametrize("title", HITS)
+def test_norm_marker_hits(title):
