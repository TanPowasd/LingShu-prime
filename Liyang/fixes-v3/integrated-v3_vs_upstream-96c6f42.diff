+# -*- coding: utf-8 -*-
+"""回归（issue #266）：查询超过 SQLite LIKE 模式上限（默认 50000 字节）时 recall/search_content/semantic_search 不抛异常、
+仍能召回相关记忆；反思不再把长 claim 判为「无相关记忆」；长期记忆门对长快照查重有效。"""
+from lingshu.core.core import SpacetimeMemoryEngine
+
+BASE = "请结合之前的记忆回答：用户对青霉素过敏吗？"
+
+
+def test_long_query_recall_paths():
+    e = SpacetimeMemoryEngine(":memory:")
+    a = e.add_perception("用户对青霉素过敏，禁用阿莫西林", importance=0.9)
+    for n in (16000, 16700, 20000):
+        q = BASE + "。" * (n - len(BASE))
+        for fn in (e.recall, e.search_content, e.semantic_search):
+            r = fn(q)
+            assert r and r[0][0].id == a.id, (n, fn.__name__)
+
+
+def test_reflect_long_claim_not_fail_open():
+    claim = "用户对青霉素过敏，本次处方不得含阿莫西林" + "（附病历原文）" + "。" * 17000
+    r = SpacetimeMemoryEngine(":memory:")
+    r.add_perception("用户对青霉素过敏，禁用阿莫西林", importance=0.9)
+    rep = r.recursive_reflect(claim)
+    assert "无相关记忆" not in rep["verification"]["detail"]
+
+
+def test_longterm_snapshot_dedup_long_text():
+    e = SpacetimeMemoryEngine(":memory:")
+    long_ = "会话总结：用户对青霉素过敏，禁用阿莫西林。附：完整会话记录。" + "对话内容" * 4200
+    ids = {e.longterm_snapshot(long_, importance_hint=0.9).get("node_id") for _ in range(5)}
+    assert len(ids) == 1
