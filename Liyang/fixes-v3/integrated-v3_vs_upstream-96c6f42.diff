+# -*- coding: utf-8 -*-
+"""回归（issue #238）：已落仓的 workflow / 脚本 / docs 不再自称「工作区草稿（尚未落仓）」，不再引用「见报告」「仓工作纪律第 15 条」。"""
+import glob, os, re
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+PAT = re.compile(r"工作区草稿|尚未落仓|未落仓）|见报告|第 15 条")
