@@ -0,0 +1,54 @@
+"""issue #218：hexgen_self_source
+A) _solve_centroid._anchor 把 legal_win 的 (x0,x1,y0,y1) 按 (x0,y0,x1,y1) 解包 ⇒ 锚点落到合法窗外、n=1 误缩径；
+B) place_objects 声明确定性，但 spread 档 _solve_placement 用 set 迭代序分配格子（跨进程换图）。"""
+import os, subprocess, sys
+import numpy as np
+import pytest
+
+from lingshu.gen import hexgen_self_source as S
+
+ZC = {"row": {"cuts": [0.5236, 0.6484]}, "col": {"cuts": [0.264, 0.6234]}}  # 模块注释引用的冻结切点
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+@pytest.mark.parametrize("shape", ["heart", "rectangle"])
+def test_single_cell_keeps_nominal_radius(shape):
+    # 「lower left」= r6；修前 heart→48、rectangle→47（标称 51）
+    r, pts = S._solve_centroid(("r6",), 1, 51, 512, shape, ZC)
+    assert r == 51, (shape, r, pts)
+    x0, x1, y0, y1 = S.legal_win("r6", shape, r, 512, ZC)
+    (x, y), = pts
+    assert x0 <= x <= x1 and y0 <= y <= y1, ((x, y), (x0, x1, y0, y1))
+
+
+@pytest.mark.parametrize("shape", ["circle", "heart", "rectangle", "triangle"])
+@pytest.mark.parametrize("cell", ["r%d" % i for i in range(9)])
+def test_anchor_center_inside_legal_window(cell, shape):
+    # n=1：落点必须在 legal_win 自己声明的 (x0,x1,y0,y1) 窗内
+    r, pts = S._solve_centroid((cell,), 1, 51, 512, shape, ZC)
+    x0, x1, y0, y1 = S.legal_win(cell, shape, r, 512, ZC)
+    (x, y), = pts
+    if x1 >= x0:
+        assert x0 <= x <= x1, (cell, x, (x0, x1))
+    if y1 >= y0:
+        assert y0 <= y <= y1, (cell, y, (y0, y1))
+
+
+_CHILD = r"""
+import sys, hashlib
+from lingshu.gen import hexgen_self_source as S
+S.PLACE_MODE = "spread"
+cells = tuple({"r0", "r3", "r6"})     # 与 self_prompt_items 一致：set → tuple 保留本进程哈希序
+pts, r = S.place_objects(cells, 4, 51, 512, "circle")
+print(repr((sorted(cells) and pts, r)))
+"""
+
+
+def test_spread_mode_deterministic_across_hashseeds():
+    outs = set()
+    for seed in ("0", "1", "2", "3", "4", "5"):
+        env = dict(os.environ, PYTHONHASHSEED=seed, PYTHONPATH=ROOT)
+        p = subprocess.run([sys.executable, "-c", _CHILD], env=env, capture_output=True, text=True, timeout=120)
+        assert p.returncode == 0, p.stderr
+        outs.add(p.stdout.strip())
+    assert len(outs) == 1, outs
