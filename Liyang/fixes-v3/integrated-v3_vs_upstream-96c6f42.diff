+"""issue #215 复现：环长 > max_depth+1 时 has_causal_cycle=True 而 self_check 报 cycles_found=0；
+有环稠密图 self_check 仍整趟深搜枚举。
+用法：cd <worktree> && PYTHONPATH=. python bench/probes/issue215.py"""
+import random, time
+from lingshu.core.core import SpacetimeMemoryEngine as E, EdgeType
+
+
+def mk(e, n):
+    return [e.add_perception(f"事件节点{i}：独立观察记录{i*7919}", skip_dedup=True).id for i in range(n)]
+
+
+e = E(":memory:"); ids = mk(e, 40)
+for i in range(39):
+    e.add_edge(ids[i], ids[i + 1], EdgeType.CAUSAL)
+e.add_edge(ids[9], ids[0], EdgeType.CAUSAL)          # 唯一环，环长 10
+hcc = e.store.has_causal_cycle(); sc = e.self_check()["cycles_found"]
+print("环长10: has_causal_cycle =", hcc, " self_check cycles_found =", sc)
+
+random.seed(1)
+e2 = E(":memory:"); ids = mk(e2, 45); seen = set()
+while len(seen) < 211:
+    a, b = random.sample(range(45), 2)
+    if (a, b) not in seen:
+        seen.add((a, b)); e2.add_edge(ids[a], ids[b], EdgeType.CAUSAL)
+t = time.perf_counter(); r = e2.self_check(); dt = time.perf_counter() - t
+print(f"45 节点/211 边有环图: self_check {dt*1000:.1f} ms, cycles_found={r['cycles_found']}")
+
+bad = (hcc and sc == 0) or dt > 0.3
+print("BUG" if bad else "OK")
