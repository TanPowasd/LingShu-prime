+"""world-n2：World3D 组合形状（shapes 库）部件按定义顺序绘制、不做深度排序——远侧部件盖住近侧部件。打印 BUG/OK。"""
+from lingshu.world.world3d import World3D, Object3D, Camera3D, default_spec
+from lingshu.world.shapes import get_shape
+
+W, H = 400, 300
+
+def probe(category, center, behind_part_idx, front_part_idx, cam=None):
+    """沿「相机→远侧部件中心」的视线，取该视线穿过近侧部件处的像素。"""
+    s = default_spec(category)
+    w = World3D(camera=cam) if cam else World3D()
+    w.objects = [Object3D(category, center=center, size=s.size, color=s.color, shape=s.shape)]
+    img = w.render(W, H, background=(0, 0, 0), ground_color=(0, 0, 0))
+    parts = get_shape(category)
+    far = parts[behind_part_idx]
+    pc = tuple(center[k] + far["pos"][k] for k in range(3))
+    pc = (pc[0], pc[1] + far["size"][1] / 3, pc[2])      # 腿的上段（与身体在画面上重叠）
+    p = w.camera.project(pc, W, H)
+    px = img.getpixel((int(p[0]), int(p[1])))
+    near_col = parts[front_part_idx]["color"]; far_col = far["color"]
+    return px, near_col, far_col
+
+# dog：身体 parts[0]（中心 dz=0）与 dz=+0.2 的腿 parts[2]（相机在原点朝 +z，该腿在身体后方，应被挡住）
+px, near_c, far_c = probe("dog", (0, 0.3, 2.0), 2, 0)
+print("dog：视线穿过身体、落在其后方腿上的像素", px, "| 身体色", near_c, "| 腿色", far_c)
+is_leg = all(abs(px[k] - int(far_c[k] * 0.95)) <= 2 for k in range(3))
+print("BUG" if is_leg else "OK", "(远侧腿盖在身体上)" if is_leg else "")
