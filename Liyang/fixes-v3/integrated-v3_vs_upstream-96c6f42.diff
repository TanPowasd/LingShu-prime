+# nn-02 · hex_gen.compile_description：方位词里的「心」「方」被当成形状词（中心→heart，下方→square），且不落缺省账
+# 运行：在仓库根目录 PYTHONPATH=. python nn-02.py
+from lingshu.nn.hex_gen import compile_description, generate_from_text, OPEN_SHAPES
+from lingshu.nn.hex_text import POS_WORDS
+
+# 词表碰撞扫描：方位词（含 hex_text 复合词与常见「X方」写法）里含有哪些形状词
+pos_words = list(POS_WORDS) + ["中间", "上方", "下方", "左方", "右方", "左上方", "右下方"]
+print("碰撞:", [(p, k, OPEN_SHAPES[k]) for p in pos_words for k in OPEN_SHAPES if k in p])
+
+for t in ["中心有红色", "中间有红色", "中心有蓝色菱形", "下方有绿色", "右下方有蓝色菱形", "下方有红色星", "中心有红色圆形"]:
+    c = compile_description(t)
+    p = c["parts"][0]
+    print(f"{t:<10} -> shape={p['shape']:<8} zone={p['zone']}  缺省落账字段={[d['field'] for d in c['defaults_applied']]}")
+
+g = generate_from_text("中心有蓝色菱形", size=96)
+print("端到端:", g["parts"][0]["shape"], "构造性兑现率=", g["constructive"]["rate"])
+
+bad = [t for t, want in [("中心有红色", "circle"), ("中心有蓝色菱形", "diamond"), ("右下方有蓝色菱形", "diamond"),
+                         ("下方有红色星", "star"), ("中间有红色实心菱形", "diamond"), ("中间有蓝色条纹菱形", "diamond")]
+       if compile_description(t)["parts"][0]["shape"] != want]
+print("BUG" if bad else "OK", bad)
