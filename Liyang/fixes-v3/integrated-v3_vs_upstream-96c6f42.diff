+r2 = os.path.join(tmp, "r2"); o2 = os.path.join(tmp, "o2")
+md(r2, "knowledge/cond_a/c.md", "id: node_c\nlayer: knowledge\ncreated_at: 2026-10-08")
+rc = run(r2, o2); print("场景2 日期 created_at:", rc)
+g = os.path.join(o2, "graph.json")
+try:
