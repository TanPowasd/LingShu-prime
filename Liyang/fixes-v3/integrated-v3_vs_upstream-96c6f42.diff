+# -*- coding: utf-8 -*-
+"""issue #200：record_action_sequence 用 LIKE 子串认技能（误绑/通配），失败从不降信，程序重复追加。"""
+from lingshu.core.core import SpacetimeMemoryEngine as E
+
+
+def _by_name(e, name):
+    return [s for s in e.recall_skill("") if s["name"] == name]
+
+
+def test_hint_substring_does_not_bind_other_skill():
+    e = E(":memory:")
+    e.store_skill("删除备份", "清理过期备份", "rm -rf /backup/old")
+    e.record_action_sequence(["tar czf db.tgz /data", "scp db.tgz nas:/backup"], "ok", True,
+                             skill_hint="备份")
+    d = _by_name(e, "删除备份")[0]
+    assert d["procedure"] == "rm -rf /backup/old"
+    assert abs(d["confidence"] - 0.5) < 1e-9
+    b = _by_name(e, "备份")
+    assert len(b) == 1 and b[0]["procedure"] == "tar czf db.tgz /data > scp db.tgz nas:/backup"
+
+
+def test_like_wildcards_escaped():
+    e = E(":memory:")
+    e.store_skill("删除备份", "清理过期备份", "rm -rf /backup/old")
+    assert e.recall_skill("_", limit=1) == []
+    assert e.recall_skill("%", limit=1) == []
+    e.store_skill("a_b", "含下划线", "x")
+    assert [s["name"] for s in e.recall_skill("_")] == ["a_b"]
+
+
+def test_failures_lower_confidence():
+    e = E(":memory:")
+    for ok, n in ((False, 50), (True, 10)):
+        for _ in range(n):
+            e.record_action_sequence(["deploy"], "x", ok, skill_hint="部署")
+    assert _by_name(e, "部署")[0]["confidence"] < 0.5
+
+
+def test_success_still_raises_and_procedure_not_duplicated():
+    e = E(":memory:")
+    for _ in range(5):
+        e.record_action_sequence(["build", "test"], "ok", True, skill_hint="构建")
+    s = _by_name(e, "构建")
+    assert len(s) == 1
+    assert s[0]["confidence"] > 0.5
+    assert s[0]["procedure"] == "build > test"
