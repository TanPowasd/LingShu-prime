+++ b/bench/probes/issue-197.py
@@ -0,0 +1,20 @@
+# issue #197 · HexNet 参数向量读改写非原子：并发更新丢失（需原子 update_vec/apply_delta）
+import threading
+import numpy as np
+from lingshu.nn.hex_train import HexNet
+net = HexNet(seed=7)
+v0 = float(net.get_vec()[0])
+N, IT = 8, 50
+bar = threading.Barrier(N)
+def worker():
+    bar.wait(timeout=10)
+    for _ in range(IT):
+        if hasattr(net, "apply_delta"):
+            d = np.zeros(net.n_params()); d[0] = 1.0; net.apply_delta(d)
+        else:                                   # 修复前只有 get/set 两步式
+            v = net.get_vec(); v[0] += 1.0; net.set_vec(v)
+ts = [threading.Thread(target=worker) for _ in range(N)]
+[t.start() for t in ts]; [t.join() for t in ts]
+got = float(net.get_vec()[0]) - v0
+print("8 线程 × 50 次 +1 的累计增量 =", got, "（期望 400）；原子接口 =", hasattr(net, "apply_delta"))
+print("OK" if (hasattr(net, "apply_delta") and abs(got - 400) < 1e-9) else "BUG", {"delta": got})
