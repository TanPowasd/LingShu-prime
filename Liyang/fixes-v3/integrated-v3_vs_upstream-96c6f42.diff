+# NEW-nn-03 · stcnn.remember 的时间锚点由 trajectory_len 推出，与运动实际发生的帧无关
+# 运行：在仓库根目录 PYTHONPATH=. python _out/repro/NEW-nn-03.py
+import numpy as np
+from lingshu.nn.stcnn import *
+def late(n_idle=40, n_move=4, size=32):
+    fr = [np.zeros((size, size), np.float32) for _ in range(n_idle + n_move)]
+    for t in range(n_idle): fr[t][16:19, 3:6] = 1.0
+    for k in range(n_move): fr[n_idle + k][16:19, 3 + 2 * k:6 + 2 * k] = 1.0
+    return fr
+m = SpatiotemporalMemory()
+for fr, l, t0 in ((synth_ball_rolling(10, speed_px=2), '球', 0), (synth_static(6), '背景', 100), (synth_blinking(12, period=3), '灯', 150), (late(), '迟动球', 200)):
+    p, _ = extract_spatiotemporal_primitives(fr); e = m.remember(p, l, t_start=t0)
+    print(f"{l:<4} clip 帧 {t0}..{t0+len(fr)-1}  -> 事件 [{e['t_start']}, {e['t_end']}]  方向={p['direction']}")
+e = m.events
+bad = (e[0]["t_end"], e[1]["t_end"], (e[3]["t_start"], e[3]["t_end"])) != (9, 105, (240, 243))
+print("BUG" if bad else "OK")
