+# -*- coding: utf-8 -*-
+"""回归：工作态落表的 source/hop 如实反映种子与扩散跳数（新发现 core2-new-05）。"""
+import warnings
+
+warnings.filterwarnings("ignore")
+from lingshu.core.core import SpacetimeMemoryEngine, EdgeType  # noqa: E402
+from lingshu.core.activation import ActivationEngine  # noqa: E402
+
+
+def _engine(tmp_path):
+    db = str(tmp_path / "m.db")
+    e = SpacetimeMemoryEngine(db_path=db)
+    a = e.add_perception("灵枢认知图上下文")
+    b = e.add_perception("完全无关的天气记录")
+    c = e.add_perception("另一条毫不相干的流水账")
+    e.add_edge(a.id, b.id, EdgeType.CAUSAL)
+    e.add_edge(b.id, c.id, EdgeType.CAUSAL)
+    act = ActivationEngine(db, str(tmp_path / "audit.jsonl"))
+    return e, act, a, b, c
+
+
+def test_seed_and_hop_recorded(tmp_path):
+    e, act, a, b, c = _engine(tmp_path)
+    act.activate("认知图", workset="w", hops=2)
+    snap = {m["node_id"]: m for m in act.export_workset("w")["members"]}
+    assert snap[a.id]["source"] == "seed" and snap[a.id]["hop"] == 0
+    assert snap[b.id]["source"] == "propagate" and snap[b.id]["hop"] == 1
+    assert snap[c.id]["source"] == "propagate" and snap[c.id]["hop"] == 2
+
+
+def test_self_condition_label_kept(tmp_path):
+    e, act, a, b, c = _engine(tmp_path)
+    act.activate("认知图", workset="w", hops=1)
+    act.activate("流水账", workset="w", hops=0, self_condition=0.5)
+    snap = {m["node_id"]: m for m in act.export_workset("w")["members"]}
+    assert snap[c.id]["source"] == "seed"
+    assert snap[a.id]["source"] == "self_condition" and snap[a.id]["hop"] == 0
