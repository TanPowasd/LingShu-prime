+# -*- coding: utf-8 -*-
+"""回归（issue #254）：退化输入不抛 IndexError——校准集缺类给保守卡（永不 ACCEPT，标 missing）；
+train_infogap(max_steps=0) 返回 final_D=初始 D、steps=0；calibrate_hier_cards 缺类同步处理。"""
+import numpy as np
+import pytest
+
+pytest.importorskip("numpy")
+from lingshu.nn.hex_train import (HexNet, calibrate_class_cards, four_state_classify,  # noqa: E402
+                                  train_infogap)
+
+
+def _data():
+    rng = np.random.default_rng(0)
+    x = rng.normal(0, 1, (40, 6, 8, 1))
+    y = rng.integers(0, 9, 40)            # 只含 0..8，缺类 9
+    return x, y
+
+
+def test_missing_class_gets_conservative_card():
+    x, y = _data()
+    net = HexNet()
+    cards = calibrate_class_cards(net, x, y)
+    assert len(cards) == net.C
+    miss = [c for c in cards if c.get("missing")]
+    assert [c["class"] for c in miss] == [9]
+    logits, _ = net.forward(x)
+    for r in four_state_classify(net, logits, cards):
+        if r["class"] == 9:
+            assert r["verdict"] != "ACCEPT"
+
+
+def test_train_infogap_zero_steps():
+    x, y = _data()
+    r = train_infogap(HexNet(), x, y, max_steps=0)
+    assert r["steps"] == 0 and isinstance(r["final_D"], float)
+
+
+def test_hier_cards_missing_class():
+    from lingshu.nn.hex_hier import HexHierNet, calibrate_hier_cards, SHAPES, COLORS, OBJ
+    net = HexHierNet()
+    rng = np.random.default_rng(1)
+    n = 12
+    # 只给 circle / red，其余形状/颜色/物体缺失
+    lat = rng.normal(0, 1, (n, 16, 16, 3))
+    labels = {"shape": np.array(["circle"] * n), "color": np.array(["red"] * n),
+              "obj": np.array(["circle|red"] * n)}
+    cards = calibrate_hier_cards(net, lat, labels)     # 改前：空集分位 IndexError
+    assert sum(1 for c in cards["shape"] if c.get("missing")) == len(SHAPES) - 1
+    assert sum(1 for c in cards["color"] if c.get("missing")) == len(COLORS) - 1
+    assert sum(1 for c in cards["obj"] if c.get("missing")) == len(OBJ) - 1
