@@ -0,0 +1,198 @@
+# -*- coding: utf-8 -*-
+"""bench_perf · 记忆引擎 / nn 前向 的规模基准（只读测量，不改任何业务状态外的东西）
+
+用法（在仓根 / 你的 worktree 根下）：
+    PYTHONPATH=. python bench/bench_perf.py                       # 默认 N=200,1000,3000，:memory:
+    PYTHONPATH=. python bench/bench_perf.py --sizes 200 1000 --backend file --repeat 7
+    PYTHONPATH=. python bench/bench_perf.py --out _out/bench_after.json
+    PYTHONPATH=. python bench/bench_perf.py --profile search_content --sizes 3000   # cProfile 某个 op
+
+输出：JSON 列表 [{"op", "N", "backend", "median_ms", "repeat", ...}]（stdout 或 --out）。
+
+口径：
+- 每个 N 新建一个引擎，确定性灌库（random.Random(seed)）：
+  知识层 ≈ 0.85N（add_perception skip_dedup=True，每条 2 个 tag、1 个 ent:）、
+  情境层 ≈ 0.10N（add_context，受引擎 FIFO 上限 200 约束）、结构层 5 条、锚点层 3 条、
+  因果边 ≈ N 条（知识/情境节点间随机）。
+- 每个 op 先预热 1 次，再测 repeat 次取中位数（ms）。
+- add_perception 测「带 M5 去重的单次写入」（默认路径），每次内容不同 ⇒ 每次都会新增节点；
+  因此 add_perception 放在最后测，前面各 op 看到的库规模恰为 N。
+- decay_cycle 会改写置信度/重要度（factor=0.02 很小，repeat 次内节点数基本不变），读数为「单轮衰减」。
+- nn 前向：HexHierNet(stacked=True).l2_features + l3_logits，批大小 B∈{N/25}（8/40/120）、
+  16×16 晶格（与 tests/test_hex_hier 同管线）。热点即 hex_conv_batch——PR #97 已在改，本基准只测不改。
+"""
+from __future__ import annotations
+
+import argparse
+import cProfile
+import io
+import json
+import os
+import pstats
+import random
+import statistics
+import sys
+import tempfile
+import time
+
+WORDS = ["记忆", "视觉", "图像", "语义", "识别", "检测", "实验", "验证", "对话", "语音",
+         "因果", "时间", "空间", "实体", "场景", "结构", "知识", "推理", "预测", "反思",
+         "汽车", "红色", "圆形", "条纹", "左边", "右边", "上方", "下方", "移动", "静止",
+         "灵枢", "协议", "引擎", "节点", "边", "层", "衰减", "巩固", "检索", "召回"]
+
+
+def _sentence(rng: random.Random, k: int = 8) -> str:
+    return "".join(rng.choice(WORDS) for _ in range(k)) + f"#{rng.randrange(10**6)}"
+
+
+def build_engine(n: int, backend: str = "memory", seed: int = 7):
+    from lingshu.core.core import SpacetimeMemoryEngine, EdgeType
+    tmpdir = None
+    if backend == "file":
+        tmpdir = tempfile.mkdtemp(prefix="bench_perf_")
+        db = os.path.join(tmpdir, "bench.db")
+    else:
+        db = ":memory:"
+    eng = SpacetimeMemoryEngine(db_path=db)
+    rng = random.Random(seed)
+    ids = []
+    n_ctx = max(1, n // 10)
+    n_know = max(1, n - n_ctx - 8)
+    for i in range(n_know):
+        node = eng.add_perception(_sentence(rng), importance=round(rng.random(), 3),
+                                  tags=[f"topic:{rng.randrange(20)}", rng.choice(WORDS)],
+                                  entities=[f"car_{rng.randrange(50)}"], skip_dedup=True)
+        ids.append(node.id)
+    for i in range(n_ctx):
+        ids.append(eng.add_context(_sentence(rng), importance=0.4 + 0.5 * rng.random()).id)
+    for i in range(5):
+        eng.add_structure_node(f"结构规则{i}：" + _sentence(rng))
+    for i in range(3):
+        eng.set_anchor(f"锚点{i}：" + _sentence(rng))
+    live = [i for i in ids if eng.store.get_node(i) is not None]
+    for i in range(n):
+        a, b = rng.sample(live, 2)
+        eng.add_edge(a, b, EdgeType.CAUSAL, confidence=0.3 + 0.6 * rng.random())
+    return eng, tmpdir, rng
+
+
+def _time(fn, repeat: int) -> list:
+    fn()  # warmup
+    out = []
+    for _ in range(repeat):
+        t0 = time.perf_counter()
+        fn()
+        out.append((time.perf_counter() - t0) * 1000.0)
+    return out
+
+
+def core_ops(eng, rng):
+    q_rng = random.Random(11)
+    queries = [q_rng.choice(WORDS) + q_rng.choice(WORDS) for _ in range(64)]
+    qi = {"i": 0}
+
+    def nextq():
+        qi["i"] += 1
+        return queries[qi["i"] % len(queries)]
+
+    w_rng = random.Random(13)
+    return [
+        ("search_content", lambda: eng.search_content(nextq())),
+        ("recall", lambda: eng.recall(nextq())),
+        ("get_nodes_by_tag", lambda: eng.store.get_nodes_by_tag(f"topic:{w_rng.randrange(20)}")),
+        ("get_entity_tag", lambda: eng.store.get_nodes_by_tag(f"ent:car_{w_rng.randrange(50)}")),
+        ("self_check", lambda: eng.self_check()),
+        ("decay_cycle", lambda: eng.decay_cycle(factor=0.02)),
+        ("add_perception", lambda: eng.add_perception(_sentence(w_rng), importance=0.5,
+                                                      tags=["bench"])),
+    ]
+
+
+def nn_ops(n: int):
+    try:
+        import numpy as np
+        from lingshu.nn.hex_hier import HexHierNet, make_scene_dataset
+        from lingshu.nn.hex_cnn import image_to_grid
+        from lingshu.nn.hex_train import normalize_lattices
+    except Exception as e:  # numpy 未装：nn 腿跳过
+        return [], f"nn skipped: {e!r}"
+    b = max(8, n // 25)
+    xs, _ = make_scene_dataset(b, 48, 7)
+    lat = normalize_lattices(np.stack([image_to_grid(x, cells_across=16)[0] / 255.0 for x in xs]))
+    net = HexHierNet(stacked=True)
+
+    def fwd():
+        deep, col = net.l2_features(lat)
+        return net.l3_logits(deep, col)
+    return [("nn_forward", fwd)], {"batch": b}
+
+
+def run(sizes, backend, repeat, ops_filter=None, with_nn=True):
+    rows = []
+    for n in sizes:
+        t0 = time.perf_counter()
+        eng, tmpdir, rng = build_engine(n, backend)
+        build_ms = (time.perf_counter() - t0) * 1000.0
+        stats = eng.get_stats()
+        rows.append({"op": "build", "N": n, "backend": backend, "median_ms": round(build_ms, 3),
+                     "repeat": 1, "stats": stats})
+        for op, fn in core_ops(eng, rng):
+            if ops_filter and op not in ops_filter:
+                continue
+            ts = _time(fn, repeat)
+            rows.append({"op": op, "N": n, "backend": backend,
+                         "median_ms": round(statistics.median(ts), 3),
+                         "min_ms": round(min(ts), 3), "repeat": repeat})
+        eng.close()
+        if with_nn and (not ops_filter or "nn_forward" in ops_filter):
+            nn, meta = nn_ops(n)
+            for op, fn in nn:
+                ts = _time(fn, repeat)
+                rows.append({"op": op, "N": n, "backend": "numpy",
+                             "median_ms": round(statistics.median(ts), 3),
+                             "min_ms": round(min(ts), 3), "repeat": repeat, **meta})
+    return rows
+
+
+def profile(op, n, backend, repeat, top=25):
+    eng, tmpdir, rng = build_engine(n, backend)
+    fns = dict(core_ops(eng, rng))
+    if op == "nn_forward":
+        fns.update(dict(nn_ops(n)[0]))
+    fn = fns[op]
+    fn()
+    pr = cProfile.Profile()
+    pr.enable()
+    for _ in range(repeat):
+        fn()
+    pr.disable()
+    s = io.StringIO()
+    pstats.Stats(pr, stream=s).sort_stats("cumulative").print_stats(top)
+    return s.getvalue()
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--sizes", type=int, nargs="+", default=[200, 1000, 3000])
+    ap.add_argument("--backend", choices=["memory", "file"], default="memory")
+    ap.add_argument("--repeat", type=int, default=7)
+    ap.add_argument("--ops", nargs="*", default=None)
+    ap.add_argument("--no-nn", action="store_true")
+    ap.add_argument("--profile", default=None, help="对单个 op 跑 cProfile（取 --sizes 第一个）")
+    ap.add_argument("--out", default=None)
+    a = ap.parse_args(argv)
+    if a.profile:
+        print(profile(a.profile, a.sizes[0], a.backend, a.repeat))
+        return 0
+    rows = run(a.sizes, a.backend, a.repeat, a.ops, not a.no_nn)
+    txt = json.dumps(rows, ensure_ascii=False, indent=1)
+    if a.out:
+        os.makedirs(os.path.dirname(a.out) or ".", exist_ok=True)
+        with open(a.out, "w", encoding="utf-8") as f:
+            f.write(txt)
+    print(txt)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
