+# -*- coding: utf-8 -*-
+"""回归：时空原语不得随帧的亮度缩放/位深变化（frame_diff 须作用在归一化体素上）。issue NEW-nn-01。"""
+import numpy as np
+import pytest
+
+from lingshu.nn.stcnn import extract_spatiotemporal_primitives, synth_ball_rolling, synth_blinking
+
+KEYS = ("direction", "speed", "period", "moving", "trajectory_len")
+
+
+def _prims(frames):
+    p, _ = extract_spatiotemporal_primitives(frames)
+    return {k: p[k] for k in KEYS}
+
+
+@pytest.mark.parametrize("scale", [0.05, 0.5, 255.0])
+def test_ball_primitives_scale_invariant(scale):
+    f = synth_ball_rolling(10, speed_px=2)
+    assert _prims([x * scale for x in f]) == _prims(f)
+
+
+@pytest.mark.parametrize("scale", [0.05, 255.0])
+def test_blink_primitives_scale_invariant(scale):
+    f = synth_blinking(12, period=3)
+    assert _prims([x * scale for x in f]) == _prims(f)
+
+
+def test_8bit_frames_with_sensor_noise():
+    rng = np.random.default_rng(0)
+    f = [x + rng.random(x.shape) * 0.03 for x in synth_ball_rolling(10, speed_px=2)]
+    p01, p255 = _prims(f), _prims([x * 255 for x in f])
+    assert p01["direction"] == p255["direction"] == "向右"
+    assert p01["speed"] == p255["speed"]
