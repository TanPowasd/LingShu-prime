@@ -0,0 +1,37 @@
+# -*- coding: utf-8 -*-
+"""回归（issue #210）：forget_advisor 三处错误。
+① importance=0.0 判为低价值（不再被 `or 0.5` 吞掉）；② 归档只降不升；③ 归档节点仍走衰减、
+有限轮内被删除。①② 由 eb51520（core-py-01）修复，③ 由同提交的 decay_cycle 去预筛覆盖；
+本提交删掉 forget_advisor 中 `... if False else None` 死代码与未用变量。"""
+import inspect
+import warnings
+
+warnings.filterwarnings("ignore")
+from lingshu.core.core import SpacetimeMemoryEngine  # noqa: E402
+
+
+def test_zero_importance_archived_and_no_raise():
+    e = SpacetimeMemoryEngine(":memory:")
+    lo = e.add_context("低重要度情境 0.05", importance=0.05)
+    zero = e.add_context("零重要度情境 0.0", importance=0.0)
+    hi = e.add_context("待归档情境 0.50", importance=0.50)
+    r = e.forget_advisor(stale_days=30, low_value=0.2)
+    assert r["archived"] == 2 and r["kept"] == 1
+    n_lo, n_zero = e.store.get_node(lo.id), e.store.get_node(zero.id)
+    assert "archived" in n_zero.tags and n_zero.importance == 0.0
+    assert "archived" in n_lo.tags and n_lo.importance <= 0.05 + 1e-9
+    assert e.store.get_node(hi.id).importance == 0.5
+
+
+def test_archived_nodes_eventually_forgotten():
+    e = SpacetimeMemoryEngine(":memory:")
+    ns = [e.add_context(f"情境 {i}", importance=imp) for i, imp in enumerate((0.0, 0.05, 0.1, 0.12))]
+    e.forget_advisor()
+    for _ in range(1000):
+        e.decay_cycle()
+    assert all(e.store.get_node(n.id) is None for n in ns)
+
+
+def test_no_dead_code_in_forget_advisor():
+    src = inspect.getsource(SpacetimeMemoryEngine.forget_advisor)
+    assert "if False else" not in src
