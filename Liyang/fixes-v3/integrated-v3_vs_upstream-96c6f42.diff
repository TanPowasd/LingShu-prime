+# -*- coding: utf-8 -*-
+"""回归：ActivationEngine 可挂在引擎 :memory: 存储上；默认路径父目录缺失时可构造（issue 草稿 core-rest-08）。"""
+import os
+import warnings
+
+import pytest
+
+warnings.filterwarnings("ignore")
+from lingshu.core.core import SpacetimeMemoryEngine  # noqa: E402
+from lingshu.core.activation import ActivationEngine  # noqa: E402
+
+
+def test_activation_reads_engine_memory_store(tmp_path):
+    e = SpacetimeMemoryEngine()
+    n = e.add_perception("灵枢认知图上下文")
+    a = ActivationEngine(store=e.store, audit_path=str(tmp_path / "a.jsonl"))
+    r = a.activate("认知图", workset="w")
+    assert r["status"] == "ok"
+    assert n.id in [m[0] for m in r["top"]]
+    # 工作态写入与读取同一个库；借用的连接不被关闭
+    assert a.carry_vector("w").get(n.id) == pytest.approx(1.0)
+    assert e.store.get_node(n.id) is not None
+
+
+def test_memory_path_without_shared_connection_fails_loudly(tmp_path):
+    with pytest.raises(ValueError):
+        ActivationEngine(":memory:", str(tmp_path / "a.jsonl"))
+
+
+def test_missing_parent_dir_is_created(tmp_path):
+    db = tmp_path / "nested" / "data" / "aeis_memory.db"
+    a = ActivationEngine(str(db), str(tmp_path / "a.jsonl"))
+    assert os.path.isfile(db)
+    assert a.carry_vector("default") == {}
