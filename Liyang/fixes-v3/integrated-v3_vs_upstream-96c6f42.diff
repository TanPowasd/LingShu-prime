+# -*- coding: utf-8 -*-
+"""回归：core/verdict.assess 对 UNASSERTED 与零面积部件的判定（issue 草稿 core-rest-05）。"""
+import pytest
+
+from lingshu.core.condition_normalize import canonical_condition, img0_domains, UNASSERTED
+from lingshu.core.verdict import assess
+
+PARTS = ["head", "torso", "upper_arm_L", "hand_L", "upper_leg_L", "lower_leg_R", "foot_L"]
+
+
+@pytest.mark.parametrize("part", PARTS)
+def test_canonicalised_domains_give_same_verdict_as_raw(part):
+    raw = img0_domains()
+    canon = canonical_condition(raw)
+    assert canon["occlusion"] == UNASSERTED
+    a = assess({"type": part}, raw, part_fg_px=9000, part_area=10000)
+    b = assess({"type": part}, canon, part_fg_px=9000, part_area=10000)
+    assert a["verdict"] == b["verdict"]
+
+
+def test_unasserted_occlusion_equals_missing_key():
+    assert assess({"type": "head"}, {"occlusion": UNASSERTED}, 9000, 10000)["verdict"] == "ACCEPT"
+    # 显式遮挡仍然 DEFER（不放宽真遮挡）
+    assert assess({"type": "head"}, {"occlusion": "部分遮挡"}, 9000, 10000)["verdict"] == "DEFER"
+
+
+@pytest.mark.parametrize("area", [0, -5])
+def test_zero_area_part_is_not_accepted(area):
+    r = assess({"type": "head"}, {}, part_fg_px=5, part_area=area)
+    assert r["verdict"] == "REJECT"
