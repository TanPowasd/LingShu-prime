@@ -0,0 +1,66 @@
+# -*- coding: utf-8 -*-
+"""issue #179：what_happened_at / session_summary 必须按时间取数，而非「importance 前 500 条」。"""
+import warnings
+
+from lingshu.core.core import SpacetimeMemoryEngine as E
+
+warnings.filterwarnings("ignore")
+
+
+def test_low_importance_event_visible_beyond_500():
+    e = E(":memory:")
+    try:
+        for i in range(500):
+            e.add_perception(f"历史记录第{i}条：例行巡检正常编号{i}", importance=0.6, skip_dedup=True)
+        ev = e.add_perception("凌晨服务器被入侵，攻击者删除了审计日志", importance=0.3, skip_dedup=True)
+        hits = e.what_happened_at(ev.temporal_coordinate, tolerance=5)
+        assert any(n.id == ev.id for n, _ in hits)
+        assert all(d <= 5 for _, d in hits)
+        last = e.session_summary(window_seconds=3600)[-1]
+        assert last["count"] == 501
+    finally:
+        e.close()
+
+
+def test_oldest_same_importance_visible():
+    e = E(":memory:")
+    try:
+        first = e.add_perception("第一条：周一上午签署了合同", skip_dedup=True)
+        for i in range(500):
+            e.add_perception(f"之后的日常记录{i}：今天一切正常{i}", skip_dedup=True)
+        hits = e.what_happened_at(first.temporal_coordinate, tolerance=0.001)
+        assert any(n.id == first.id for n, _ in hits)
+    finally:
+        e.close()
+
+
+def test_what_happened_at_sorted_and_limited():
+    e = E(":memory:")
+    try:
+        ns = [e.add_perception(f"事件{i}号记录", skip_dedup=True) for i in range(10)]
+        t = ns[5].temporal_coordinate
+        hits = e.what_happened_at(t, tolerance=60, limit=3)
+        assert len(hits) == 3
+        assert hits[0][0].id == ns[5].id
+        assert [d for _, d in hits] == sorted(d for _, d in hits)
+    finally:
+        e.close()
+
+
+def test_session_summary_windows_split_and_limit():
+    e = E(":memory:")
+    try:
+        ids = [e.add_perception(f"会话记录{i}", skip_dedup=True).id for i in range(6)]
+        # 人工拉开时间：三组，每组两条，相隔 2 小时
+        base = 1_000_000.0
+        for k, nid in enumerate(ids):
+            e.store.conn.execute("UPDATE nodes SET temporal_coordinate=? WHERE id=?",
+                                 (base + (k // 2) * 7200 + (k % 2) * 10, nid))
+        e.store.conn.commit()
+        s = e.session_summary(window_seconds=3600)
+        assert [w["count"] for w in s] == [2, 2, 2]
+        assert [w["window_start"] for w in s] == sorted(w["window_start"] for w in s)
+        assert len(e.session_summary(window_seconds=3600, limit=2)) == 2
+        assert e.session_summary(window_seconds=3600, limit=2)[-1]["window_start"] == base + 2 * 7200
+    finally:
+        e.close()
