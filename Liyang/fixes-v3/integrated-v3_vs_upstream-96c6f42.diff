+"""issue #209 复现：requires-python 下界装不上 extras 的 numpy 下界（3.10 vs numpy>=2.3.5），
+且 gate 矩阵不覆盖「最低 Python + 依赖下界」。
+用法：cd <worktree> && PYTHONPATH=. python bench/probes/issue209.py"""
+import re
+
+NUMPY_MIN_PY = {(2, 2): (3, 10), (2, 3): (3, 11), (2, 4): (3, 11), (2, 5): (3, 12)}
+pp = open("pyproject.toml", encoding="utf-8").read()
+fl = tuple(map(int, re.search(r'requires-python\s*=\s*">=\s*(\d+)\.(\d+)"', pp).groups()))
+npf = max(tuple(map(int, m)) for m in re.findall(r'"numpy>=(\d+)\.(\d+)', pp))
+need = NUMPY_MIN_PY[npf]
+gate = open(".github/workflows/gate.yml", encoding="utf-8").read()
+cov = re.search(r'python-version:\s*"%d\.%d"' % fl, gate) is not None and "numpy==2.3.5" in gate
+print(f"requires-python>={fl}, numpy 下界 {npf} 需 Python>={need}; gate 覆盖下界档: {cov}")
+print("OK" if fl >= need and cov else "BUG")
