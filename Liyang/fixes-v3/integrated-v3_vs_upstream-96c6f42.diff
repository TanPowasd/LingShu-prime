@@ -0,0 +1,24 @@
+"""issue #220：cognitive_baseline 声明「跨时间稳定 + 预测长期命中率」两条判据，baseline_ok 只判后者。"""
+import pytest
+from lingshu.world.anchored_verification import AnchoredVerification
+
+
+@pytest.mark.parametrize("rounds", [0, 2, -5])
+def test_unstable_rounds_fail_baseline(rounds):
+    r = AnchoredVerification().cognitive_baseline(hit_rate=0.95, stable_rounds=rounds)
+    assert r["baseline_ok"] is False, r
+    assert any("基底层未建立" in n for n in r["notes"])
+
+
+def test_default_call_not_ok():
