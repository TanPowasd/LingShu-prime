+"""回归：SimulationLoop.load_priors 参数优先级与 limit 上限（issue 草稿 world-04）。
+
+修复前：① 单文件 25 个实体、limit=20 → seeded=25；② 显式 mdcg_root 被环境变量 MDCG_ROOT 覆盖。
+"""
+import os
+
+from lingshu.world.wm_simloop import SimulationLoop
+
+
+def _mk_root(tmp_path, name, n, cat):
+    ctx = tmp_path / name / "contextual"
+    ctx.mkdir(parents=True)
+    body = "\n".join(f"- entity: {cat} id=e{i} pos=({i + 1}.0, 1.5, 3.0)" for i in range(n))
+    (ctx / "a.md").write_text('---\ntags: ["wm_simloop"]\n---\n' + body + "\n", encoding="utf-8")
+    return str(tmp_path / name)
+
+
+def test_limit_caps_entities_within_single_file(tmp_path, monkeypatch):
+    monkeypatch.delenv("MDCG_ROOT", raising=False)
+    root = _mk_root(tmp_path, "big", 25, "wolf")
+    sl = SimulationLoop()
+    n0 = len(sl.scene.entities)
+    r = sl.load_priors(root, limit=20)
+    assert r["seeded"] == 20
+    assert len(sl.scene.entities) - n0 == 20
+
+
+def test_explicit_root_wins_over_env(tmp_path, monkeypatch):
+    mine = _mk_root(tmp_path, "mine", 3, "rabbit")
+    other = _mk_root(tmp_path, "other", 5, "wolf")
+    monkeypatch.setenv("MDCG_ROOT", other)
+    r = SimulationLoop().load_priors(mine, limit=20)
+    assert r["mdcg_root"] == mine
+    assert {e["category"] for e in r["entities"]} == {"rabbit"}
+
+
+def test_env_used_when_no_explicit_root(tmp_path, monkeypatch):
+    other = _mk_root(tmp_path, "other", 5, "wolf")
+    monkeypatch.setenv("MDCG_ROOT", other)
+    r = SimulationLoop().load_priors("", limit=20)
+    assert r["mdcg_root"] == other and r["seeded"] == 5
