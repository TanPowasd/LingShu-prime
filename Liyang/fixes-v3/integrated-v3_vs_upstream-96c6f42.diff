+import os, tempfile
+from lingshu.world.wm_simloop import SimulationLoop
+def mk_root(n_entities, cat):
+    root = tempfile.mkdtemp(); ctx = os.path.join(root, "contextual"); os.makedirs(ctx)
+    body = "\n".join(f"- entity: {cat} id=e{i} pos=({i+1}.0, 1.5, 3.0)" for i in range(n_entities))
+    open(os.path.join(ctx, "a.md"), "w", encoding="utf-8").write(
+        '---\ntags: ["wm_simloop"]\n---\n' + body + "\n")
+    return root
+mine = mk_root(3, "rabbit")      # 调用方显式指定的认知图
+other = mk_root(25, "wolf")      # 进程环境里残留的另一个认知图
+# ① limit 只在文件之间检查：单文件 25 个实体，limit=20
+os.environ.pop("MDCG_ROOT", None)
+sl = SimulationLoop()
+r = sl.load_priors(other, limit=20)
+print("① load_priors(limit=20) → seeded =", r["seeded"], "| 场景实体数 =", len(sl.scene.entities))
+# ② 显式参数被环境变量覆盖
+os.environ["MDCG_ROOT"] = other
+sl = SimulationLoop()
+r = sl.load_priors(mine, limit=20)
+print("② 显式 mdcg_root=mine，MDCG_ROOT=other → 实际读取", "other" if r["mdcg_root"] == other else "mine",
+      "| seeded =", r["seeded"], "| 类别 =", sorted({e["category"] for e in r["entities"]}))
+os.environ.pop("MDCG_ROOT", None)
+r1 = SimulationLoop().load_priors(other, limit=20)
+os.environ["MDCG_ROOT"] = other
+r2 = SimulationLoop().load_priors(mine, limit=20)
+os.environ.pop("MDCG_ROOT", None)
+bad = r1["seeded"] > 20 or r2["mdcg_root"] != mine
+print("BUG" if bad else "OK", f"(seeded={r1['seeded']}≤20? 显式参数生效={r2['mdcg_root'] == mine})")
