@@ -0,0 +1,60 @@
+# -*- coding: utf-8 -*-
+"""回归（issue #249 / 我方草稿 world-n5）：seek 步长按剩余距离封顶，到达后停驻不振荡；
+三个影子模型（world_model / world_learner / spacetime_consistency）与物理世界同式。"""
+import math
+
+from lingshu.world.scene_simulator import SceneSimulator
+from lingshu.world.spacetime_consistency import SpacetimeConsistency
+from lingshu.world.world_learner import WorldLearner
+from lingshu.world.world_model import UnifiedWorldModel
+
+
+def _chase(sim, start=(5.3, 1.5, 10)):
+    t = sim.add_entity("rabbit", behavior="seek", pos=(10, 1.5, 10), speed=0.0)
+    a = sim.add_entity("wolf", behavior="seek", goal=t, pos=start, speed=0.8)
+    return t, a
+
+
+def test_seek_arrives_and_stays():
+    s = SceneSimulator(size=24)
+    t, a = _chase(s)
+    d = []
+    for _ in range(14):
+        s.step(1)
+        p, q = s.entities[a].pos, s.entities[t].pos
+        d.append(math.hypot(p[0] - q[0], p[2] - q[2]))
+    assert all(d[i + 1] <= d[i] + 1e-9 for i in range(len(d) - 1)), d   # 距离单调不增
+    assert d[-6:] == [0.0] * 6, d                                          # 到达后停驻
+
+
+def test_shadow_move_formula_matches_simulator():
+    s = SceneSimulator(size=24)
+    t, a = _chase(s, start=(9.5, 1.5, 10))   # 剩余 0.5 < speed 0.8
+    e = s.entities[a]
+    d = s._decide(e)
+    dist = math.hypot(10 - e.pos[0], 10 - e.pos[2])
+    s.step(1)
+    world = s.entities[a].pos
+    for m in (UnifiedWorldModel(), WorldLearner()):
+        assert m._apply_move((9.5, 1.5, 10.0), 0.8, d, max_step=dist) == world
+    sc = SpacetimeConsistency()
+    st, sa = _static_target_chase(sc, (9.5, 1.5, 10))
+    pred, mode = sc._predict_next()[sa][:2]
+    assert mode == "exact" and tuple(pred) == world
+
+
+def _static_target_chase(sc, start):
+    # 目标走单点 follow 路径 ⇒ 确定性静止，追逐者走 exact 分支（不被降级为 bounded）
+    sc.scene.add_path("p0", [(10, 1.5, 10)])
+    t = sc.scene.add_entity("rabbit", behavior="follow", goal="p0", pos=(10, 1.5, 10), speed=0.0)
+    a = sc.scene.add_entity("wolf", behavior="seek", goal=t, pos=start, speed=0.8)
+    return t, a
+
+
+def test_spacetime_consistency_exact_hit_through_arrival():
+    sc = SpacetimeConsistency()
+    t, a = _static_target_chase(sc, (5.3, 1.5, 10.2))
+    assert sc._predict_next()[a][1] == "exact"
+    assert sc.run(20)["rolling_hit_rate"] == 1.0
+    p = sc.scene.entities[a].pos
+    assert (p[0], p[2]) == (10.0, 10.0)
