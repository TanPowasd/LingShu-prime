+# -*- coding: utf-8 -*-
+"""issue #181（中文标签 \\uXXXX 存储不可检索）与 #183（标签 LIKE 子串误配、% _ 通配注入）。"""
+import json
+import warnings
+
+from lingshu.core.core import SpacetimeMemoryEngine
+
+warnings.filterwarnings("ignore")
+
+
+def _eng():
+    return SpacetimeMemoryEngine()
+
+
+def test_cjk_tags_stored_raw_and_found():
+    e = _eng()
+    try:
+        n = e.add_context("红色的东西", tags=["苹果", "ent:猫"])
+        raw = e.store.conn.execute("select tags from nodes where id=?", (n.id,)).fetchone()[0]
+        assert "苹果" in raw and "\\u" not in raw
+        assert len(e.store.get_nodes_by_tag("苹果")) == 1
+        assert len(e.store.get_nodes_by_tag("ent:猫")) == 1
+        e.store.tag_node(n.id, "水果")
+        assert len(e.store.get_nodes_by_tag("水果")) == 1
+    finally:
+        e.close()
+
+
+def test_legacy_escaped_tags_still_found():
+    """老库里 ensure_ascii 写入的 \\uXXXX 行，json_each 精确匹配同样能命中。"""
+    e = _eng()
+    try:
+        n = e.add_context("老数据", tags=["占位"])
+        e.store.conn.execute("update nodes set tags=? where id=?", (json.dumps(["旧标签", "context"]), n.id))
+        e.store.conn.commit()
+        assert [x.id for x in e.store.get_nodes_by_tag("旧标签")] == [n.id]
+    finally:
+        e.close()
+
+
+def test_tag_prefix_does_not_match_longer_tag():
+    e = _eng()
+    try:
+        for t in ["ent:car_1", "ent:car_12", "ent:carX1"]:
+            e.add_context("frame of " + t, tags=[t])
+        assert [n.content for n in e.store.get_nodes_by_tag("ent:car_1")] == ["frame of ent:car_1"]
+        assert [n.content for n in e.store.get_nodes_by_tag("ent:car_12")] == ["frame of ent:car_12"]
+        assert e.store.get_nodes_by_tag("ent:car") == []
+        assert e.store.get_nodes_by_tag("%") == []
+    finally:
+        e.close()
+
+
+def test_search_content_wildcards_not_injected():
+    e = _eng()
+    try:
+        for i in range(20):
+            e.add_context(f"苹果是红色的第{i}条记录")
+        assert len(e.search_content("%")) == 0
+        assert len(e.search_content("_")) == 0
+        lit = e.add_context("折扣 50% 的活动")
+        assert any(n.id == lit.id for n, _ in e.search_content("50%"))
+        assert any("苹果" in n.content for n, _ in e.search_content("苹果"))
+    finally:
+        e.close()
