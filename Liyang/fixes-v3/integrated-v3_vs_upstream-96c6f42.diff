+# -*- coding: utf-8 -*-
+"""回归（issue #226）：同帧无 eid 观测与节点一一匹配（按本帧起始位置、距离升序贪心），不再并到同一节点。"""
+from lingshu.world.world_model import UnifiedWorldModel
+
+
+def test_two_same_category_observations_map_to_two_nodes():
+    wm = UnifiedWorldModel(size=24)
+    wm.perceive([{"category": "rabbit", "pos": (5.0, 1.5, 5.0)},
+                 {"category": "rabbit", "pos": (8.0, 1.5, 5.0)}])
+    ids = {n.pos[0]: k for k, n in wm.nodes.items()}
+    a, b = ids[5.0], ids[8.0]
+    r = wm.perceive([{"category": "rabbit", "pos": (6.0, 1.5, 5.0)},
+                     {"category": "rabbit", "pos": (6.5, 1.5, 5.0)}])
+    assert r["matched"] == 2 and r["new"] == 0
+    assert wm.nodes[a].pos[0] == 6.0 and wm.nodes[b].pos[0] == 6.5
+    assert set(wm._obs_snapshot) == {a, b}
+
+
+def test_unmatched_gets_new_node_and_explicit_eid_claims():
+    wm = UnifiedWorldModel(size=24)
+    wm.perceive([{"category": "rabbit", "pos": (5.0, 1.5, 5.0)}])
+    (a,) = wm.nodes
+    r = wm.perceive([{"category": "rabbit", "pos": (5.5, 1.5, 5.0)},
+                     {"category": "rabbit", "pos": (5.2, 1.5, 5.0), "eid": a}])
+    assert r["new"] == 1 and len(wm.nodes) == 2 and wm.nodes[a].pos[0] == 5.2
