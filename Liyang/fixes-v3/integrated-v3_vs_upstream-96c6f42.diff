diff --git a/tests/test_issue209_python_floor.py b/tests/test_issue209_python_floor.py
new file mode 100644
index 0000000..6de630a
--- /dev/null
+++ b/tests/test_issue209_python_floor.py
@@ -0,0 +1,53 @@
+# -*- coding: utf-8 -*-
+"""issue #209 回归：requires-python 下界必须能装上每个 extra 的依赖下界，且该下界档进 CI。
+
+改前：requires-python=">=3.10"，但 extras 下界 numpy>=2.3.5 需 Python≥3.11（numpy 2.3.x/2.4.x
+wheel 仅 cp311+，3.10 能拿到的最高是 2.2.6）⇒ 3.10 上 .[world]/.[nn]/.[gen]/.[full] 必然解析失败；
+gate 矩阵只有 3.12/3.13，下界（Python 最低版 + numpy 2.3.5 / Pillow 12.2.0）无一档覆盖。
+改后：requires-python=">=3.11"；gate 增加「3.11 + 依赖下界」档；README 已测矩阵同步。
+运行：python -X utf8 -m pytest tests/test_issue209_python_floor.py -q
+"""
+import os
+import re
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+# numpy 次版本 → 其 wheel 要求的最低 Python（numpy 发布元数据 Requires-Python）
+NUMPY_MIN_PYTHON = {(2, 2): (3, 10), (2, 3): (3, 11), (2, 4): (3, 11), (2, 5): (3, 12)}
+
+
+def _read(*p):
+    return open(os.path.join(REPO, *p), encoding="utf-8").read()
+
+
+def _floor_python():
+    m = re.search(r'^requires-python\s*=\s*">=\s*(\d+)\.(\d+)"', _read("pyproject.toml"), re.M)
+    assert m, "pyproject.toml 无 requires-python 下界"
+    return int(m.group(1)), int(m.group(2))
+
+
+def _numpy_floor():
+    lows = re.findall(r'"numpy>=(\d+)\.(\d+)(?:\.(\d+))?', _read("pyproject.toml"))
+    assert lows, "extras 无 numpy 下界"
+    return max((int(a), int(b), int(c or 0)) for a, b, c in lows)
+
+
+def test_requires_python_floor_can_install_numpy_floor():
+    np_floor = _numpy_floor()
+    need = NUMPY_MIN_PYTHON[np_floor[:2]]
+    assert _floor_python() >= need, (
+        f"requires-python 下界 {_floor_python()} 装不上 numpy>={np_floor}（需 Python≥{need}）")
+
+
+def test_gate_matrix_covers_floor_python_with_lowest_deps():
+    gate = _read(".github", "workflows", "gate.yml")
+    py = "%d.%d" % _floor_python()
+    assert re.search(r'python-version:\s*"%s"' % re.escape(py), gate), f"gate 矩阵缺 {py} 档"
+    np = "%d.%d.%d" % _numpy_floor()
+    assert f"numpy=={np}" in gate, "gate 未按依赖下界安装 numpy"
+    assert "Pillow==12.2.0" in gate, "gate 未按依赖下界安装 Pillow"
+
+
+def test_readme_matrix_mentions_floor_python():
+    py = "%d.%d" % _floor_python()
+    readme = _read("README.md")
+    assert f"Python {py}" in readme, f"README 已测矩阵未列 Python {py}"
diff --git a/tests/test_issue210_forget_advisor.py b/tests/test_issue210_forget_advisor.py
