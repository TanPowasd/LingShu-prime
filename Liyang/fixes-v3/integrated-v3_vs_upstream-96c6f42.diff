+# nn-05 · hex_recon：reconstruct 按扫描序逐个铺 bbox，背景区域若排在物体之后会把物体整块盖掉
+# 运行：在仓库根目录 PYTHONPATH=. python nn-05.py
+import numpy as np
+from lingshu.nn.hex_recon import extract_regions, regions_to_connections, reconstruct, pixel_accuracy
+
+def run(y0, x0, wd=5, tag=""):
+    img = np.full((32, 32, 3), 200, np.uint8)          # 浅灰背景
+    img[y0:y0 + wd, x0:x0 + wd] = (200, 40, 40)         # 奇数边长纯色红方块（避开 #152 的偶数边长偏移）
+    regs, _ = extract_regions(img)
+    rec = reconstruct(regions_to_connections(regs, img.shape))
+    obj = rec[y0:y0 + wd, x0:x0 + wd].astype(int)
+    kept = int((np.abs(obj - [200, 40, 40]).sum(-1) <= 8).sum())
+    print(f"{tag:<6} 方块@({y0},{x0}) 区域顺序={[(r['bbox'], r['color']) for r in regs]} "
+          f"acc={pixel_accuracy(img, rec):.4f} 方块像素复原 {kept}/{wd * wd}")
+
+run(10, 10, tag="内部")
+run(0, 10, tag="顶边")
+run(10, 0, tag="左边")
+run(0, 0, tag="左上角")
+
+# 同一场景、区域顺序人工调成「先背景后物体」即可 100%：证明丢失只来自绘制顺序
+img = np.full((32, 32, 3), 200, np.uint8); img[0:5, 0:5] = (200, 40, 40)
+regs, _ = extract_regions(img)
+regs_sorted = sorted(regs, key=lambda r: -r["pixels"])   # 大区域先画
+print("按面积降序重排后 acc =", pixel_accuracy(img, reconstruct(regions_to_connections(regs_sorted, img.shape))))
+
+img = np.full((32, 32, 3), 200, np.uint8); img[0:5, 0:5] = (200, 40, 40)
+regs, _ = extract_regions(img)
+acc = pixel_accuracy(img, reconstruct(regions_to_connections(regs, img.shape)))
+print("BUG" if acc < 1.0 else "OK", "左上角方块 acc =", acc)
