+# -*- coding: utf-8 -*-
+"""回归（issue #241）：被测脚本经父进程 environ 写 $GITHUB_ENV/$GITHUB_PATH 的内容在执行核结束前被回滚；
+脱离会话的残留孙进程在报告落盘前被回收，不能事后改写报告；执行核把报告 sha256 写到 $GITHUB_OUTPUT。"""
+import hashlib
+import os
+import pathlib
+import subprocess
+import sys
+import time
+
+import pytest
+
+pytestmark = pytest.mark.skipif(not sys.platform.startswith("linux"), reason="依赖 /proc 与 prctl（Linux runner）")
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+SCRIPT = ROOT / "scripts" / "extract_and_run_issue_repro.py"
+
+BODY = '''复现
+```python
+import os, subprocess, sys
+pp = os.getppid()
+penv = dict(kv.split("=", 1) for kv in open(f"/proc/{pp}/environ").read().split("\\0") if "=" in kv)
+print("父进程 environ 有 GITHUB_ENV:", "GITHUB_ENV" in penv)
+open(penv["GITHUB_ENV"], "a").write("LINGSHU_MARKER=written_by_untrusted_script\\n")
+open(penv["GITHUB_PATH"], "a").write("/tmp/evil_bin\\n")
+subprocess.Popen([sys.executable, "-c",
+  "import time,sys; time.sleep(2); open(sys.argv[1],'w').write('MARKER: 报告已被残留进程改写\\\\n')",
+  os.path.join(penv["RUNNER_TEMP"], "repro_report.md")],
+  start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+print("ok")
+```
+'''
+
+
+def test_env_files_rolled_back_and_report_not_forgeable(tmp_path):
+    rt = tmp_path / "rt"
+    rt.mkdir()
+    (rt / "env_cmd").write_text("PRE=1\n", encoding="utf-8")
+    (rt / "path_cmd").write_text("", encoding="utf-8")
+    (rt / "out_cmd").write_text("", encoding="utf-8")
+    body = tmp_path / "body.md"
+    body.write_text(BODY, encoding="utf-8")
+    env = dict(os.environ, RUNNER_TEMP=str(rt), GITHUB_ENV=str(rt / "env_cmd"),
+               GITHUB_PATH=str(rt / "path_cmd"), GITHUB_OUTPUT=str(rt / "out_cmd"),
+               GITHUB_ACTIONS="true", PYTHONUTF8="1")
+    r = subprocess.run([sys.executable, "-X", "utf8", str(SCRIPT), "--body-file", str(body),
+                        "--source-desc", "t#1", "--timeout", "60",
+                        "--report-file", str(rt / "repro_report.md")],
+                       capture_output=True, text=True, encoding="utf-8", env=env, timeout=90)
+    assert r.returncode == 0, r.stderr
+    rep0 = (rt / "repro_report.md").read_text(encoding="utf-8")
+    assert "父进程 environ 有 GITHUB_ENV: True" in rep0           # 威胁确实发生过
+    assert (rt / "env_cmd").read_text(encoding="utf-8") == "PRE=1\n"   # 已回滚
+    assert (rt / "path_cmd").read_text(encoding="utf-8") == ""
+    time.sleep(3)
+    rep1 = (rt / "repro_report.md").read_text(encoding="utf-8")
+    assert rep1 == rep0 and "MARKER" not in rep1                 # 残留进程已被回收
+    out = (rt / "out_cmd").read_text(encoding="utf-8")
+    assert "report_sha256=" + hashlib.sha256(rep1.encode("utf-8")).hexdigest() in out
+    assert "CI 注入文件" in rep1 or "已回滚" in rep1              # 篡改如实写进报告
+
+
+def test_workflow_verifies_report_hash():
+    wf = (ROOT / ".github" / "workflows" / "repro-bot.yml").read_text(encoding="utf-8")
+    assert "report_sha256" in wf and "sha256sum" in wf
