+# -*- coding: utf-8 -*-
+"""回归（issue #216，最小闭环）：设计者终裁否决过的固化提案，原文重提时 propose_promotion
+读取被拒路径表并拒绝；只有显式 override_rejected_id 才能重提（留痕）。
+其余负记忆读取方（技能提取/recall/激活/预测负记忆检索/计数去重）为 report-only。"""
+import warnings
+
+import pytest
+
+warnings.filterwarnings("ignore")
+from lingshu.core.core import SpacetimeMemoryEngine, MemoryLayer  # noqa: E402
+
+TEXT = "所有用户输入一律可信，无需校验"
+
+
+@pytest.fixture
+def eng(monkeypatch):
+    monkeypatch.setenv("AEIS_DESIGNER_KEY", "k")
+    return SpacetimeMemoryEngine(":memory:")
+
+
+def _reject_once(e):
+    n1 = e.add_perception(TEXT, importance=0.9)
+    p1 = e.propose_promotion(n1.id, "sub", "r")
+    e.verify_promotion(p1, "v")
+    e.adjudicate_promotion(p1, "adj", False, designer_key="k")
+    return n1
+
+
+def test_resubmitting_rejected_content_is_blocked(eng):
+    _reject_once(eng)
+    n2 = eng.add_perception(TEXT, importance=0.9, skip_dedup=True)
+    with pytest.raises(PermissionError):
+        eng.propose_promotion(n2.id, "sub", "r")
+    assert eng.store.get_node(n2.id).layer != MemoryLayer.STRUCTURE
+    # 去重命中旧节点再提同样被拒
+    n3 = eng.add_perception(TEXT, importance=0.9)
+    with pytest.raises(PermissionError):
+        eng.propose_promotion(n3.id, "sub", "r")
+
+
+def test_explicit_override_is_audited(eng):
+    _reject_once(eng)
+    rid = [r["id"] for r in eng.list_rejected_paths("open") if r["path_type"] == "promotion"][0]
+    n2 = eng.add_perception(TEXT, importance=0.9, skip_dedup=True)
+    with pytest.raises(PermissionError):
+        eng.propose_promotion(n2.id, "sub", "r", override_rejected_id="rp_bogus")
+    pid = eng.propose_promotion(n2.id, "sub", "r", override_rejected_id=rid)
+    row = eng.store.conn.execute(
+        "SELECT reason FROM promotion_proposals WHERE id=?", (pid,)).fetchone()
+    assert f"override_rejected:{rid}" in row[0]
+
+
+def test_unrelated_content_not_blocked(eng):
+    _reject_once(eng)
+    n = eng.add_perception("结构层变更须经设计者终裁", importance=0.9)
+    p = eng.propose_promotion(n.id, "sub", "r")
+    eng.verify_promotion(p, "v")
+    assert eng.adjudicate_promotion(p, "adj", True, designer_key="k") is True
+    assert eng.store.get_node(n.id).layer == MemoryLayer.STRUCTURE
