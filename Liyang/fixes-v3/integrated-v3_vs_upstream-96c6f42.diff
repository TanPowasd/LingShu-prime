+# -*- coding: utf-8 -*-
+"""issue #189：缺形状或颜色词的子句不得让 fuse_consistency / multimodal_check 抛 TypeError。"""
+import numpy as np
+
+from lingshu.nn import hex_text as T
+
+
+def _mm(monkeypatch, text, dets):
+    monkeypatch.setattr(T, "spatial_detect", lambda net, lat: [dets])
+    return T.multimodal_check(None, np.zeros((1, 4, 4)), text)
+
+
+def test_partial_clause_same_pos_no_crash(monkeypatch):
+    for text, pos in (("左上有红色", "r0"), ("右下有圆形", "r8")):
+        cl = T.parse_description(text)
+        assert cl and (cl[0]["shape"] is None or cl[0]["color"] is None)
+        dets = [{"pos": pos, "obj": "circle|red"}]
+        T.fuse_consistency(cl, dets)
+        r = _mm(monkeypatch, text, dets)
+        assert r["align"] == 0.0 and r["verdict"] in ("ACCEPT", "DEFER", "REJECT")
+
+
+def test_partial_clause_other_pos_no_crash():
+    for text in ("左上有红色", "右下有圆形"):
+        r = T.fuse_consistency(T.parse_description(text), [{"pos": "r4", "obj": "circle|red"}])
+        assert r["verdict"] == "REJECT"
+
+
+def test_full_clause_scores_unchanged(monkeypatch):
+    text = "左上有红色圆形"
+    cl = T.parse_description(text)
+    assert cl[0]["shape"] and cl[0]["color"] and cl[0]["pos"]
+    obj = f'{cl[0]["shape"]}|{cl[0]["color"]}'
+    assert T.fuse_consistency(cl, [{"pos": cl[0]["pos"], "obj": obj}])["verdict"] == "ACCEPT"
+    assert T.fuse_consistency(cl, [{"pos": "r4", "obj": obj}])["score"] == 0.4
+    r = _mm(monkeypatch, text, [{"pos": cl[0]["pos"], "obj": obj}])
+    assert r["align"] == 1.0
