+dog = w.add_vprim(VPrim("dog", (360, 280, 440, 360), confidence=0.9), W, H)
+print("① 相机 cx=5，画面正中 dog → center =", dog.center)
+print("   用同一相机重投影 dog 中心 →", tuple(round(v,1) for v in cam.project(dog.center, W, H)), "（原 bbox 中心 (400, 320)）")
+# ② 相机掉头（look_at 看 -z 方向），反投影仍按 +z 放在相机身后
+cam2 = Camera3D.look_at(eye=(0, 1.2, 0), target=(0, 1.2, -10))
