+# -*- coding: utf-8 -*-
+"""issue #203 回归：#145 因果链守卫必须进入门禁。
+
+改前：tests/test_issue145_causal_depth_cycles.py 只有 group_* + __main__，pytest 收集 0 条；
+gate.yml 的 SCRIPT_TESTS 也没有它 ⇒ 两条执行路径都跑不到。
+改后：①gate.yml SCRIPT_TESTS 含该件（采纳 PR #204）；②该件另有 pytest 可收集的包装用例，
+本地/任何「pytest tests/」式门禁同样会执行它。
+运行：python -X utf8 -m pytest tests/test_issue203_causal_guard_gate.py -q
+"""
+import os
+import re
+import subprocess
+import sys
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+GUARD = "tests/test_issue145_causal_depth_cycles.py"
+
+
+def _script_tests():
+    text = open(os.path.join(REPO, ".github", "workflows", "gate.yml"), encoding="utf-8").read()
+    m = re.search(r"^\s*SCRIPT_TESTS:\s*>-\s*\n((?:\s+tests/\S+\n)+)", text, re.M)
+    assert m, "gate.yml 未找到 SCRIPT_TESTS 折叠块"
+    return m.group(1).split()
+
+
+def test_guard_listed_in_gate_script_tests():
+    assert GUARD in _script_tests(), _script_tests()
+
+
+def test_guard_collectable_by_pytest():
+    p = subprocess.run([sys.executable, "-m", "pytest", "--collect-only", "-q",
+                        "-p", "no:cacheprovider", GUARD],
+                       cwd=REPO, capture_output=True, text=True, timeout=120)
+    assert p.returncode == 0, p.stdout + p.stderr
+    collected = [ln for ln in p.stdout.splitlines() if "::" in ln]
+    assert collected, "pytest 对 #145 守卫收集 0 条：\n" + p.stdout
