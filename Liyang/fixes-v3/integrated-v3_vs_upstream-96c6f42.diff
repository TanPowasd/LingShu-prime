+# NEW-nn-01 · stcnn.extract_spatiotemporal_primitives：frame_diff 作用在原始帧（固定阈值 0.08），
+#   而运动量走归一化体素——同一段视频亮度缩放 / 换成 8-bit 后，方向/速度/周期全变
+# 运行：在仓库根目录 PYTHONPATH=. python _out/repro/NEW-nn-01.py
+import numpy as np
+from lingshu.nn.stcnn import extract_spatiotemporal_primitives, synth_ball_rolling, synth_blinking
+
+K = ("direction", "speed", "period", "moving", "trajectory_len")
+def P(fr):
+    p, _ = extract_spatiotemporal_primitives(fr); return {k: p[k] for k in K}
+
+ball = synth_ball_rolling(10, speed_px=2)
+ref = P(ball); bad = False
+for s in (1.0, 0.05, 255.0):
+    r = P([x * s for x in ball]); bad |= r != ref
+    print(f"球  ×{s:<6} {r}")
+blink = synth_blinking(12, period=3); refb = P(blink)
+for s in (1.0, 0.05):
+    r = P([x * s for x in blink]); bad |= r != refb
+    print(f"闪烁 ×{s:<6} {r}")
+rng = np.random.default_rng(0)
+noisy = [x + rng.random(x.shape) * 0.03 for x in ball]
+a, b = P(noisy), P([x * 255 for x in noisy]); bad |= a != b
+print("球+3% 噪声 [0,1]  ", a)
+print("球+3% 噪声 [0,255]", b)
+print("BUG" if bad else "OK")
