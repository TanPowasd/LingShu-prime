+"""issue #286：tools/coggraph/export_coggraph.py 硬依赖 PyYAML（缺则 re-raise），
+而 CI 只装 `.[full,dev]`——pyproject 必须把 PyYAML 声明进 dev，否则 gate 的 pytest 腿必红。
+
+守卫：扫 tools/ scripts/ 下对第三方包 yaml 的硬导入，要求 dev extra 声明 PyYAML。
+"""
+import re
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+@unittest.skipIf(sys.version_info < (3, 11), "需要 tomllib 解析 pyproject")
+class GateDeclaresPyYAML(unittest.TestCase):
+    def test_dev_extra_declares_pyyaml_when_tools_import_yaml(self):
+        import tomllib
+        meta = tomllib.loads((ROOT / "pyproject.toml").read_text(encoding="utf-8"))
+        extras = meta["project"]["optional-dependencies"]
+        users = []
+        for sub in ("tools", "scripts"):
+            for p in (ROOT / sub).rglob("*.py"):
+                for i, line in enumerate(p.read_text(encoding="utf-8").splitlines(), 1):
+                    if re.match(r"\s*import yaml\b", line):
+                        users.append(f"{p.relative_to(ROOT)}:{i}")
+        self.assertTrue(users, "预期 tools/ 下有 yaml 导入（否则本守卫失效）")
+        declared = {re.split(r"[<>=!~\[ ]", d, 1)[0].lower()
+                    for k in ("dev", "full") for d in extras.get(k, [])}
+        self.assertIn("pyyaml", declared,
+                      "gate 以 .[full,dev] 安装，但未声明 PyYAML；导入方：" + ", ".join(users))
+
+
+if __name__ == "__main__":
+    unittest.main()
