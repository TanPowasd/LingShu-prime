@@ -0,0 +1,68 @@
+#!/usr/bin/env python3
+"""灵枢「缺陷探针榜单」—— 同一组探针在多个代码快照上打分，生成可复跑的排行榜。
+
+探针约定：bench/probes/<id>.py，运行时以 PYTHONPATH=<快照根> 导入 lingshu；
+          输出中最后一个以 "BUG" 或 "OK" 开头的行为判定（BUG=缺陷仍在，OK=已修复）。
+          超时 / 崩溃 / 无判定行 记为 ERR（计 0 分，单独列出，不当作修复）。
+用法：python bench/leaderboard.py --snap base=/path/a --snap fixed=/path/b [--probes bench/probes] [--json out.json] [--md out.md]
+"""
+import argparse, json, os, subprocess, sys, time, glob
+
+def run_probe(probe, root, timeout):
+    env = dict(os.environ, PYTHONPATH=root, PYTHONHASHSEED="0", PYTHONUTF8="1", MDCG_ROOT="")
+    env.pop("MDCG_ROOT")
+    t0 = time.perf_counter()
+    try:
+        p = subprocess.run([sys.executable, probe], cwd=root, env=env, capture_output=True,
+                           text=True, timeout=timeout)
+        out = p.stdout + p.stderr
+    except subprocess.TimeoutExpired:
+        return "ERR", "timeout", time.perf_counter() - t0
+    dt = time.perf_counter() - t0
+    verdict, detail = "ERR", (out.strip().splitlines() or ["<no output>"])[-1][:160]
+    for line in out.splitlines():
+        s = line.strip()
+        if s.startswith("BUG"):
+            verdict, detail = "BUG", s[:160]
+        elif s.startswith("OK"):
+            verdict, detail = "OK", s[:160]
+    return verdict, detail, dt
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--snap", action="append", required=True, help="name=path")
+    ap.add_argument("--probes", default=os.path.join(os.path.dirname(__file__), "probes"))
+    ap.add_argument("--timeout", type=float, default=60)
+    ap.add_argument("--json"); ap.add_argument("--md")
+    a = ap.parse_args()
+    snaps = [s.split("=", 1) for s in a.snap]
+    probes = sorted(glob.glob(os.path.join(a.probes, "*.py")))
+    res = {name: {} for name, _ in snaps}
+    for pr in probes:
+        pid = os.path.splitext(os.path.basename(pr))[0]
+        for name, root in snaps:
+            res[name][pid] = run_probe(os.path.abspath(pr), os.path.abspath(root), a.timeout)
+            print(f"{pid:28s} {name:10s} {res[name][pid][0]:4s} {res[name][pid][2]:6.2f}s  {res[name][pid][1]}", flush=True)
+    board = []
+    for name, _ in snaps:
+        v = [r[0] for r in res[name].values()]
+        board.append((name, v.count("OK"), v.count("BUG"), v.count("ERR"), len(v)))
+    board.sort(key=lambda r: (-r[1], r[3]))
+    lines = ["# 灵枢缺陷探针榜单", "", f"探针数：{len(probes)}（OK=缺陷已消除，BUG=仍复现，ERR=崩溃/超时）", "",
+             "| 排名 | 快照 | OK | BUG | ERR | 修复率 |", "|---|---|---|---|---|---|"]
+    for i, (n, ok, bug, err, tot) in enumerate(board, 1):
+        lines.append(f"| {i} | {n} | {ok} | {bug} | {err} | {ok/max(tot,1):.1%} |")
+    lines += ["", "## 逐探针", "", "| 探针 | " + " | ".join(n for n, _ in snaps) + " |",
+              "|---|" + "---|" * len(snaps)]
+    for pr in probes:
+        pid = os.path.splitext(os.path.basename(pr))[0]
+        lines.append(f"| {pid} | " + " | ".join(res[n][pid][0] for n, _ in snaps) + " |")
+    md = "\n".join(lines) + "\n"
+    print(md)
+    if a.md: open(a.md, "w").write(md)
+    if a.json:
+        json.dump({n: {k: {"verdict": v[0], "detail": v[1], "sec": round(v[2], 3)} for k, v in r.items()}
+                   for n, r in res.items()}, open(a.json, "w"), ensure_ascii=False, indent=1)
+
+if __name__ == "__main__":
+    main()
