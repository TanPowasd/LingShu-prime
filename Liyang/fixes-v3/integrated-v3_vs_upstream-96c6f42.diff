+"""回归：D-006 返回的 threshold 必须是 reflect 的真实判据边界（issue 草稿 world-08，保守修复）。
+
+原式 max(BASE, mean-2σ) 与同一 mean 比较，动态项永不生效；返回的 threshold（如 0.514）
+并不是判据边界：命中率真跌到它以下时 reflect 仍为 False。
+本修复如实收敛为固定基线 BASE；动态退化检测的口径 needs-owner-decision。
+"""
+import random
+
+from lingshu.world.prediction import PredictionEngine
+
+
+def _hist(n, k):
+    h = [True] * k + [False] * (n - k)
+    random.Random(n * 1000 + k).shuffle(h)
+    return h
+
+
+def _run(h):
+    pe = PredictionEngine(engine=None)
+    pe._hit_history = list(h)
+    return pe._dynamic_hit_threshold()
+
+
+def test_reported_threshold_is_a_real_boundary():
+    n = 200
+    r = _run(_hist(n, 190))                     # mean 0.95
+    thr = r["threshold"]
+    k_below = int(thr * n) - 1                  # 命中率刚好低于所报阈值
+    r2 = _run(_hist(n, k_below))
+    assert r2["mean"] < thr
+    assert r2["reflect"] is True, (thr, r2)    # 修复前：thr=0.5141，mean 0.505 时 reflect=False
+
+
+def test_base_rule_preserved():
+    pe = PredictionEngine(engine=None)
+    rng = random.Random(0)
+    for _ in range(2000):
+        n = rng.randint(50, 200)
+        p = rng.random()
+        h = [rng.random() < p for _ in range(n)]
+        r = _run(h)
+        assert r["reflect"] == (sum(h) / n < pe.BASE_HIT_RATE)
+    assert _run([True] * 10)["reflect"] is False     # 样本不足不触发
