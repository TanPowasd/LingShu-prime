--- /dev/null
+++ b/tests/test_core_visual_check_baseline.py
@@ -0,0 +1,51 @@
+"""回归：visual_check 的「预期」取最近一次屏幕状态，而非永远锁在基线
+（issue 草稿 core-py-09）。身体层用最小桩替身（screen.capture / screen.diff）。"""
+import os
+
+from lingshu.core.core import SpacetimeMemoryEngine
+
+
+class _R:
+    def __init__(self, ok, data=None, error=None):
+        self.ok, self.data, self.error = ok, data or {}, error
+
+    def to_dict(self):
+        return {"ok": self.ok, "data": self.data}
+
+
+class _Body:
+    def __init__(self, root):
+        self.root, self.n, self.refs = root, 0, []
+
+    def invoke(self, device, op, params):
+        if op == "capture":
+            self.n += 1
+            p = os.path.join(self.root, f"screen_{self.n:04d}.png")
+            open(p, "wb").close()
+            return _R(True, {"path": p})
+        if op == "diff":
+            self.refs.append(os.path.basename(params["reference"]))
+            return _R(True, {"changed": False, "change_ratio": 0.0})
+        raise AssertionError(op)
+
+
+def _run(tmp_path, rounds):
+    e = SpacetimeMemoryEngine()
+    body = _Body(str(tmp_path))
+    e._body_registry = body
+    assert e.visual_check()["established"] is True   # screen_0001 = 基线
+    for _ in range(rounds):
+        e.visual_check()
+    return e, body
+
+
+def test_expected_follows_latest_screen_state(tmp_path):
+    _, body = _run(tmp_path, 6)
+    # 第 k 次对照的预期应是上一次回写的截图；修复前 6 次全是 screen_0001.png
+    assert body.refs == [f"screen_{i:04d}.png" for i in range(1, 7)]
+
+
+def test_each_screen_state_is_recorded(tmp_path):
+    e, _ = _run(tmp_path, 4)
+    nodes = e.store.get_nodes_by_tag("screen_state", limit=50)
+    assert len(nodes) == 5       # 基线 + 4 次回写；修复前被 M5 去重并成 2 条
