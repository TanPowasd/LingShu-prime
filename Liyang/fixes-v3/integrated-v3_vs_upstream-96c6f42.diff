+# -*- coding: utf-8 -*-
+"""回归：rust_bridge.make_plan 的支路采样空间必须等于被训练网络的参数数（issue 草稿 nn-07）。
+只用 Python 参考执行器，不需要 hex_nn.exe。"""
+import numpy as np
+import pytest
+
+from lingshu.nn.hex_hier import HexHierNet
+from lingshu.nn.rust_bridge import make_plan, py_executor
+
+CFGS = [dict(n_kernels=6, n_kernels2=6),
+        dict(n_kernels=6, n_kernels2=6, deep_norm=True, amp_sep=True),
+        dict(n_kernels=8, n_kernels2=8),
+        dict(n_kernels=4, n_kernels2=4)]
+
+
+@pytest.mark.parametrize("kw", CFGS, ids=lambda kw: "-".join(f"{k}={v}" for k, v in kw.items()))
+def test_plan_covers_exactly_net_params(kw):
+    n = HexHierNet(**kw).n_params()
+    plan = make_plan(40, steps=200, batch=8, samples=64, seed=7, n_params=n)
+    assert set().union(*map(set, plan["plan_sample"])) == set(range(n))
+
+
+def test_default_plan_unchanged_for_6x6():
+    # 旧调用（无 n_params）与显式 n_params=375 逐位一致：K1=K2=6 的 Rust 等价基线不受影响
+    assert make_plan(40, 10, 8, 24, 7) == make_plan(40, 10, 8, 24, 7, n_params=375)
+
+
+def _toy(n=16, seed=1):
+    rng = np.random.default_rng(seed)
+    lat = rng.normal(size=(n, 9, 9, 3))
+    return lat, rng.integers(0, 9, n), rng.integers(0, 3, n)
+
+
+def test_head_is_trained_for_8x8():
+    net = HexHierNet(n_kernels=8, n_kernels2=8)
+    lat, oi, si = _toy()
+    v0 = net.get_vec().copy()
+    plan = make_plan(len(lat), steps=6, batch=8, samples=200, seed=7, n_params=net.n_params())
+    py_executor(lat, oi, si, v0.copy(), plan, net)
+    head0 = v0.size - net.head.size
+    assert int((net.get_vec()[head0:] != v0[head0:]).sum()) > 0
+
+
+def test_mismatched_plan_is_rejected_clearly():
+    net = HexHierNet(n_kernels=4, n_kernels2=4)
+    lat, oi, si = _toy()
+    plan = make_plan(len(lat), steps=2, batch=4, samples=64, seed=7, n_params=375)
+    with pytest.raises(ValueError, match="n_params"):
+        py_executor(lat, oi, si, net.get_vec().copy(), plan, net)
