+"""回归：spatial_relation 重叠率须与坐标量纲无关（issue 草稿 world-05，仅分母钳 1.0 部分）。
+
+修复前：同一对框像素坐标 → overlap 0.64，整体缩放 1/1000 后 → adjacent 0.16；
+亚像素小框真实重叠率 0.766 报 0.49。
+"""
+import random
+
+from lingshu.world.vprim import spatial_relation
+
+
+def test_overlap_ratio_scale_invariant_example():
+    a, b = (0, 0, 500, 500), (100, 100, 600, 600)
+    s = 1 / 1000
+    r1 = spatial_relation(a, b)
+    r2 = spatial_relation(tuple(v * s for v in a), tuple(v * s for v in b))
+    assert r1["relation"] == r2["relation"] == "overlap"
+    assert r1["overlap_ratio"] == r2["overlap_ratio"] == 0.64
+
+
+def test_subpixel_boxes_true_ratio():
+    r = spatial_relation((10, 10, 10.8, 10.8), (10.1, 10.1, 10.9, 10.9))
+    assert abs(r["overlap_ratio"] - 0.766) < 1e-3 and r["relation"] == "overlap"
+
+
+def test_relation_scale_invariant_property():
+    rng = random.Random(0)
+    for _ in range(500):
+        def box():
+            x, y = rng.uniform(0, 400), rng.uniform(0, 400)
+            return (x, y, x + rng.uniform(1, 200), y + rng.uniform(1, 200))
+        a, b = box(), box()
+        for s in (1e-3, 1 / 640):
+            ra = spatial_relation(a, b)
+            rs = spatial_relation(tuple(v * s for v in a), tuple(v * s for v in b))
+            assert ra["relation"] == rs["relation"], (a, b, s)
+            assert abs(ra["overlap_ratio"] - rs["overlap_ratio"]) <= 1e-3, (a, b, s)
