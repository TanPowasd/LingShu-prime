+        assert eng.world3d("status", {})["status"] == "ok"
+        assert eng.wm_simloop("status", {})["status"] == "error"   # 未 setup（与搬移前一致）
+    finally:
+        eng.close()
diff --git a/tests/test_dedup_shims.py b/tests/test_dedup_shims.py
new file mode 100644
index 0000000..fe40a13
--- /dev/null
+++ b/tests/test_dedup_shims.py
@@ -0,0 +1,48 @@
+# -*- coding: utf-8 -*-
+"""去重守卫：副本模块改为薄重导出 shim 后，两条导入路径必须导出**同一对象**。
+
+- lingshu.gen.hex_composite  → 单一来源 lingshu.nn.hex_composite
+- lingshu.world.time_core    → 单一来源 lingshu.core.time_core
+
+若有人在 shim 里重新粘贴实现（再次分叉），`is` 断言即红。
+"""
+import importlib
+
+import pytest
+
+PAIRS = [
+    ("lingshu.gen.hex_composite", "lingshu.nn.hex_composite"),
+    ("lingshu.world.time_core", "lingshu.core.time_core"),
+]
+
+
+def _public_and_used(mod):
+    # 公开名 + 被其他模块按私有名复用的 _COLORS_RGB/_paint/_ZONES
+    return [k for k in vars(mod) if not k.startswith("__") and k not in ("annotations",)]
+
+
+@pytest.mark.parametrize("shim_name,canon_name", PAIRS)
+def test_shim_exports_same_objects(shim_name, canon_name):
+    if "hex_composite" in canon_name:
+        pytest.importorskip("numpy")
+    shim = importlib.import_module(shim_name)
+    canon = importlib.import_module(canon_name)
+    names = [k for k in _public_and_used(canon)
+             if not (k in ("Dict", "List", "Optional", "Tuple"))]
+    assert names, canon_name
+    missing = [k for k in names if not hasattr(shim, k)]
+    assert not missing, f"{shim_name} 缺少重导出: {missing}"
+    diverged = [k for k in names if getattr(shim, k) is not getattr(canon, k)]
+    assert not diverged, f"{shim_name} 与 {canon_name} 不是同一对象: {diverged}"
+    for k in getattr(shim, "__all__", []):
+        assert getattr(shim, k) is getattr(canon, k)
+
+
+def test_shim_has_no_own_implementation():
+    """shim 内不得再定义函数（函数的 __module__ 必须是单一来源模块）。"""
+    pytest.importorskip("numpy")
+    for shim_name, canon_name in PAIRS:
+        shim = importlib.import_module(shim_name)
+        for k, v in vars(shim).items():
+            if callable(v) and getattr(v, "__module__", None) == shim_name:
+                pytest.fail(f"{shim_name}.{k} 在 shim 内有自己的实现")
