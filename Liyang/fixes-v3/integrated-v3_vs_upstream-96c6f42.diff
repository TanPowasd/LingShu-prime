+# -*- coding: utf-8 -*-
+"""回归：SpatiotemporalMemory.verify_consistency 必须能检出不一致（issue 草稿 nn-08，仅恒真部分；
+recall 白名单问题见 #162，本文件不涉及）。"""
+import pytest
+
+from lingshu.nn.stcnn import (SpatiotemporalMemory, extract_spatiotemporal_primitives,
+                              synth_ball_rolling, synth_blinking, synth_static)
+
+
+@pytest.fixture
+def mem():
+    m = SpatiotemporalMemory()
+    for frames, label in ((synth_ball_rolling(10, speed_px=2), "球"),
+                          (synth_blinking(12, period=3), "灯"),
+                          (synth_static(6), "背景")):
+        prims, _ = extract_spatiotemporal_primitives(frames)
+        m.remember(prims, label)
+    return m
+
+
+def test_consistent_memory_passes(mem):
+    assert mem.verify_consistency() is True
+    assert SpatiotemporalMemory().verify_consistency() is True
+
+
+def test_injected_event_is_detected(mem):
+    mem.events.append({"label": "幻觉", "direction": None})
+    assert mem.verify_consistency() is False
+
+
+def test_injected_well_formed_event_is_detected(mem):
+    mem.events.append(dict(mem.events[0], label="幻觉"))
+    assert mem.verify_consistency() is False
+
+
+def test_mutated_event_is_detected(mem):
+    mem.events[0]["direction"] = "向左"
+    assert mem.verify_consistency() is False
+
+
+def test_dropped_event_is_detected(mem):
+    mem.events.pop()
+    assert mem.verify_consistency() is False
