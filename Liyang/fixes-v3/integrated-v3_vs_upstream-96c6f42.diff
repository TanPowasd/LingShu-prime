+# -*- coding: utf-8 -*-
+"""回归（issue #231 次要①）：形状库每个部件的 AABB 至少与一个其它部件相交（不脱离）；鸟喙在头的前方（与头同侧 +z）。
+主缺陷（整体接地约定）仍为 needs-owner-decision，见 test_issue231_shapes_grounding.py 的 xfail。"""
+import pytest
+
+import lingshu.world.shapes as shapes
+
+
+def _aabb(p):
+    return [(c - s / 2, c + s / 2) for c, s in zip(p["pos"], p["size"])]
+
+
+def _touch(a, b, eps=1e-9):
+    return all(lo1 <= hi2 + eps and lo2 <= hi1 + eps for (lo1, hi1), (lo2, hi2) in zip(_aabb(a), _aabb(b)))
+
+
+@pytest.mark.parametrize("cat", sorted(shapes.SHAPE_LIBRARY))
+def test_every_part_touches_another(cat):
+    parts = shapes.get_shape(cat)
+    if len(parts) < 2:
+        pytest.skip("单部件")
+    for i, p in enumerate(parts):
+        assert any(_touch(p, q) for j, q in enumerate(parts) if j != i), (cat, i, p)
+
+
+def test_bird_beak_in_front_of_head():
+    parts = shapes.get_shape("bird")
+    head, beak = parts[1], parts[3]
+    assert beak["kind"] == "pyramid"
+    assert beak["pos"][2] > head["pos"][2]          # 头朝 +z，喙在头前
+    assert _touch(beak, head)
