+# 运行：cd <仓库根> && python _out/repro/core-rest-03.py
+import json, os, subprocess, sys, tempfile
+REPO = os.environ.get("LINGSHU_REPO", os.getcwd())
+TOOL = os.path.join(REPO, "tools", "coggraph", "export_coggraph.py")
+
+def md(root, rel, fm):
+    p = os.path.join(root, rel); os.makedirs(os.path.dirname(p), exist_ok=True)
+    open(p, "w", encoding="utf-8").write("---\n" + fm.strip() + "\n---\n# 功能名：" + rel + "\n")
+
+def run(root, out, *extra):
+    r = subprocess.run([sys.executable, TOOL, "--root", root, "--out", out, "--write", *extra],
