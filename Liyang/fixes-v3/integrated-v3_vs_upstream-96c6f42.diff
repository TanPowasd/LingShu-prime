+print("wolf→rabbit 距离序列:", d)
+tail = d[-10:]
+print("末 10 tick 距离最小值 =", min(tail), "| 是否稳定停在目标上:", max(tail) < 1e-6)
+print("BUG" if max(tail) > 1e-6 else "OK", "(追上后在目标两侧以 speed 步长来回越过)")
