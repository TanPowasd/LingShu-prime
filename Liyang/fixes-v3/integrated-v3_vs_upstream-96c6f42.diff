+++ b/tests/test_issue273_pathguard_host_imports.py
@@ -0,0 +1,52 @@
+# -*- coding: utf-8 -*-
+"""回归（issue #273）：import lingshu 不得改写宿主 sys.path——cwd/脚本目录/PYTHONPATH=. 下宿主自有模块照常可导入；
+cwd 同名标准库毒模块仍不在引擎进程内执行（#156 保护不退）。"""
+import os, subprocess, sys, tempfile
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+def _run(args, cwd, extra=None):
+    env = {k: v for k, v in os.environ.items() if k != "LINGSHU_ALLOW_CWD_IMPORTS"}
+    env["PYTHONPATH"] = REPO
+    env.update(extra or {})
+    r = subprocess.run([sys.executable, "-W", "ignore"] + args, cwd=cwd, env=env,
+                       capture_output=True, text=True, timeout=120)
+    return (r.stdout.strip() or r.stderr.strip()).splitlines()[-1]
+
+
+def _app():
+    app = tempfile.mkdtemp(prefix="i273_")
+    open(os.path.join(app, "settings.py"), "w").write("DEBUG = True\n")
+    open(os.path.join(app, "main.py"), "w").write("import lingshu\nimport settings\nprint('ok')\n")
+    return app
+
+
+def test_cd_app_python_main():                       # [1]
+    app = _app()
+    assert _run(["main.py"], app) == "ok"
+
+
+def test_python_c_in_app_dir():                      # [3]
+    app = _app()
+    assert _run(["-c", "import lingshu; import settings; print('ok')"], app) == "ok"
+
+
+def test_explicit_pythonpath_dot():                  # [4]
+    assert _run(["-c", "import lingshu; import tools; print('ok')"], REPO, {"PYTHONPATH": "."}) == "ok"
+
+
+def test_sys_path_not_mutated():
+    app = _app()
+    out = _run(["-c", "import sys; b=list(sys.path); import lingshu; print('same' if b==sys.path else 'mutated')"], app)
+    assert out == "same"
+
+
+def test_cwd_stdlib_poison_still_blocked():
+    d = tempfile.mkdtemp(prefix="i273p_")
+    open(os.path.join(d, "json.py"), "w").write(
+        "import os\nopen(os.path.join(os.path.dirname(__file__), 'MARKER.txt'), 'w').write('x')\n")
+    out = _run(["-c", "from lingshu.core.core import SpacetimeMemoryEngine; "
+                      "SpacetimeMemoryEngine(':memory:'); print('ok')"], d)
+    assert out == "ok"
+    assert not os.path.exists(os.path.join(d, "MARKER.txt"))
