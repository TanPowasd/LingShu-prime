+# -*- coding: utf-8 -*-
+"""回归（issue #258）：consolidate_cycle 不得只处理 importance 前 1000 名（低重要度节点须被降权/标记）。"""
+import os
+import tempfile
+import warnings
+
+warnings.filterwarnings("ignore")
+from lingshu.core.core import SpacetimeMemoryEngine  # noqa: E402
+
+
+def test_low_importance_nodes_beyond_1000_are_consolidated():
+    e = SpacetimeMemoryEngine(os.path.join(tempfile.mkdtemp(), "c.db"))
+    for i in range(1020):
+        e.add_perception(f"噪声{i}：例行记录{i}", skip_dedup=True, importance=0.5)
+    low = [e.add_perception(f"低权重{i}：待巩固记录{i}", skip_dedup=True, importance=0.05).id
+           for i in range(10)]
+    before = {i: e.store.get_node(i).importance for i in low}
+    stats = e.consolidate_cycle()
+    after = {i: e.store.get_node(i).importance for i in low}
+    assert stats["degraded"] >= 10 and stats["compressible"] >= 10
+    assert all(after[i] < before[i] for i in low)
+    assert all("compressible" in e.store.get_node(i).tags for i in low)
