+    "wm_simloop": "690ab9029f669909e76fb5e63cd4832b0ced1784f633b6689327f21c23344e8d",
+    "scene_simulator": "59623b9a324747e6106b616fb9ba7c82f824249b0d02c7fc08b9f3cbf24f3889",
+    "spacetime_consistency": "a1b44eea70f702e0f3c4e25f57f4240b905ba30c03ec9d9c3bc4169826111d7d",  # issue #243 有意新增 init 分支，非搬移夹带
+    "world_model": "8dac2950f15c1283fca7161afb688cc295112e44eab04b199f0983ce2da92832",  # issue #243 有意新增 init 分支，非搬移夹带
+    "world_learner": "a691900abe23928b3a259e171d1e5bdfbc0c78d46287abbbea6b6bbdbb073e36",  # issue #243 有意新增 init 分支，非搬移夹带
+    "curiosity_explorer": "5b2ca996753f4f7d3e6def297911fa3c28e8272c8dc2c89a77a2725acc1b5a38",  # issue #243 有意新增 init 分支，非搬移夹带
+    "seven_layer_loop": "eee49db5c9766b7ce84dab7620d73f8102555fb21e8c56ec384a9d8b8d6db083",  # issue #243 有意新增 init 分支，非搬移夹带
+    "world_generator": "a46a6349b352678ec9e3d8a22da2f40bacef52093e2371a1a56a12652cda0707",
+    "world_semantics": "e27f0e39082e2418206a27ebdfb7d1c1476924e651c4edbb570e2cc8b320d3a8",
+    "vprim_query": "1960232fa27c845d1f5cced000384d1bebf8e1ef77e91f82bcd193227b6ff6f9",
+    "_load_vprims_from_memory": "102dfbfd8182ba08abeedc6b4681bc82f0752803996696ddf6a34ee7f89a871c",
+}
+
+
+def test_moved_methods_are_verbatim():
+    for name, digest in BASELINE_SHA256.items():
+        src = inspect.getsource(WorldFacadeMixin.__dict__[name])
+        assert hashlib.sha256(src.encode("utf-8")).hexdigest() == digest, name
+
+
+def test_engine_resolves_to_mixin_methods():
+    assert issubclass(SpacetimeMemoryEngine, WorldFacadeMixin)
+    for name in BASELINE_SHA256:
+        assert name not in SpacetimeMemoryEngine.__dict__, f"{name} 在 core.py 又定义了一份"
+        assert getattr(SpacetimeMemoryEngine, name) is WorldFacadeMixin.__dict__[name]
