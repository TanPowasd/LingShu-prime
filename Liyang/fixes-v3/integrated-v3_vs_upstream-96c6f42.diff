+"""回归：decay_cycle 对 importance ≤ min_confidence 的情境节点同样执行自然遗忘；
+forget_advisor 归档只降不升、importance=0.0 视为低价值（issue 草稿 core-py-01）。"""
+from lingshu.core.core import SpacetimeMemoryEngine
+
+
+def _alive(e, nid):
+    return e.store.get_node(nid) is not None
+
+
+def test_low_importance_context_nodes_are_forgotten():
+    e = SpacetimeMemoryEngine()
+    ids = {imp: e.add_context(f"情境节点 importance={imp}", importance=imp).id
+           for imp in (0.05, 0.10, 0.11, 0.30)}
+    for _ in range(200):
+        e.decay_cycle()
+    survivors = [imp for imp, nid in ids.items() if _alive(e, nid)]
+    # 修复前：0.05 / 0.10 永生（越不重要越不会被忘）
+    assert survivors == []
+
+
+def test_lower_importance_is_forgotten_no_later_than_higher():
+    e = SpacetimeMemoryEngine()
+    lo = e.add_context("低重要度情境", importance=0.05).id
+    hi = e.add_context("高重要度情境", importance=0.30).id
+    e.decay_cycle()
+    assert not _alive(e, lo)
+    assert _alive(e, hi)
+
+
+def test_forget_advisor_never_raises_importance():
+    e = SpacetimeMemoryEngine()
+    b = e.add_context("重要度 0.05 的情境", importance=0.05).id
+    d = e.add_context("重要度 0.15 的情境", importance=0.15).id
+    e.forget_advisor()
+    assert e.store.get_node(b).importance == 0.05   # 修复前被抬高到 0.1
+    assert e.store.get_node(d).importance == 0.1
+
+
+def test_forget_advisor_zero_importance_is_low_value():
+    e = SpacetimeMemoryEngine()
+    z = e.add_context("重要度 0 的情境", importance=0.0).id
+    r = e.forget_advisor()
+    assert r["archived"] == 1   # 修复前 0.0 被 `or 0.5` 当成 0.5 → kept
+    assert "archived" in e.store.get_node(z).tags
