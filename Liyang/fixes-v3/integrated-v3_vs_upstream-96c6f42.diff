+        e._interaction_count += 1          # 模拟新的一轮
+        e.search_content("苹果")
+    assert len(e._reuse_tracker) <= SpacetimeMemoryEngine.REUSE_TRACKER_ROUNDS
+    # 跨轮落库不受内存裁剪影响：每轮一行
