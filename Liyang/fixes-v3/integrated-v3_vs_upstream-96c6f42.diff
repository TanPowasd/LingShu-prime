index 0000000..3c4ebd6
--- /dev/null
+++ b/tests/test_issue201_self_snapshot_recall.py
@@ -0,0 +1,77 @@
+# -*- coding: utf-8 -*-
+"""issue #201：SELF 快照以普通记忆身份参与 recall，挤占真实记忆；快照内嵌全量 history 体积无界。"""
+import json
+from lingshu.core.core import SpacetimeMemoryEngine, MemoryLayer
+
+
+def _churn(e, a, b):
+    for i in range(a, b):
+        e.update_self({"current_goal": f"目标{i}"})
+        e.update_trust_state(0.5 + i * 0.01, i)
+
+
+def test_recall_not_crowded_by_self_snapshots():
+    e = SpacetimeMemoryEngine(":memory:")
+    k = e.add_perception("用户说：信任需要时间慢慢建立，结构完整比速度重要", importance=0.6)
+    kid = getattr(k, "id", k)
+    _churn(e, 0, 60)
+    for q in ["信任", "结构完整"]:
+        r = e.recall(q, limit=10)
+        assert sum(n.layer == MemoryLayer.SELF for n, _ in r) == 0
+        assert r and r[0][0].id == kid
+
+
+def test_self_snapshot_does_not_embed_history():
+    e = SpacetimeMemoryEngine(":memory:")
+    e.update_self({"current_goal": "g0"})
+    first = len(e.store.get_layer_nodes(MemoryLayer.SELF)[-1].content)
+    for i in range(1, 150):
+        e.update_self({"current_goal": f"g{i}"})
+    nodes = e.store.get_layer_nodes(MemoryLayer.SELF)
+    last = max(nodes, key=lambda n: n.temporal_coordinate)
+    d = json.loads(last.content)
+    assert "history" not in d
+    assert d["current_goal"] == "g149"
+    assert len(last.content) < 2 * first
+
+
+# ---- 无界增长（ng 探针 i201-self-unbounded）：快照改为「单一当前节点」原地更新 ----
+
+def test_update_self_does_not_grow_self_layer():
+    e = SpacetimeMemoryEngine(":memory:")
+    e.update_self({"current_goal": "g0"})
+    n1 = e.store.count_layer(MemoryLayer.SELF)
+    for i in range(1, 100):
+        e.update_self({"current_goal": f"目标{i}"})
+    assert e.store.count_layer(MemoryLayer.SELF) == n1 == 1
+    cur = e.store.get_layer_nodes(MemoryLayer.SELF)[0]
+    assert json.loads(cur.content)["current_goal"] == "目标99"
+
+
+def test_trust_and_value_change_do_not_grow_self_layer():
+    e = SpacetimeMemoryEngine(":memory:")
+    for i in range(50):
+        e.update_trust_state(0.5 + i * 0.005, i)
+    e.update_self({"current_goal": "g"})
+    e.record_value_change("诚实优先", "设计者确认")
+    e.record_value_change("诚实优先（细化）", "复核", replaces="诚实优先")
+    assert e.store.count_layer(MemoryLayer.SELF) == 2      # 自我当前态 + 信任当前态
+    nodes = {n.modality: n for n in e.store.get_layer_nodes(MemoryLayer.SELF)}
+    trust = json.loads(nodes["trust_state"].content)
+    assert trust["t_total"] == e.self_model.trust_state["t_total"] and trust["trust_history"][-1]["round"] == 49
+    assert len(trust["trust_history"]) == len(e.self_model.trust_history)  # 演化轨迹（有界）随当前态保存
+    selfd = json.loads(nodes["self_state"].content)
+    assert "诚实优先（细化）" in selfd["values"] and selfd["value_evolution"]
+
+
+def test_current_node_keeps_links_created_at_and_stays_unforgettable():
+    e = SpacetimeMemoryEngine(":memory:")
+    a = e.add_perception("关键经历甲：被纠正", importance=0.8, skip_dedup=True)
+    b = e.add_perception("关键经历乙：完成长期目标", importance=0.8, skip_dedup=True)
+    s1 = e.update_self({"current_goal": "从纠正中学习"}, link_to_node_id=a.id)
+    s2 = e.update_self({"current_goal": "继续"}, link_to_node_id=b.id)
+    assert s1.id == s2.id
+    targets = {x.target_id for x in e.store.get_outgoing_edges(s2.id)}
+    assert {a.id, b.id} <= targets                          # 旧快照的自我→经历边不因原地更新丢失
+    assert e.store.get_node(s2.id).created_at == s1.created_at
+    assert e.store.delete_node(s2.id) is False
