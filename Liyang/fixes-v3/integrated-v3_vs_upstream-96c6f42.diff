@@ -0,0 +1,45 @@
+"""回归：World3D._draw_box 只画朝向相机的面（新发现 world-n1）。
+
+修复前：固定顺序画全部 6 面，被遮的侧面/底面/顶面盖在可见的前面上；
+俯视近处立方体时前面区域只有 57.9% 像素是前面色，仰视时 63.2%。
+"""
+import pytest
+
+from lingshu.world.world3d import World3D, Object3D, Camera3D
+
+W, H = 400, 300
+C = (200, 100, 50)
+FRONT = tuple(min(255, int(v * 0.95)) for v in C)
+SIDE = tuple(min(255, int(v * 0.85)) for v in C)
+
+
+def _front_ratio(center, size=(1, 1, 1)):
+    w = World3D()
+    w.objects = [Object3D("crate", center=center, size=size, color=C)]
+    img = w.render(W, H, background=(0, 0, 0), ground_color=(0, 0, 0))
+    x, y, z = center
+    hw, hh, hd = (s / 2 for s in size)
+    ok = tot = 0
+    for i in range(1, 20):
+        for j in range(1, 20):
+            p = w.camera.project((x - hw + 2 * hw * i / 20, y - hh + 2 * hh * j / 20, z - hd), W, H)
+            if p is None or not (0 <= p[0] < W and 0 <= p[1] < H):
+                continue
+            tot += 1
+            ok += img.getpixel((int(p[0]), int(p[1]))) == FRONT
+    return ok / tot
+
+
+@pytest.mark.parametrize("center", [(0, 0.5, 2.5), (0, 2.0, 3.0)])
+def test_hidden_faces_do_not_cover_front_face(center):
+    assert _front_ratio(center) >= 0.95
+
+
+def test_visible_side_face_still_drawn():
+    """相机在盒子右侧时右侧面可见（剔除不能误删可见面）。"""
+    cam = Camera3D.look_at(eye=(3, 0.5, 0), target=(0, 0.5, 4))
+    w = World3D(camera=cam)
+    w.objects = [Object3D("crate", center=(0, 0.5, 4), size=(1, 1, 1), color=C)]
+    img = w.render(W, H, background=(0, 0, 0), ground_color=(0, 0, 0))
+    p = cam.project((0.5, 0.5, 4), W, H)        # 右侧面中心
+    assert img.getpixel((int(p[0]), int(p[1]))) == SIDE
