+# -*- coding: utf-8 -*-
+"""issue #222：D-007 盲区闭环的设计者密钥只在引擎门面，store 层两个方法无密钥可绕过。"""
+import pytest
+from lingshu.core.core import SpacetimeMemoryEngine
+
+
+@pytest.fixture
+def eng(monkeypatch):
+    monkeypatch.setenv("AEIS_DESIGNER_KEY", "k-real")
+    e = SpacetimeMemoryEngine(":memory:")
+    b1 = e.register_blindspot("BS-1", "未知领域 A", "high")
+    b2 = e.register_blindspot("BS-2", "未知领域 B", "high")
+    return e, b1, b2
+
+
+def _open(e):
+    return sorted(x["code"] for x in e.get_open_blindspots())
+
+
+def test_store_resolve_requires_key(eng):
+    e, b1, b2 = eng
+    with pytest.raises(PermissionError):
+        e.store.resolve_blindspot(b1)
+    with pytest.raises(PermissionError):
+        e.store.resolve_blindspot(b1, designer_key="wrong")
+    assert _open(e) == ["BS-1", "BS-2"]
+
+
+def test_store_update_status_requires_key_and_whitelist(eng):
+    e, b1, b2 = eng
+    with pytest.raises(PermissionError):
+        e.store.update_blindspot_status(b2, "resolved")
+    with pytest.raises((PermissionError, ValueError)):
+        e.store.update_blindspot_status(b2, "ignored")
+    with pytest.raises(ValueError):
+        e.store.update_blindspot_status(b2, "ignored", designer_key="k-real")
+    assert _open(e) == ["BS-1", "BS-2"]
+
+
+def test_legit_paths_still_work(eng):
+    e, b1, b2 = eng
+    with pytest.raises(PermissionError):
+        e.resolve_blindspot(b1, True)
+    assert e.resolve_blindspot(b1, True, designer_key="k-real") is True
+    e.store.update_blindspot_status(b2, "resolved", designer_key="k-real")
+    assert _open(e) == []
+    e.store.update_blindspot_status(b2, "open")      # 重开（扩大学习队列）不需密钥
+    assert _open(e) == ["BS-2"]
