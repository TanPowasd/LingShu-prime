diff --git a/tests/test_issue229_activation_opposite_not_excitatory.py b/tests/test_issue229_activation_opposite_not_excitatory.py
new file mode 100644
index 0000000..852a1b2
--- /dev/null
+++ b/tests/test_issue229_activation_opposite_not_excitatory.py
@@ -0,0 +1,38 @@
+# -*- coding: utf-8 -*-
+"""回归（issue #229）：OPPOSITE（矛盾）边不再作兴奋传导——被反驳的旧结论激活不高于任一反驳证据；
+给节点加一条指向它的 OPPOSITE 边，其激活不升高（scipy 与 edge-list 两条路径）。"""
+import os
+import pytest
+import lingshu.core.activation as A
+from lingshu.core.core import SpacetimeMemoryEngine
+
+
+def _setup(tmp_path, n_refs=3):
+    db = str(tmp_path / "m.db")
+    e = SpacetimeMemoryEngine(db)
+    claim = e.add_perception("旧结论：数据库 beta 主从复制正常", importance=0.6)
+    refs = [e.add_perception(t, importance=0.6) for t in (
+        "巡检记录一：beta 从库延迟持续升高，复制已中断",
+        "巡检记录二：beta 从库 IO 线程停止，复制已中断",
+        "巡检记录三：beta 从库报错 1236，复制已中断")[:n_refs]]
+    for r in refs:
+        e.store.register_conflict(r.id, claim.id)
+    return e, db, claim, refs
+
+
+@pytest.mark.parametrize("no_scipy", [False, True])
+def test_refuted_claim_not_lit_up(tmp_path, monkeypatch, no_scipy):
+    if no_scipy:
+        monkeypatch.setattr(A, "csr_matrix", None)
+    e, db, claim, refs = _setup(tmp_path)
+    act = A.ActivationEngine(db_path=db, audit_path=str(tmp_path / "a.jsonl"))
+    r = act.activate("beta 从库复制已中断 巡检记录", workset="w", hops=1)
+    top = dict(r["top"])
+    c = top.get(claim.id, 0.0)
+    assert all(c <= top.get(x.id, 0.0) for x in refs), r["top"]
+    # 性质：去掉矛盾边后的激活不低于有矛盾边时（OPPOSITE 不抬高对端）
+    e.store.conn.execute("DELETE FROM edges WHERE relation_type='opposite'")
+    e.store.conn.commit()
+    act2 = A.ActivationEngine(db_path=db, audit_path=str(tmp_path / "b.jsonl"))
+    c0 = dict(act2.activate("beta 从库复制已中断 巡检记录", workset="w2", hops=1)["top"]).get(claim.id, 0.0)
+    assert c <= c0 + 1e-9
