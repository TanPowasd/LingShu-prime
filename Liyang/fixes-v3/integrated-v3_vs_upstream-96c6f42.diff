+# -*- coding: utf-8 -*-
+"""回归：prefeed 新奇输入独立成节点，不被 M5 去重并入旧节点（issue 草稿 core-rest-02）。"""
+import warnings
+
+warnings.filterwarnings("ignore")
+from lingshu.core.core import SpacetimeMemoryEngine  # noqa: E402
+
+
+def test_prefeed_novel_input_not_merged_by_dedup():
+    e = SpacetimeMemoryEngine()
+    old = e.add_perception("哈哈", importance=0.3)
+    e.add_perception("今天天气很好适合出门散步", importance=0.5)
+    r = e.prefeed_input("哈哈哈哈哈", tags=["chat"])
+    assert r["action"] == "prefeed_boost"
+    assert r["node_id"] != old.id
+    n = e.store.get_node(r["node_id"])
+    assert n.content == "哈哈哈哈哈"
+    assert "novel_prefeed" in n.tags
+    assert abs(n.importance - r["importance"]) < 1e-3
+    # 旧节点未被打上 duplicate
+    assert "duplicate" not in (e.store.get_node(old.id).tags or [])
