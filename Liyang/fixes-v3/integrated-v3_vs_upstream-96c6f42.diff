@@ -0,0 +1,57 @@
+# -*- coding: utf-8 -*-
+"""回归（PR #27 / issue #289 存档件四）：wander 决策向量必须归一化——单 tick 位移不得超过声明的 speed；
+RNG 消耗次数与顺序不变；方向仍随机；wander 在时空一致性校验中仍走 bounded 且不新增 miss。"""
+import math
+import random
+
+from lingshu.world.scene_simulator import SceneSimulator
+from lingshu.world.spacetime_consistency import SpacetimeConsistency
+
+ROUND_EPS = math.hypot(0.005, 0.005)   # step() 每轴 round(v, 2)
+
+
+def _max_disp(speed, ticks=120):
+    s = SceneSimulator(size=24)
+    e = s.entities[s.add_entity("actor", behavior="wander", pos=(6.0, 0.5, 6.0), speed=speed)]
+    md = 0.0
+    for _ in range(ticks):
+        b = tuple(e.pos)
+        s.step(1)
+        md = max(md, math.hypot(e.pos[0] - b[0], e.pos[2] - b[2]))
+    return md
+
+
+def test_wander_respects_speed():
+    for sp in (0.1, 0.3, 0.5, 1.0, 2.0, 5.0):
+        assert _max_disp(sp) <= sp + ROUND_EPS, sp
+
+
+def test_wander_direction_unit_and_random():
+    s = SceneSimulator(size=24)
+    e = s.entities[s.add_entity("actor", behavior="wander", pos=(6.0, 0.5, 6.0), speed=0.3)]
+    dirs = [s._decide(e) for _ in range(200)]
+    assert all(abs(math.hypot(d[0], d[2]) - 1.0) < 1e-9 for d in dirs)
+    assert len({(round(d[0], 6), round(d[2], 6)) for d in dirs}) > 100
+    assert len({(d[0] > 0, d[2] > 0) for d in dirs}) == 4
+
+
+def test_wander_rng_stream_unchanged():
+    s = SceneSimulator(size=24)
+    w = s.add_entity("actor", behavior="wander", pos=(2.0, 0.5, 2.0), speed=0.3)
+    s.add_entity("actor", behavior="flee", pos=(4.0, 0.5, 4.0), speed=0.3, goal=w)
+    ref = random.Random(42)
+    for _ in range(10):
+        s.step(1)
+        ref.uniform(-1, 1); ref.uniform(-1, 1); ref.uniform(-0.1, 0.1); ref.uniform(-0.1, 0.1)
+    assert s._rng.random() == ref.random()
+
+
+def test_wander_still_bounded_no_miss():
+    stc = SpacetimeConsistency(size=24)
+    stc.create_scene(trees=2, water=False)
+    eid = stc.add_entity("actor", behavior="wander", pos=(6.0, 0.5, 6.0), speed=0.3)
+    modes, miss = set(), 0
+    for _ in range(120):
+        oc = next(d for d in stc.step_verified()["outcomes"] if d["entity"] == eid)
+        modes.add(oc["mode"]); miss += (not oc["hit"])
+    assert modes == {"bounded"} and miss == 0
