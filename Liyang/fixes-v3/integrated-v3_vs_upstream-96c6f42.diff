@@ -0,0 +1,66 @@
+# -*- coding: utf-8 -*-
+"""回归（issue #253）：包内每个第三方 import 都在某个 extra 里声明；world extra 覆盖 world 自身
+渲染路径（Pillow）；子包 X 的第三方依赖 ⊆ extra X（world/nn/gen 有同名 extra 时）。"""
+import ast
+import os
+import re
+import sys
+import tomllib
+
+ROOT = os.path.join(os.path.dirname(__file__), "..")
+DIST = {"PIL": "pillow"}           # import 名 → 发行包名（小写）
+
+
+def _extras():
+    with open(os.path.join(ROOT, "pyproject.toml"), "rb") as f:
+        opt = tomllib.load(f)["project"]["optional-dependencies"]
+    return {k: {re.split(r"[<>=!~;\[ ]", r, 1)[0].strip().lower() for r in v} for k, v in opt.items()}
+
+
+def _third_party_imports():
+    from lingshu.core.component_resolver import COMPONENT_NAMES
+    std = set(sys.stdlib_module_names)
+    out = {}
+    pkg = os.path.join(ROOT, "lingshu")
+    for root, dirs, files in os.walk(pkg):
+        local = {f[:-3] for f in files if f.endswith(".py")} | set(dirs)
+        for fn in files:
+            if not fn.endswith(".py"):
+                continue
+            path = os.path.join(root, fn)
+            sub = os.path.relpath(path, pkg).split(os.sep)[0]
+            for n in ast.walk(ast.parse(open(path, encoding="utf-8").read())):
+                names = []
+                if isinstance(n, ast.Import):
+                    names = [a.name for a in n.names]
+                elif isinstance(n, ast.ImportFrom) and n.level == 0 and n.module:
+                    names = [n.module]
+                for nm in names:
+                    top = nm.split(".")[0]
+                    if top in std or top == "lingshu" or top in local or top in COMPONENT_NAMES:
+                        continue
+                    out.setdefault(DIST.get(top, top.lower()), set()).add(sub)
+    return out
+
+
+def test_every_third_party_import_declared():
+    declared = set().union(*_extras().values())
+    missing = {d: sorted(s) for d, s in _third_party_imports().items() if d not in declared}
+    assert not missing, f"未在任何 extra 声明的第三方依赖: {missing}"
+
+
+def test_world_extra_has_pillow():
+    assert "pillow" in _extras()["world"]
+
+
+def test_subpackage_deps_within_same_named_extra():
+    ex = _extras()
+    optional = {"scipy", "pyarrow", "torch", "diffusers"}   # 可选能力面，另有专门 extra
+    bad = {}
+    for dist, subs in _third_party_imports().items():
+        if dist in optional:
+            continue
+        for sub in subs:
+            if sub in ex and dist not in ex[sub]:
+                bad.setdefault(sub, []).append(dist)
+    assert not bad, bad
