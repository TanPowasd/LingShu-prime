+"""回归：World3D 画家排序与球半径须用相机深度而非世界 z（issue 草稿 world-02）。
+
+修复前：相机 look_at 从 z=20 回看原点时，远处蓝盒盖住近处红盒（中心像素 (0,0,242)）；
+距相机 5m 的球渲染直径 23px（透视应为 ≈69px）。
+"""
+from lingshu.world.world3d import World3D, Object3D, Camera3D
+
+W, H = 400, 300
+
+
+def test_near_box_occludes_far_box_with_reversed_camera():
+    cam = Camera3D.look_at(eye=(0, 1.2, 20), target=(0, 1.2, 0))
+    w = World3D(camera=cam)
+    w.objects = [Object3D("redbox", center=(0, 1.2, 10), size=(2, 2, 2), color=(255, 0, 0)),
+                 Object3D("bluebox", center=(0, 1.2, 2), size=(6, 6, 2), color=(0, 0, 255))]
+    r, g, b = w.render(W, H).getpixel((W // 2, H // 2))
+    assert r > 200 and b < 50, (r, g, b)
+
+
+def test_sphere_radius_uses_camera_depth():
+    cam = Camera3D.look_at(eye=(0, 1.2, 20), target=(0, 1.2, 0))
+    w = World3D(camera=cam)
+    w.objects = [Object3D("ball", center=(0, 1.2, 15), size=(1, 1, 1),
+                          color=(0, 255, 0), shape="sphere")]
+    img = w.render(W, H, background=(0, 0, 0), ground_color=(0, 0, 0))
+    xs = [x for x in range(W) if img.getpixel((x, H // 2))[1] > 100]
+    diam = max(xs) - min(xs)
+    expect = 2 * cam.focal(W) * 0.5 / 5.0
+    assert abs(diam - expect) <= 3, (diam, expect)
+
+
+def test_default_camera_depth_unchanged():
+    """默认相机（原点、朝 +z）下相机深度 == 世界 z：旧行为不变。"""
+    o = Object3D("x", center=(1.0, 3.0, 7.5), size=(1, 1, 1), color=(1, 1, 1))
+    assert Camera3D().view_depth(o.center) == 7.5
+    assert o.depth(Camera3D()) == o.depth() == 7.5
