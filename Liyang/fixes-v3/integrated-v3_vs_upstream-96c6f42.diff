+
+from lingshu.core.core import SpacetimeMemoryEngine
+from lingshu.core.world_facade import WorldFacadeMixin
+
+# 2bb8291 lingshu/core/core.py 中原方法源码（含 4 空格类内缩进）的 sha256
+BASELINE_SHA256 = {
+    "world3d": "8704ff3adef90d6fffe0f754d9e21c570e446febdf358fc63c83101e05208239",  # issue #211 有意修改 build（真实位姿/物体计数）；#277 render 输出路径限定渲染根；#262 verify 拒绝未知锚点，非搬移夹带
