@@ -0,0 +1,63 @@
+# -*- coding: utf-8 -*-
+"""issue #212：record_value_change 把整个价值观列表替换为单条；修正不落快照；value_evolution 无界。"""
+import json
+import pytest
+from lingshu.core.core import SpacetimeMemoryEngine, MemoryLayer, SelfModel
+
+
+def test_refine_one_value_keeps_others():
+    sm = SelfModel()
+    sm.record_value_change("信任深化（含对用户纠错的开放）", trigger="复核：细化", replaces="信任深化")
+    assert sm.values == ["存在优先", "信任深化（含对用户纠错的开放）", "结构完整"]
+    changed = [(r["value"], r["from"], r["to"]) for r in sm.value_evolution]
+    assert changed == [("信任深化", True, False), ("信任深化（含对用户纠错的开放）", False, True)]
+
+
+def test_add_value_does_not_reset_list():
+    sm = SelfModel()
+    sm.record_value_change("诚实", trigger="新增")
+    assert sm.values == ["存在优先", "信任深化", "结构完整", "诚实"]
+
+
+def test_same_value_is_noop():
+    sm = SelfModel()
+    assert sm.record_value_change("结构完整", trigger="重复") is False
+    assert sm.value_evolution == []
+    assert sm.values == ["存在优先", "信任深化", "结构完整"]
+
+
+def test_replaces_unknown_value_rejected():
+    sm = SelfModel()
+    with pytest.raises(ValueError):
+        sm.record_value_change("新值", trigger="t", replaces="不存在的价值观")
+    assert sm.values == ["存在优先", "信任深化", "结构完整"]
+
+
+def test_retire_value():
+    sm = SelfModel()
+    assert sm.retire_value("存在优先", trigger="复核撤销") is True
+    assert sm.values == ["信任深化", "结构完整"]
+    assert sm.value_evolution[-1]["value"] == "存在优先" and sm.value_evolution[-1]["to"] is False
+
+
+def test_evolution_bounded():
+    sm = SelfModel()
+    prev = "结构完整"
+    for i in range(1000):
+        sm.record_value_change(f"结构完整v{i}", trigger=f"t{i}", replaces=prev)
+        prev = f"结构完整v{i}"
+    assert len(sm.value_evolution) <= SelfModel.VALUE_EVOLUTION_MAX
+    assert sm.values == ["存在优先", "信任深化", "结构完整v999"]
+
+
+def test_engine_value_change_writes_snapshot():
+    e = SpacetimeMemoryEngine(":memory:")
+    before = e.store.count_layer(MemoryLayer.SELF)
+    assert e.record_value_change("信任深化（含纠错）", trigger="复核", replaces="信任深化") is True
+    nodes = e.store.get_layer_nodes(MemoryLayer.SELF)
+    assert len(nodes) == before + 1
+    snap = json.loads(max(nodes, key=lambda n: n.temporal_coordinate).content)
+    assert snap["values"] == ["存在优先", "信任深化（含纠错）", "结构完整"]
+    # 同值重复：不落新快照
+    assert e.record_value_change("结构完整", trigger="重复") is False
+    assert e.store.count_layer(MemoryLayer.SELF) == before + 1
