+"""回归：World3D 组合形状部件按画家序绘制（新发现 world-n2）。
+
+修复前：部件按 SHAPE_LIBRARY 定义顺序绘制，身体后方的腿盖在身体上（dog），
+桌面后方的桌腿盖在桌面上（table）。
+"""
+from lingshu.world.world3d import World3D, Object3D, default_spec
+from lingshu.world.shapes import get_shape
+
+W, H = 400, 300
+
+
+def _render(cat, center):
+    s = default_spec(cat)
+    w = World3D()
+    w.objects = [Object3D(cat, center=center, size=s.size, color=s.color, shape=s.shape)]
+    return w, w.render(W, H, background=(0, 0, 0), ground_color=(0, 0, 0))
+
+
+def _shade(c, k):
+    return tuple(min(255, int(v * k)) for v in c)
+
+
+def test_far_leg_hidden_behind_dog_body():
+    center = (0, 0.3, 2.0)
+    w, img = _render("dog", center)
+    parts = get_shape("dog")
+    leg, body = parts[2], parts[0]          # leg dz=+0.2（身体后方）
+    p3 = (center[0] + leg["pos"][0], center[1] + leg["pos"][1] + leg["size"][1] / 3,
+          center[2] + leg["pos"][2])
+    p = w.camera.project(p3, W, H)
+    px = img.getpixel((int(p[0]), int(p[1])))
+    assert px != _shade(leg["color"], 0.95), px            # 修复前 = 腿色 (114,95,76)
+    assert px == _shade(body["color"], 0.95), px            # 应为身体前面色
+
+
+def test_nested_parts_not_flipped_tree():
+    """嵌套部件（树干插入树冠）：树冠底部仍覆盖树干（最近点距离键，不按中心）。"""
+    s = default_spec("tree")
+    center = (0, s.size[1] / 2, 8)
+    w, img = _render("tree", center)
+    p = w.camera.project((0, center[1] + 1.6, 7.5), W, H)
+    assert img.getpixel((int(p[0]), int(p[1]))) == get_shape("tree")[1]["color"]
