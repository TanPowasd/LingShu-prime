+"""回归 issue #232：fit()['gap_plain'] 不得被成对判别门循环覆写；成对 d′ 分母为合并标准差。"""
+import numpy as np
+from lingshu.gen import hexgen_c1_real as C
+
+
+def _img(shape, pattern, size=64, color=(210., 40., 40.)):
+    yy, xx = np.mgrid[0:size, 0:size]; c = (size - 1) / 2.0
+    img = np.full((size, size, 3), 255.0)
+    if shape == "circle":
+        m = (yy - c) ** 2 + (xx - c) ** 2 <= 13 ** 2
+    elif shape == "square":
+        m = (np.abs(yy - c) <= 11) & (np.abs(xx - c) <= 11)
+    else:
+        m = (yy > c - 12) & (np.abs(xx - c) <= (yy - (c - 12)))
+    img[m] = color
+    if pattern == "striped":
+        img[m & (np.sin(xx * 2 * np.pi / 6.0) > 0)] = (120., 20., 20.)
+    return img
+
+
+def test_gap_plain_is_declared_pattern_gap():
+    specs = [("circle", "plain", "red"), ("circle", "striped", "red"),
+             ("square", "plain", "blue"), ("square", "striped", "blue"),
+             ("triangle", "plain", "red"), ("triangle", "striped", "red")]
+    items = [{"file": f"syn_{i}.png", "id": i, "shape": s, "color": co, "img": _img(s, p),
+              "truth": {"n": 1, "color": co, "pattern": p, "shape": s,
+                        "zone_text": "center", "cells": {"r4"}},
+              "prompt": f"flat vector illustration, one {co} {s}(s) in the center"}
+             for i, (s, p, co) in enumerate(specs)]
+    m = {"items": items, "d": 6,
+         "by_id": {it["id"]: C.measure_item(it, tol=C.TOL, d=6)[0] for it in items}}
+    fit = C.fit(m, {it["id"] for it in items})
+    tex = {}
+    for it in items:
+        for o in m["by_id"][it["id"]]:
+            tex.setdefault(it["truth"]["pattern"], []).append(o["hp_rel"])
+    true_gap = round(min(tex["striped"]) - max(tex["plain"]), 6)
+    assert fit["gap_plain"] == true_gap
+
+
+def test_pair_dprime_uses_pooled_sd():
+    import inspect
+    src = inspect.getsource(C.fit)
+    # 合并标准差 sqrt((var_a+var_b)/2)，不是 (sqrt(var_a+var_b)/2)**0.5
+    assert "/ 2.0) ** 0.5" not in src
