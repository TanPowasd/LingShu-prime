+"""issue #221：add_vprim 天空物体（ground=False）。相机位姿部分已由 78596f7（world-03）覆盖；
+本件补「地平线钳制」：旧钳制在相机系里把 Yc 抬到 0.55·H/2 像素对应高度以上，
+地平线以上 100px 的苹果（bbox 中心 y=200）被重投影到 y≈136，屏幕正中的苹果也被抬到 136。"""
+import pytest
+
+from lingshu.world.world3d import World3D, Camera3D
+from lingshu.world.vprim import VPrim
+
+W, H = 800, 600
+CAMS = [Camera3D(), Camera3D(cx=5.0), Camera3D(yaw=0.5), Camera3D(pitch=0.3)]
+
+
+@pytest.mark.parametrize("cam", CAMS, ids=["default", "cx5", "yaw", "pitch"])
+@pytest.mark.parametrize("cy_px", [50, 120, 200, 260])
+def test_sky_object_above_horizon_round_trips(cam, cy_px):
+    obj = World3D(camera=cam).add_vprim(VPrim("apple", (390, cy_px - 10, 410, cy_px + 10), 0.9), W, H)
+    p = cam.project(obj.center, W, H)
+    assert p is not None
+    assert abs(p[0] - 400) < 1.0 and abs(p[1] - cy_px) < 1.0, (p, obj.center)
+
+
+def test_sky_object_below_horizon_is_lifted_to_horizon():
+    # 「不低于地平线」的约定保留：地平线像素 = H*horizon_ratio = 270
+    w = World3D()
+    obj = w.add_vprim(VPrim("apple", (390, 390, 410, 410), 0.9), W, H)
+    p = w.camera.project(obj.center, W, H)
