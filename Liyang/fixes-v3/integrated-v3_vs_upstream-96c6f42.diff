+# -*- coding: utf-8 -*-
+"""回归：compile_description 不得把方位词/花纹词里的「心」「方」「条」当形状词（issue 草稿 nn-02）。"""
+import pytest
+
+from lingshu.nn.hex_gen import DEFAULTS, ZONE_CN, compile_description
+from lingshu.nn.hex_text import POS_WORDS
+
+_POS_SURFACES = sorted(set(POS_WORDS) | set(ZONE_CN) | {w + "方" for w in ZONE_CN})
+
+
+@pytest.mark.parametrize("pos", _POS_SURFACES)
+def test_position_word_contributes_no_shape(pos):
+    c = compile_description(f"{pos}有红色")
+    assert c["parts"][0]["shape"] == DEFAULTS["shape"], (pos, c["parts"])
+    assert any(d["field"] == "shape" for d in c["defaults_applied"]), (pos, c)
+
+
+@pytest.mark.parametrize("text,shape,zone", [
+    ("中心有蓝色菱形", "diamond", "r4"),
+    ("右下方有蓝色菱形", "diamond", "r8"),
+    ("下方有红色星", "star", "r7"),
+    ("中心有红色圆形", "circle", "r4"),
+])
+def test_explicit_shape_survives_position_word(text, shape, zone):
+    p = compile_description(text)["parts"][0]
+    assert (p["shape"], p["zone"]) == (shape, zone), p
+
