+"""issue #229 探针：OPPOSITE（矛盾）边按兴奋传导，被三条证据反驳的旧结论激活值排第一。"""
+import os, tempfile, warnings; warnings.filterwarnings("ignore")
+import lingshu.core.activation as A
+from lingshu.core.core import SpacetimeMemoryEngine
+d = tempfile.mkdtemp(); db = os.path.join(d, "m.db")
+e = SpacetimeMemoryEngine(db)
+claim = e.add_perception("旧结论：数据库 beta 主从复制正常", importance=0.6)
+refs = [e.add_perception(t, importance=0.6) for t in ("巡检记录一：beta 从库延迟持续升高，复制已中断",
+        "巡检记录二：beta 从库 IO 线程停止，复制已中断", "巡检记录三：beta 从库报错 1236，复制已中断")]
+for r in refs:
+    e.store.register_conflict(r.id, claim.id)
+act = A.ActivationEngine(db_path=db, audit_path=os.path.join(d, "a.jsonl"))
+top = dict(act.activate("beta 从库复制已中断 巡检记录", workset="w", hops=1)["top"])
+c = top.get(claim.id, 0.0); m = min(top.get(x.id, 0.0) for x in refs)
+# 对照：同库去掉矛盾边后的激活（矛盾边不应抬高被反驳结论）
+e.store.conn.execute("DELETE FROM edges WHERE relation_type='opposite'"); e.store.conn.commit()
+act2 = A.ActivationEngine(db_path=db, audit_path=os.path.join(d, "b.jsonl"))
+c0 = dict(act2.activate("beta 从库复制已中断 巡检记录", workset="w2", hops=1)["top"]).get(claim.id, 0.0)
+print("scipy" if A.csr_matrix else "edge-list", "| 旧结论激活:", c, "(无矛盾边对照", c0, ") | 反驳证据最低激活:", m)
+print("OK" if c <= m and c <= c0 + 1e-9 else "BUG 被反驳结论经矛盾边被点亮")
