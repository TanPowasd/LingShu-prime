+++ b/tests/test_issue206_trust_state_range.py
@@ -0,0 +1,54 @@
+# -*- coding: utf-8 -*-
+"""回归（issue #206）：t_total 的 NaN/inf 被 update_trust_state 拒绝；门控把信任钳到 [0,1]，
+t_total≥2 / 42 / 被旁路写入的 NaN 都不能让低价值闲聊快照入长期层并加不可遗忘保护。"""
+import warnings
+
+import pytest
+
+warnings.filterwarnings("ignore")
+from lingshu.core.core import SpacetimeMemoryEngine  # noqa: E402
+
+CHATS = ["今天天气不错随便聊聊", "用户随口说了句无关紧要的话哈哈", "测试测试一二三四五"]
+
+
+def _run(T, bypass=False):
+    e = SpacetimeMemoryEngine(":memory:")
+    for t in ["水在标准大气压下100度沸腾。", "地球绕太阳公转一周约一年。"]:
+        e.add_perception(t)
+    if T is not None:
+        if bypass:
+            e.self_model.trust_state["t_total"] = T
+        else:
+            e.update_trust_state(T, 1)
+    out = [e.longterm_snapshot(s) for s in CHATS]
+    prot = e.store.conn.execute("select count(*) from protections").fetchone()[0]
+    return out, prot
+
+
