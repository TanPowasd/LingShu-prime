+"""回归：World3D.add_vprim 反投影须计入相机位姿（issue 草稿 world-03）。
+
+不变量：非贴地物体 project(add_vprim(bbox).center) ≈ bbox 中心；贴地物体只改世界 Y，
+水平像素位置仍应对齐、且物体在相机前方。
+修复前：cx=5 相机重投影偏到 x=-99.9；相机朝 -z 时返回 None；默认相机 balloon 纵向偏 48px。
+"""
+import pytest
+
+from lingshu.world.world3d import World3D, Camera3D
+from lingshu.world.vprim import VPrim
+
+W, H = 800, 600
+CAMS = {
+    "translate_cx5": Camera3D(cx=5.0, cy=1.2, cz=0.0),
+    "look_neg_z": Camera3D.look_at(eye=(0, 1.2, 0), target=(0, 1.2, -10)),
+    "default": Camera3D(),
+    "yaw_pitch": Camera3D.look_at(eye=(3, 2.0, -4), target=(-2, 0.5, 6)),
+}
+
+
+@pytest.mark.parametrize("name", list(CAMS))
+def test_sky_object_round_trip(name):
+    cam = CAMS[name]
+    obj = World3D(camera=cam).add_vprim(VPrim("balloon", (390, 40, 410, 60)), W, H)
+    p = cam.project(obj.center, W, H)
+    assert p is not None, obj.center
+    assert abs(p[0] - 400) < 1.0 and abs(p[1] - 50) < 1.0, p
+
+
+@pytest.mark.parametrize("name", list(CAMS))
+def test_ground_object_in_front_and_horizontally_aligned(name):
+    cam = CAMS[name]
+    obj = World3D(camera=cam).add_vprim(VPrim("dog", (360, 280, 440, 360)), W, H)
+    p = cam.project(obj.center, W, H)
+    assert p is not None, obj.center              # 修复前 look_neg_z: 落在相机背后
+    if cam.pitch == 0.0:                          # 无俯仰时贴地只改竖直方向
+        assert abs(p[0] - 400) < 1.0, p
