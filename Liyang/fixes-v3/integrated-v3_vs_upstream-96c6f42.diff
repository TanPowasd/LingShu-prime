+def test_issue145_guard_all_groups():
+    """pytest 入口（issue #203）：脚本式 A–E 组整体跑一遍，任一断言失败即红。
+
+    gate.yml 以脚本方式执行本件（SCRIPT_TESTS）；本包装让「pytest tests/」式门禁
+    同样覆盖，不再收集 0 条。"""
+    _PASS.clear()
+    _FAIL.clear()
+    assert main() == 0, _FAIL
+
+
 if __name__ == "__main__":
     sys.exit(main())
