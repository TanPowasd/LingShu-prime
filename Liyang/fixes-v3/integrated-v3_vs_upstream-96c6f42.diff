+# -*- coding: utf-8 -*-
+"""issue #279：非 dict 的 spatial_coordinates（向量/None/标量/列表）写入后，重启构造不得崩。"""
+import os, tempfile, warnings
+warnings.filterwarnings("ignore")
+import pytest
+from lingshu.core.core import SpacetimeMemoryEngine, STNode, ConditionSpace, Role
+
+
+def _db():
+    return os.path.join(tempfile.mkdtemp(), "brain.db")
+
+
+@pytest.mark.parametrize("role", [Role.PRIMARY, Role.SUB])
+def test_vector_coords_survive_restart(role):
+    db = _db()
+    e = SpacetimeMemoryEngine(db)
+    e.set_anchor("存在优先")
+    n = e.add_perception("机械臂末端停在工作台左上角", spatial_coordinates=[0.12, 0.40, 0.95])
+    e.close()
+    e2 = SpacetimeMemoryEngine(db, role=role)  # 不得抛异常
+    assert e2.store.get_node(n.id) is not None
+    e2.close()
+
+
+@pytest.mark.parametrize("sp", [None, 5, ["protocol_x"]])
+def test_other_nondict_coords_survive_restart(sp):
+    db = _db()
+    e = SpacetimeMemoryEngine(db)
+    e.store.add_node(STNode(id="x1", content="c", modality="text", spatial_coordinates=sp,
+                            temporal_coordinate=1.7e9,
+                            condition_space=ConditionSpace("p", "t", (0, 1), "e")))
+    e.close()
