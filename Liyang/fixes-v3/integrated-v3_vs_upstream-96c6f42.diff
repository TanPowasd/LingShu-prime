+# -*- coding: utf-8 -*-
+"""issue #191：SELF 层不可遗忘但属本地层——SUB 实例可写自己的自我层；共享层（锚点/结构）仍仅 PRIMARY。"""
+import os
+import time
+import warnings
+
+import pytest
+
+from lingshu.core.core import (ConditionSpace, MemoryLayer, Role, SpacetimeMemoryEngine, STNode)
+
+warnings.filterwarnings("ignore")
+
+
+@pytest.fixture
+def sub(tmp_path):
+    e = SpacetimeMemoryEngine(os.path.join(str(tmp_path), "s.db"), role=Role.SUB)
+    yield e
+    e.close()
+
+
+def _node(layer):
+    now = time.time()
+    return STNode(id=f"n_{layer.value}_{now}", content="x", modality="text", spatial_coordinates={},
+                  temporal_coordinate=now,
+                  condition_space=ConditionSpace("p", "t", (now, now + 1), "c"), layer=layer)
+
+
+def test_sub_can_write_own_self_layer(sub):
+    n0 = sub.store.count_layer(MemoryLayer.SELF)
+    sub.update_self({"current_goal": "子实例目标"})
+    for i in range(5):
+        sub.update_trust_state(float(i * i), i)
+    # issue #201：自我/信任各一个当前节点原地更新（不再每次调用新增节点）
+    assert sub.store.count_layer(MemoryLayer.SELF) == n0 + 2
+    import json
+    assert json.loads(sub.store.get_node(sub.TRUST_CURRENT_ID).content)["t_total"] == 16.0
+    assert sub.self_model.current_goal == "子实例目标"
+    assert len(sub.self_model.trust_history) == 5
+
+
+def test_sub_self_snapshot_can_link_local_node(sub):
+    k = sub.add_perception("子实例的本地经验", skip_dedup=True)
+    snap = sub.update_self({"current_goal": "从经验学习"}, link_to_node_id=k.id)
+    assert any(e.target_id == k.id for e in sub.store.get_outgoing_edges(snap.id))
+
+
+@pytest.mark.parametrize("layer", [MemoryLayer.ANCHOR, MemoryLayer.STRUCTURE])
+def test_sub_still_cannot_write_shared_layers(sub, layer):
+    with pytest.raises(PermissionError):
+        sub.store.add_node(_node(layer))
+
+
+def test_self_layer_still_unforgettable(sub):
+    snap = sub.update_self({"current_goal": "g"})
+    assert sub.store.delete_node(snap.id) is False
+    for _ in range(50):
+        sub.store.decay_cycle()
+    assert sub.store.get_node(snap.id) is not None
+
+
+def test_trust_snapshot_failure_rolls_back(sub, monkeypatch):
+    sub.update_trust_state(0.3, 1)
+    before = (dict(sub.self_model.trust_state), list(sub.self_model.trust_history))
+    monkeypatch.setattr(sub.store, "add_node", lambda *a, **k: (_ for _ in ()).throw(RuntimeError("disk")))
+    with pytest.raises(RuntimeError):
+        sub.update_trust_state(0.9, 2)
+    assert (sub.self_model.trust_state, sub.self_model.trust_history) == before
