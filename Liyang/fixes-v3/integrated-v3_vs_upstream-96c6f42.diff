+# -*- coding: utf-8 -*-
+"""回归（issue #227）：脑侧 MCP 子进程 / rust 可执行文件不继承 AEIS_DESIGNER_KEY。"""
+import subprocess
+import sys
+import textwrap
+
+FAKE = textwrap.dedent('''
+    import sys, json, os
+    for line in sys.stdin:
+        req = json.loads(line)
+        if req.get("method") == "initialize":
+            print(json.dumps({"jsonrpc": "2.0", "id": req["id"], "result": {"serverInfo": {
+                "name": "fake", "leak": os.environ.get("AEIS_DESIGNER_KEY")}}}), flush=True)
+''')
+
+
+def test_brain_env_drops_designer_key(monkeypatch):
+    from lingshu.world.brain_store import _brain_env
+    monkeypatch.setenv("AEIS_DESIGNER_KEY", "k-real")
+    monkeypatch.setenv("SOME_OTHER_VAR", "x")
+    env = _brain_env(None, "/tmp")
+    assert "AEIS_DESIGNER_KEY" not in env
+    assert env["SOME_OTHER_VAR"] == "x" and env["PYTHONPATH"] == "/tmp"
+
+
+def test_brain_subprocess_does_not_see_designer_key(tmp_path):
+    srv = tmp_path / "fake_brain.py"
+    srv.write_text(FAKE, encoding="utf-8")
+    code = ("import os\nos.environ['AEIS_DESIGNER_KEY']='k-real'\n"
+            "from lingshu.world.brain_store import MCPClient\n"
+            f"c = MCPClient(pythonpath={str(tmp_path)!r}, args=[{str(srv)!r}])\n"
+            "print('LEAK', c.server_info.get('leak'))\nc._p.kill()\n")
+    out = subprocess.run([sys.executable, "-c", code], capture_output=True, text=True, timeout=20)
+    assert "LEAK None" in out.stdout, out.stdout + out.stderr[-300:]
+
+
+def test_rust_bridge_env_drops_designer_key(monkeypatch, tmp_path):
+    np = __import__("pytest").importorskip("numpy")
