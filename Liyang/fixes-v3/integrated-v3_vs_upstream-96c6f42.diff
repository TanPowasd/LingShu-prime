@@ -0,0 +1,51 @@
+# -*- coding: utf-8 -*-
+"""回归：hex_recon.reconstruct 的复原结果不得依赖区域扫描序（issue 草稿 nn-05）。
+用 32×32 + 奇数边长 5 的方块（#152 的取整偏移在这组参数上为 0）；其余位置用「连接顺序置换不变」
+判据，与 #152 的取整误差解耦。"""
+import itertools
+
+import numpy as np
+import pytest
+
+from lingshu.nn.hex_recon import extract_regions, pixel_accuracy, reconstruct, regions_to_connections
+
+
+def _conns(img):
+    regs, _ = extract_regions(img)
+    return regions_to_connections(regs, img.shape)
+
+
+def _square(y0, x0, n=32, wd=5):
+    img = np.full((n, n, 3), 200, np.uint8)
+    img[y0:y0 + wd, x0:x0 + wd] = (200, 40, 40)
+    return img
+
+
+def _frame_at_origin():
+    # 1px 红框占住 (0,0)，框内灰色间隙，再内蓝块；框的像素数少于蓝块，
+    # 「像素数降序」也会画错，只有按包含关系（包围盒面积）才对。
+    img = np.full((32, 32, 3), 200, np.uint8)
+    img[0:21, 0:21] = (200, 40, 40)
+    img[1:20, 1:20] = (200, 200, 200)
+    img[2:19, 2:19] = (40, 60, 220)
+    return img
+
+
+def test_square_at_origin_is_restored():
+    img = _square(0, 0)
+    assert pixel_accuracy(img, reconstruct(_conns(img))) == 1.0
+
+
+def test_nested_frame_at_origin_is_restored():
+    img = _frame_at_origin()
+    assert pixel_accuracy(img, reconstruct(_conns(img))) == 1.0
+
+
+@pytest.mark.parametrize("img", [_square(0, 0), _square(13, 13), _square(0, 27), _square(27, 0),
+                                 _frame_at_origin()],
+                         ids=["origin", "inner", "top-right", "bottom-left", "frame"])
+def test_reconstruct_is_order_invariant(img):
+    c = _conns(img)
+    ref = reconstruct(c)
+    for perm in itertools.permutations(c["connections"]):
+        assert np.array_equal(reconstruct({**c, "connections": list(perm)}), ref)
