+# -*- coding: utf-8 -*-
+"""回归（issue #263）：run_maintenance_cycle 不再把运行统计写成知识节点；未复核概念不被维护周期演练提权；
+无新输入时连续维护不增长节点数。"""
+import os
+from lingshu.core.core import SpacetimeMemoryEngine
+
+
+def _n(e, where):
+    return e.store.conn.execute("SELECT count(*) FROM nodes WHERE " + where).fetchone()[0]
+
+
+def test_no_consolidation_log_nodes_and_stable_size(tmp_path):
+    e = SpacetimeMemoryEngine(str(tmp_path / "m.db"))
+    for i in range(6):
+        e.add_perception(f"用户学日语五十音进度，第{i}次补充：细节编号{i * 37}", importance=0.5)
+    e.run_maintenance_cycle()
+    base = _n(e, "1=1")
+    for _ in range(30):
+        e.run_maintenance_cycle()
+    assert _n(e, "content LIKE '[consolidation]%'") == 0
+    assert _n(e, "1=1") == base
+    assert e.store.conn.execute(
+        "SELECT count(*) FROM action_logs WHERE action_type='consolidation'").fetchone()[0] >= 31
+
+
+def test_pending_concepts_not_rehearsed_to_one(tmp_path):
+    e = SpacetimeMemoryEngine(str(tmp_path / "m.db"))
+    c = e.add_perception("[概念] 测试概念", importance=0.75,
+                         tags=["concept", "induced", "pending_verification"])
+    for _ in range(30):
+        e.consolidate_cycle()
+    assert abs(e.store.get_node(c.id).importance - 0.75) < 1e-9
