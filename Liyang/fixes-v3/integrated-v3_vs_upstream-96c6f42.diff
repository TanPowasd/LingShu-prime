+"""issue #196（world/gen/nn 侧）：阈值链 + 末尾兜底成功态，NaN 比较恒 False ⇒ 损坏数值被判「通过」。
+覆盖 nn/hex_composite.judge_density 与 world/stable_lease；core/verdict 侧见 REPORT 清单（不在本线修）。"""
+import math
+
+import pytest
+
+from lingshu.nn.hex_composite import judge_density
+from lingshu.world.stable_lease import StableLease
+
+NAN, INF = float("nan"), float("inf")
+M = {"score": 1.0, "composite": {"x": 1}}
+
+
+@pytest.mark.parametrize("density", [NAN, INF, -INF])
+def test_judge_density_non_finite_density_not_accept(density):
+    assert judge_density(M, density, 0.5)["state"] != "ACCEPT"
+
+
+def test_judge_density_nan_threshold_or_score_not_accept():
+    assert judge_density(M, 0.9, NAN)["state"] != "ACCEPT"
+    assert judge_density({"score": NAN, "composite": {"x": 1}}, 0.9, 0.5)["state"] != "ACCEPT"
+
+
+def test_judge_density_controls_unchanged():
+    assert judge_density(M, 0.1, 0.5)["state"] == "DEFER"
+    assert judge_density(M, 0.9, 0.5) == {"state": "ACCEPT", "composite": {"x": 1}, "density": 0.9}
+
+
+def test_stable_lease_nan_ttl_rejected():
+    with pytest.raises(ValueError):
+        StableLease().acquire("k", ttl=NAN, confidence=1.0)
+    with pytest.raises(ValueError):
+        StableLease(ttl=NAN)
+
+
+def test_stable_lease_nan_confidence_rejected():
+    with pytest.raises(ValueError):
+        StableLease().acquire("k", ttl=10.0, confidence=NAN)
+    sl = StableLease(); sl.acquire("k", ttl=10.0)
+    with pytest.raises(ValueError):
+        sl.renew("k", confidence=NAN)
+
+
+def test_stable_lease_corrupted_record_fails_closed():
+    sl = StableLease(); sl.acquire("k", ttl=10.0)
+    sl._leases["k"]["ttl"] = NAN               # 记录被上游污染
+    r = sl.check("k")
+    assert r["state"] == "weak" and r["in_lease"] is False, r
+
+
+def test_stable_lease_controls_unchanged():
+    sl = StableLease(); sl.acquire("k", ttl=10.0)
+    assert sl.check("k")["state"] == "stable"
+    sl2 = StableLease(); sl2.acquire("k", ttl=-1.0)
+    assert sl2.check("k")["state"] == "weak"
+    sl3 = StableLease(); sl3.acquire("k", ttl=INF)   # 无限期租约是合法语义，保留
+    assert sl3.check("k")["state"] == "stable"
