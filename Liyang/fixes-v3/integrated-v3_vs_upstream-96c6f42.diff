@@ -0,0 +1,58 @@
+# -*- coding: utf-8 -*-
+"""回归（issue #214）：睡眠巩固（run_maintenance_cycle）接通情境层→知识层提升；
+情境记忆的结局只能是「被提升」或「被删除」，不再以 importance=0 / 归档值 0.1 永久留存。
+出口（删除线死区）已由 eb51520（core-py-01）的 decay_cycle 去预筛覆盖；本提交补转移通路。"""
+import os
+import tempfile
+import warnings
+
+warnings.filterwarnings("ignore")
+from lingshu.core.core import SpacetimeMemoryEngine, MemoryLayer  # noqa: E402
+
+
+def _eng():
+    return SpacetimeMemoryEngine(os.path.join(tempfile.mkdtemp(), "h.db"))
+
+
+def test_maintenance_cycle_promotes_worthy_context():
+    e = _eng()
+    e.self_model.trust_state["t_total"] = 1.0     # 排除 #114（默认 trust 下评分够不到 0.4）
+    n = e.add_context("用户对青霉素过敏，开药前必须核对", importance=0.4)
+    called = []
+    g = e._ensure_gate()
+    orig = g.promote_from_context
+    g.promote_from_context = lambda *a, **k: (called.append(1), orig(*a, **k))[1]
+    stats = e.run_maintenance_cycle()
+    assert called and stats["promoted"] == 1
+    m = e.store.get_node(n.id)
+    assert m.layer == MemoryLayer.KNOWLEDGE and "promoted" in m.tags
+    for _ in range(200):
+        e.run_maintenance_cycle()
+    assert e.store.get_node(n.id) is not None   # 已入知识层，不再被情境层衰减删除
+
+
+def test_promote_does_not_compare_node_with_itself():
+    e = _eng()
+    e.self_model.trust_state["t_total"] = 1.0
+    e.add_context("灰度比例先放到百分之五观察两小时再全量", importance=0.3)
+    assert len(e.promote_context_memories()) == 1
+
+
+def test_unworthy_context_is_forgotten_not_zombie():
+    e = _eng()                                   # 默认 trust：评分不够提升
+    n = e.add_context("今天下午随便聊了几句", importance=0.4)
+    for _ in range(200):
+        e.run_maintenance_cycle()
+    assert e.store.get_node(n.id) is None
+    zombies = e.store.conn.execute(
+        "SELECT count(*) FROM nodes WHERE layer='context' AND importance < 0.1").fetchone()[0]
+    assert zombies == 0
+
+
+def test_archived_context_is_forgotten():
+    e = _eng()
+    n = e.add_context("一次性验证码 482913，五分钟内有效", importance=0.15)
+    assert e.forget_advisor()["archived"] == 1
+    for _ in range(50):
+        e.decay_cycle()
+    assert e.store.get_node(n.id) is None
diff --git a/tests/test_issue215_causal_cycle_consistency.py b/tests/test_issue215_causal_cycle_consistency.py
new file mode 100644
index 0000000..570af66
--- /dev/null
+++ b/tests/test_issue215_causal_cycle_consistency.py
@@ -0,0 +1,102 @@
+# -*- coding: utf-8 -*-
+"""issue #215 回归：self_check 的环存在性与环计数一致；有环图不再无界深搜。
+
+① 环长 > max_depth+1 时：has_causal_cycle=True 而旧 self_check 报 cycles_found=0（自相矛盾）。
+   修后 cycles_found ≥1，cycle_details 给出一个首尾相接的实证环，cycles_beyond_depth=True。
+② 有环稠密图：旧 self_check 整趟枚举（60 节点/600 边量级数秒、随规模爆炸）；
+   修后有界枚举（预算触顶 cycles_truncated=True，cycles_found 为下界）。
+③ find_cycles 本身语义不变（max_depth 仍是环长上限；等价性另见 test_perf_equivalence）。
+运行：python -X utf8 -m pytest tests/test_issue215_causal_cycle_consistency.py -q
+"""
+import os
+import random
+import sys
+import time
+
+import pytest
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from lingshu.core.core import EdgeType, SpacetimeMemoryEngine  # noqa: E402
+
+
+def _mk(e, n):
+    return [e.add_perception(f"事件节点{i}：独立观察记录{i * 7919}", skip_dedup=True).id
+            for i in range(n)]
+
+
+def _ring_graph(span, n=40):
+    """n 节点单链 + 一条回边 ids[span]→ids[0]：唯一环，环长 span+1。"""
+    e = SpacetimeMemoryEngine(":memory:")
+    ids = _mk(e, n)
+    for i in range(n - 1):
+        e.add_edge(ids[i], ids[i + 1], EdgeType.CAUSAL)
+    e.add_edge(ids[span], ids[0], EdgeType.CAUSAL)
+    return e, ids
+
+
+@pytest.mark.parametrize("span", [1, 5, 8, 9, 10, 12, 15])
+def test_self_check_never_reports_zero_cycles_when_cycle_exists(span):
+    e, ids = _ring_graph(span)
+    assert e.store.has_causal_cycle() is True
+    rep = e.self_check()
+    assert rep["has_causal_cycle"] is True
+    assert rep["cycles_found"] >= 1, (span + 1, rep["cycles_found"])
+    # 实证环：首尾相接、恰为 span+1 条边、闭回起点
+    cyc_ids = rep["cycle_details"][0]
+    assert len(cyc_ids) == span + 1
+    chain = [e.store.conn.execute("SELECT source_id, target_id FROM edges WHERE id=?",
+                                  (eid,)).fetchone() for eid in cyc_ids]
+    for (s1, t1), (s2, _t2) in zip(chain, chain[1:]):
+        assert t1 == s2
+    assert chain[-1][1] == chain[0][0]
+    assert rep["cycles_beyond_depth"] is (span + 1 > 9)
+
+
+def test_find_cycles_depth_semantics_unchanged():
+    """find_cycles 仍按 max_depth 限环长（环长 ≤ max_depth+1）；矛盾由 self_check 层消解。"""
+    e, _ = _ring_graph(9)  # 环长 10
+    assert e.store.find_cycles(max_depth=8) == []
+    assert len(e.store.find_cycles(max_depth=9)) == 1
+
+
+def test_acyclic_graph_reports_no_cycle():
+    e = SpacetimeMemoryEngine(":memory:")
+    ids = _mk(e, 10)
+    for a, b in zip(ids, ids[1:]):
+        e.add_edge(a, b, EdgeType.CAUSAL)
+    rep = e.self_check()
+    assert rep["has_causal_cycle"] is False
+    assert rep["cycles_found"] == 0 and rep["cycles_truncated"] is False
+    assert rep["cycles_beyond_depth"] is False
+
+
+def test_dense_cyclic_graph_self_check_is_bounded():
+    random.seed(1)
+    e = SpacetimeMemoryEngine(":memory:")
+    ids = _mk(e, 60)
+    seen = set()
+    while len(seen) < 600:
+        a, b = random.sample(range(60), 2)
+        if (a, b) not in seen:
+            seen.add((a, b))
+            e.add_edge(ids[a], ids[b], EdgeType.CAUSAL)
+    t0 = time.perf_counter()
+    rep = e.self_check()
+    dt = time.perf_counter() - t0
+    assert rep["has_causal_cycle"] is True and rep["cycles_found"] >= 1
+    assert rep["cycles_truncated"] is True
+    assert rep["cycles_found"] <= SpacetimeMemoryEngine.SELF_CHECK_CYCLE_LIMIT
+    assert dt < 1.0, dt
+
+
+def test_small_cyclic_graph_count_is_exact():
+    """预算内（小图）计数与 find_cycles(max_depth=8) 完全一致，不截断。"""
+    e = SpacetimeMemoryEngine(":memory:")
+    a, b, c = _mk(e, 3)
+    e.add_edge(a, b, EdgeType.CAUSAL)
+    e.add_edge(b, a, EdgeType.CAUSAL)
+    e.add_edge(c, c, EdgeType.CAUSAL)
+    rep = e.self_check()
+    assert rep["cycles_found"] == len(e.store.find_cycles(max_depth=8)) == 2
+    assert rep["cycles_truncated"] is False
