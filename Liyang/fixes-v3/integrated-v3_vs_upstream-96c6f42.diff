diff --git a/lingshu/nn/_vec_atomic.py b/lingshu/nn/_vec_atomic.py
new file mode 100644
index 0000000..9898192
--- /dev/null
+++ b/lingshu/nn/_vec_atomic.py
@@ -0,0 +1,41 @@
+"""参数向量的原子读改写（issue #197）。
+
+`get_vec()` / `set_vec()` 是两次独立调用：并发下「v = get_vec(); v += δ; set_vec(v)」必然丢更新，
+且 set_vec 逐段赋值期间另一线程的 get_vec 可能读到半写状态。本混入提供：
+  * `_vec_lock`：每实例一把可重入锁（惰性创建；不参与 pickle/deepcopy）；
+  * `update_vec(fn)`：在锁内完成 读 → fn → 写，返回写入的向量；
+  * `apply_delta(delta)`：`update_vec(lambda v: v + delta)` 的便捷形。
+各网络的 get_vec/set_vec 在锁内执行，单次调用不会交错。单线程语义与读数不变。"""
+import threading
+
+_CREATE = threading.Lock()
+
+
+class AtomicVecMixin:
+    @property
+    def _vec_lock(self):
+        lk = self.__dict__.get("_vec_lock_obj")
+        if lk is None:
+            with _CREATE:
+                lk = self.__dict__.get("_vec_lock_obj")
+                if lk is None:
+                    lk = threading.RLock()
+                    self.__dict__["_vec_lock_obj"] = lk
+        return lk
+
+    def update_vec(self, fn):
+        with self._vec_lock:
+            v = fn(self.get_vec())
+            self.set_vec(v)
+            return v
+
+    def apply_delta(self, delta):
+        return self.update_vec(lambda v: v + delta)
+
+    def __getstate__(self):
+        st = dict(self.__dict__)
+        st.pop("_vec_lock_obj", None)
+        return st
+
+    def __setstate__(self, st):
+        self.__dict__.update(st)
