+# -*- coding: utf-8 -*-
+"""回归：tools/coggraph/export_coggraph 对合法 YAML front matter 的健壮性（issue 草稿 core-rest-03）。"""
+import importlib.util
+import json
+import os
+import textwrap
+
+import pytest
+
+_TOOL = os.path.join(os.path.dirname(__file__), "..", "tools", "coggraph", "export_coggraph.py")
+
+
+def _load():
+    spec = importlib.util.spec_from_file_location("export_coggraph_under_test", _TOOL)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def _md(root, rel, fm):
+    p = os.path.join(root, rel)
+    os.makedirs(os.path.dirname(p), exist_ok=True)
+    with open(p, "w", encoding="utf-8") as f:
+        f.write("---\n" + textwrap.dedent(fm).strip() + "\n---\n正文\n")
+
+
+def _export(root, out, *extra):
+    rc = _load().main(["--root", str(root), "--out", str(out), "--write", *extra])
+    with open(os.path.join(out, "graph.json"), encoding="utf-8") as f:
+        return rc, json.load(f)
+
+
+def test_numeric_id_does_not_crash_and_edges_resolve(tmp_path):
+    _md(tmp_path, "knowledge/cond_a/a.md", "id: 20261008\nlayer: knowledge")
+    _md(tmp_path, "knowledge/cond_a/b.md",
+        "id: node_b\nlayer: knowledge\nedges:\n  - {type: causal, target: 20261008}")
+    rc, g = _export(tmp_path, tmp_path / "out")
+    assert rc == 0
+    ids = {n["id"] for n in g["nodes"]}
+    assert ids == {"20261008", "node_b"}
+    assert all(isinstance(n["title"], str) for n in g["nodes"])
+    assert {"s": "node_b", "t": "20261008"}.items() <= g["edges"][0].items()
+
+
+def test_yaml_date_created_at_exports_numeric_timestamp(tmp_path):
+    _md(tmp_path, "knowledge/cond_a/c.md", "id: node_c\nlayer: knowledge\ncreated_at: 2026-10-08")
+    _md(tmp_path, "knowledge/cond_a/d.md", "id: node_d\nlayer: knowledge\ncreated_at: 1700000000")
+    rc, g = _export(tmp_path, tmp_path / "out")
+    assert rc == 0
+    created = {n["id"]: n["created"] for n in g["nodes"]}
+    assert isinstance(created["node_c"], (int, float)) and created["node_c"] > 0
+    assert created["node_d"] == 1700000000
+
+
+def test_failed_serialisation_keeps_previous_graph(tmp_path, monkeypatch):
+    out = tmp_path / "out"
+    _md(tmp_path, "knowledge/cond_a/a.md", "id: node_a\nlayer: knowledge")
+    _export(tmp_path, out)
+    before = (out / "graph.json").read_bytes()
+    mod = _load()
+
+    real_dumps, real_dump = mod.json.dumps, mod.json.dump
+
+    def _is_graph(obj):
+        return isinstance(obj, dict) and "nodes" in obj
+
+    def dumps(obj, *a, **k):  # 只让整图序列化失败（模拟某字段不可序列化）
+        if _is_graph(obj):
+            raise TypeError("boom")
+        return real_dumps(obj, *a, **k)
+
+    def dump(obj, fp, *a, **k):
+        if _is_graph(obj):
+            fp.write('{"meta": ')  # 与真实 json.dump 一样，抛错前已写出部分内容
+            raise TypeError("boom")
+        return real_dump(obj, fp, *a, **k)
+    monkeypatch.setattr(mod.json, "dumps", dumps)
+    monkeypatch.setattr(mod.json, "dump", dump)
+    with pytest.raises(TypeError):
+        mod.main(["--root", str(tmp_path), "--out", str(out), "--write"])
+    assert (out / "graph.json").read_bytes() == before
+
+
+def test_bucket_filter_excludes_root_level_nodes(tmp_path):
+    _md(tmp_path, "knowledge/cond_a/a.md", "id: node_a\nlayer: knowledge")
+    _md(tmp_path, "knowledge/cond_b/x.md", "id: node_x\nlayer: knowledge")
+    _md(tmp_path, "top.md", "id: top\nlayer: self")
+    rc, g = _export(tmp_path, tmp_path / "out", "--bucket", "cond_a")
+    assert rc == 0
+    assert [(n["id"], n["bucket"]) for n in g["nodes"]] == [("node_a", "cond_a")]
