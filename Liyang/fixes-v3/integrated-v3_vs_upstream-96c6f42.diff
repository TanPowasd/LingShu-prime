new file mode 100644
index 0000000..4cf6802
--- /dev/null
+++ b/tests/test_issue143_mcp_stderr_deadlock.py
@@ -0,0 +1,31 @@
+# -*- coding: utf-8 -*-
+"""回归（issue #143）：脑进程 stderr 写满管道缓冲时 MCPClient.call 不得死锁（issue 原复现，200KB 日志）。
+详尽传输守卫见 tests/test_mcp_client_transport.py（采纳自 PR #260）。"""
+import subprocess
+import sys
+import textwrap
+
+FAKE = textwrap.dedent('''
+    import sys, json
+    def send(o): sys.stdout.write(json.dumps(o) + "\\n"); sys.stdout.flush()
+    for line in sys.stdin:
+        m = json.loads(line)
+        if m.get("method") == "initialize":
+            send({"jsonrpc": "2.0", "id": m["id"], "result": {"serverInfo": {"name": "fake"}}})
+        elif m.get("method") == "tools/call":
+            sys.stderr.write("W" * 200000); sys.stderr.flush()
+            send({"jsonrpc": "2.0", "id": m["id"], "result": {"content": [{"text": "{}"}]}})
+''')
+
+
+def test_call_returns_despite_large_stderr(tmp_path):
+    srv = tmp_path / "fake_mcp.py"
+    srv.write_text(FAKE, encoding="utf-8")
+    code = ("from lingshu.world.brain_store import MCPClient\n"
+            f"c = MCPClient(pythonpath={str(tmp_path)!r}, args=[{str(srv)!r}])\n"
+            "print(c.call('x', {}))\n"
+            "c.close()\n")
+    # 外层 watchdog：改前 call() 永久挂起 ⇒ TimeoutExpired
+    out = subprocess.run([sys.executable, "-c", code], capture_output=True, text=True, timeout=20)
+    assert out.returncode == 0, out.stderr[-400:]
+    assert out.stdout.strip().splitlines()[-1] == "{}"
