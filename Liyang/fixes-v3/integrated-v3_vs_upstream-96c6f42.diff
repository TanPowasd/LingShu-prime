+"""回归：SpacetimeConsistency 自洽判定须计入世界状态不变量（新发现 world-n3）。
+
+修复前：实体全程埋在地下 4.5m（60/60 tick 不变量破坏），consistency_report 仍判
+verdict=self_consistent、self_consistent=True。
+"""
+from lingshu.world.spacetime_consistency import SpacetimeConsistency
+
+
+def test_underground_entity_not_self_consistent():
+    sc = SpacetimeConsistency()
+    sc.create_scene(trees=0, water=False)
+    sc.add_entity("rock", behavior="wander", pos=(5, -3, 5), speed=0.0)
+    sc.add_entity("rabbit", behavior="wander", pos=(10, 1.5, 10), speed=0.3)
+    sc.run(60)
+    r = sc.consistency_report()
+    assert r["invariant_violations"] == 60
+    assert r["self_consistent"] is False
+    assert r["verdict"] == "invariant_violated"
+
+
+def test_clean_world_still_self_consistent():
+    """正常世界（无不变量破坏）仍可判自洽——不引入误报。"""
+    sc = SpacetimeConsistency()
+    sc.create_scene(trees=0, water=False)
+    a = sc.add_entity("rock", behavior="wander", pos=(5, 1.5, 5), speed=0.0)
+    sc.add_entity("wolf", behavior="seek", goal=a, pos=(15, 1.5, 15), speed=0.3)
+    sc.run(60)
+    r = sc.consistency_report()
+    assert r["invariant_violations"] == 0
+    assert r["verdict"] == "self_consistent", r["verdict"]
+
+
+def test_violation_ages_out_of_window():
+    """不变量破坏只在最近 window tick 内阻断自洽（与漂移的「活跃」口径一致），审计计数保留。"""
+    sc = SpacetimeConsistency(window=20)
+    sc.create_scene(trees=0, water=False)
+    b = sc.add_entity("rock", behavior="wander", pos=(5, 1.5, 5), speed=0.0)
+    sc.run(10)
+    sc.teleport(b, (5, -10, 5))
+    sc.run(1)
+    sc.scene.entities[b].pos = (5.0, 1.5, 5.0)     # 外部恢复
+    sc.run(60)
+    r = sc.consistency_report()
+    assert r["invariant_violations"] >= 1 and r["recent_invariant_violations"] == 0
+    assert r["verdict"] != "invariant_violated"
