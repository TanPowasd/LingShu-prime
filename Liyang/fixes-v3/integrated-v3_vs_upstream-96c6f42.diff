+++ b/tests/test_issue278_mcp_handshake_timeout.py
@@ -0,0 +1,49 @@
+# -*- coding: utf-8 -*-
+"""issue #278：MCPClient 握手无超时——对端活着但不回包时构造阶段永久阻塞。"""
+import os, sys, time, tempfile, textwrap
+import pytest
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, REPO)
+from lingshu.world.brain_store import MCPClient, BrainError  # noqa: E402
+
+
+def _fake_pkg(body: str) -> str:
+    d = tempfile.mkdtemp(prefix="fakebrain_")
+    pkg = os.path.join(d, "fakesrv")
+    os.makedirs(pkg)
+    open(os.path.join(pkg, "__init__.py"), "w").close()
+    with open(os.path.join(pkg, "srv.py"), "w", encoding="utf-8") as f:
+        f.write(textwrap.dedent(body))
+    return d
+
+
+def test_silent_peer_raises_within_timeout():
+    d = _fake_pkg("""
+        import time
+        time.sleep(60)   # 活着但从不回包
+    """)
+    t0 = time.time()
+    with pytest.raises(BrainError):
+        MCPClient(pythonpath=d, args=["-m", "fakesrv.srv"], handshake_timeout=1.5)
+    assert time.time() - t0 < 10
+
+
+def test_normal_handshake_still_works():
+    d = _fake_pkg("""
+        import sys, json
+        for line in sys.stdin:
+            m = json.loads(line)
+            if m.get("method") == "initialize":
+                print(json.dumps({"jsonrpc": "2.0", "id": m["id"],
+                    "result": {"serverInfo": {"name": "fake", "version": "1"}}}), flush=True)
+            elif m.get("method") == "tools/call":
+                print(json.dumps({"jsonrpc": "2.0", "id": m["id"],
+                    "result": {"content": [{"text": "{\\"ok\\": 1}"}]}}), flush=True)
+    """)
+    c = MCPClient(pythonpath=d, args=["-m", "fakesrv.srv"], handshake_timeout=10)
+    try:
+        assert c.server_info.get("name") == "fake"
+        assert c.call("x", {}) == {"ok": 1}
+    finally:
+        c.close()
