  "props": {
   "P01-layer-immutability": "锚点/结构层在任意维护操作序列后内容与层不变",
   "P02-dedup-idempotent": "同一内容重复写入幂等：返回同一 id、库中只有一条",
   "P03-dedup-polarity": "去重对否定/数值敏感：插入『不』或改一个数字的句子不被合并",
   "P04-decay-monotone": "衰减单调：可衰减节点 importance 不增、被删节点不复活",
   "P05-decay-termination": "衰减终止：未保护的情境节点在有限轮（factor=0.2，≤150 轮）内被遗忘",
   "P06-export-import-roundtrip": "导出→导入往返：本地层（知识/情境）与其间的边逐项等价；共享层（锚点/结构）要么原样恢复、要么整条不导入（隔离），绝不被改写",
   "P07-cycle-vs-brute": "环检测与暴力枚举一致：has_cycle 判定 + find_cycles 计数（n≤6）",
   "P08-concurrent-no-loss": "并发写不丢：3 线程各写 8 条唯一内容，全部恰好落库一次",
   "P09-nonfinite-rejected": "非有限数值（NaN/±inf）不进库：要么被拒，要么不以非有限值存储",
   "P10-recall-no-self": "检索不返回 SELF 快照",
   "P11-sub-no-protected-write": "SUB 角色不可改写受保护层（锚点/结构）的节点与边",
   "P12-importance-range": "importance 写入后恒在 [0,1]（越界值被拒或钳制）",
   "P13-tag-exact": "按标签检索精确匹配（含 _ % 中文 前缀相同的标签）",
   "P14-gate-receipt": "门控回执层 = 实际落库层（任意 hint）",
   "P15-protected-survive": "被 protect 的节点在衰减/容量淘汰/遗忘建议后仍存在"
  }
