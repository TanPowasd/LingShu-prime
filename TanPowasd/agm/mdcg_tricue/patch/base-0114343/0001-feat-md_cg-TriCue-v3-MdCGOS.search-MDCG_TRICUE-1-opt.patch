+# -*- coding: utf-8 -*-
+"""TriCue v3 融合重排：BM25+×SDM 种子的 AGM 扩散单路 × md_cg 词法排序，倒数排名融合。
+
+开关：环境变量 ``MDCG_TRICUE``，**只有取值恰为 "1" 才打开**；未设或其它任何取值 = 关。
+关时 ``MdCGOS.search`` 只调用 ``enabled()`` 读一次开关（不建索引、不融合、meta 不落键），
+排序与读数和改动前逐位一致（守卫 ``md_cg/test_tricue_rerank.py`` 的 P1 实测证明）。
+纯标准库、零模型、零网络、无学习状态。
+
+依据（白箱三问之一：依据什么）
+------------------------------
+  · TriCue v3（TanPowasd/LingShu-prime ``agm/tricue/tricue.py`` 的 ``TriCueMemory.v3()``）
+    在 LoCoMo 留出 8 段对话上证据轮 @10 = .618（其预注册文档 gen_prereg3.md）；
+  · md_cg 自然问句的失败主要在排序：英文 1531 题里失败 848 题，260 题证据轮在 11–50 名、
+    142 题在 51–100 名、446 题不在前 100（dsh-memory 8d5c5f0 实测）。字二元组 lexical_sim
+    对英文整词问句区分度低，BM25+×SDM 的整词 idf + 邻接对特征补的正是这一块。
+
+算法（参数全部固定；只有融合权重 ``W_TRICUE`` 在 LoCoMo dev 两段对话上选定，见预注册）
+------------------------------------------------------------------------------------
+  词项    中日韩连续段取重叠字二元组（单字段取单字），其余字母数字串取小写整词（有序）；
+  打分    BM25+（k1=1.2, b=0.75, δ=1）× SDM 三类特征：单词项 0.85 / 有序相邻对 0.10 /
+          无序窗口对（窗口 8）0.05；无序对只在前两类得分前 ``UW_TOP`` 篇内计算；
+  图      候选域按写入先后（created_at，同值按 id）排成一列，相邻两节点连边：
+          前→后 0.4、后→前 0.25（TriCue 的「上一轮末块→本轮首块」问答邻接，一个节点 = 一块）；
+  AGM     打分前 8 名为种子（按最高分归一），沿图扩散 2 步，非种子每步衰减 35%，
+          阈值 0.05，k-WTA 80；放电节点按激活排序，其后接打分剩余节点；
+  融合    md_cg 路 = 本阶段 md_cg 打分 > 0 的候选，按 ``_emit`` 同一排序键排名；
+          TriCue 路 = 上述 AGM 序前 ``LIMIT`` 名；
+          融合分 = Σ_md_cg 1/(K+名次) + W_TRICUE · Σ_TriCue 1/(K+名次)（名次从 1 起）；
+          TriCue 路带进来、md_cg 本阶段没打过分的节点，用同一个 ``_score`` 补打（只为生成结果卡）。
+
+生效条件（白箱三问之二：在什么条件下成立）
+------------------------------------------
+  · 只在全局阶段生效：T2（全量 LIKE，含 reach 收敛实现）与 T3（全量兜底）；
+    桶阶段（有 context 路由）**不**生效——路由桶是调用方给的语义约束，本模块不越过它；
+  · 候选域 = 本阶段已读入的全部候选文档（T2/T3 = 治理过滤后的全量 ``docs_all``；
+    reach 打开时 = 其收敛集），结果只可能来自候选域，层/角色/会话/时效等过滤一律不被绕开；
+  · 阶段是否「有结果」（``try_stage`` 的 valid 计数）仍按 md_cg 原分判定，阶梯走向不变；
+  · 正文取 ``_positive_body``（剥掉「# 不适用条件」段），与 md_cg 召回键同一立场；
+  · 打开时结果的 score 是**融合分**（量级约 0.01–0.07），不再是 md_cg 的 [0,1] 相似度；
+    每条结果的 md_cg 原分、两路名次在 ``meta["tricue"]["top"]`` 里可查。
+
+错了怎么办 / 边界（白箱三问之三）
+--------------------------------
+  · 关掉开关即回到原排序（逐位）；
+  · 写入邻接边假设「相邻写入的节点在说同一段事」：多个对话交错写入时，这条边会把无关节点
+    连起来（推断：会拉低 AGM 扩散的净收益，未测）；
+  · 索引按（索引代际，候选域 id 序列）缓存，任何写入都会让下次查询整库重建（O(N)）；
+    reach 收敛集每问不同 ⇒ 每问重建，**reach 与本开关同开时的延迟未测（存疑）**；
+  · ``MdCG.search``（基类）与 ``search_rrf`` 未接入（本模块只接 MdCGOS.search 生产路径）。
+"""
+from __future__ import annotations
+
+import bisect
+import collections
+import math
+import os
+import re
+
+# BM25+（Lv & Zhai 2011）× SDM（Metzler & Croft 2005），文献默认值，与 TriCue v3 相同
+K1, B, DELTA = 1.2, 0.75, 1.0
+SDM_W = (0.85, 0.10, 0.05)          # 单词项 / 有序相邻对 / 无序窗口对
+SDM_WIN = 8
+UW_TOP = 1000
+# AGM 扩散，与 TriCue v3 相同
+SEEDS, DECAY, THETA, KWTA, STEPS = 8, 0.35, 0.05, 80, 2
+W_FWD, W_BWD = 0.4, 0.25            # 写入邻接：前→后 / 后→前
+# 融合：K 与 TriCue 的 RRF_K 相同；W_TRICUE 与 LIMIT 在 LoCoMo dev（conv-30、conv-47）上预注册选定
+RRF_K = 60
+W_TRICUE = 3.0
+LIMIT = 100
+
+_CJK = re.compile(r"[\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff\u3040-\u30ff\uac00-\ud7af]+")
+_WORD = re.compile(r"[^\W_]+", re.UNICODE)
+
+
+# 生效条件：环境变量 MDCG_TRICUE 恰为 "1" 时返回 True；未设或其它取值返回 False。
+def enabled() -> bool:
+    return os.environ.get("MDCG_TRICUE") == "1"
+
+
+# 生效条件：s 为任意字符串；中日韩连续段取重叠字二元组（单字段取单字），其余字母数字串取小写整词，保持原序。
+def seq_tokens(s: str) -> list:
+    out = []
+    for w in _WORD.findall(s or ""):
+        pos = 0
+        for m in _CJK.finditer(w):
+            if m.start() > pos:
+                out.append(w[pos:m.start()].lower())
+            run = m.group()
+            if len(run) > 1:
+                out.extend(run[i:i + 2] for i in range(len(run) - 1))
+            else:
+                out.append(run)
+            pos = m.end()
+        if pos < len(w):
+            out.append(w[pos:].lower())
+    return out
+
+
+class _SDM:
+    """文档级 BM25+ × SDM 三类特征（与 TriCue v3 的 BM25PlusSDM 同式）。"""
+
+    def __init__(self):
+        self.tf, self.tf2, self.pos, self.dl = [], [], [], []
+        self.inv = collections.defaultdict(list)
+        self.inv2 = collections.defaultdict(list)
+        self.total = 0
+
+    def add(self, toks):
+        d = len(self.dl)
+        c = collections.Counter(toks)
+        c2 = collections.Counter(zip(toks, toks[1:]))
+        p = collections.defaultdict(list)
+        for i, t in enumerate(toks):
+            p[t].append(i)
+        self.tf.append(c); self.tf2.append(c2); self.pos.append(dict(p)); self.dl.append(len(toks))
+        self.total += len(toks)
+        for t in c:
+            self.inv[t].append(d)
+        for t in c2:
+            self.inv2[t].append(d)
+
+    def _part(self, tf, df, dl, avg):
+        idf = math.log((len(self.dl) + 1) / df)
+        return idf * ((K1 + 1) * tf / (K1 * (1 - B + B * dl / avg) + tf) + DELTA)
+
+    @staticmethod
+    def _uw(pa, pb):
+        n = 0
+        for x in pa:
+            i = bisect.bisect_left(pb, x - SDM_WIN + 1)
+            while i < len(pb) and pb[i] <= x + SDM_WIN - 1:
+                if pb[i] != x:
+                    n += 1
+                    break
+                i += 1
+        return n
+
+    def score(self, q):
+        if not self.dl or not q:
+            return {}
+        avg = self.total / len(self.dl) or 1.0
+        sc = collections.defaultdict(float)
+        wt, wo, wu = SDM_W
+        for t in set(q):
+            post = self.inv.get(t)
+            if post:
+                for d in post:
+                    sc[d] += wt * self._part(self.tf[d][t], len(post), self.dl[d], avg)
+        pairs = {(a, b) for a, b in zip(q, q[1:]) if a != b}
+        for pr in pairs:
+            post = self.inv2.get(pr)
+            if post:
+                for d in post:
+                    sc[d] += wo * self._part(self.tf2[d][pr], len(post), self.dl[d], avg)
+        cand = set(sorted(sc, key=lambda d: (-sc[d], d))[:UW_TOP])
+        for a, b in pairs:
+            pa_, pb_ = self.inv.get(a), self.inv.get(b)
+            if not pa_ or not pb_:
+                continue
+            both = set(pa_).intersection(pb_) & cand
+            hits = {}
+            for d in both:
+                n = self._uw(self.pos[d][a], self.pos[d][b])
+                if n:
+                    hits[d] = n
+            for d, n in hits.items():
+                sc[d] += wu * self._part(n, len(hits), self.dl[d], avg)
+        return sc
+
+
+class TriCueIndex:
+    """候选域上的 TriCue v3 排序器。ids 与 texts 按写入先后给出。"""
+
+    def __init__(self, ids, texts):
+        if len(ids) != len(texts):
+            raise ValueError("ids 与 texts 长度不一致")
+        self.ids = list(ids)
+        self.sdm = _SDM()
+        for t in texts:
+            self.sdm.add(seq_tokens(t))
+
+    def _neighbors(self, i):
+        n = len(self.ids)
+        if i + 1 < n:
+            yield i + 1, W_FWD
+        if i > 0:
+            yield i - 1, W_BWD
+
+    # 生效条件：query 为字符串；无任何词项命中时返回 []；否则返回 AGM 放电节点（激活降序）+ 其余打分节点（分降序），元素为 id。
+    def rank(self, query):
+        sc = self.sdm.score(seq_tokens(query))
+        if not sc:
+            return []
+        top = sorted(sc, key=lambda i: (-sc[i], i))[:SEEDS]
+        m = sc[top[0]] or 1.0
+        x = {i: sc[i] / m for i in top}
+        a = dict(x)
+        for _ in range(STEPS):
+            nxt = collections.defaultdict(float)
+            for i, ai in a.items():
+                for j, w in self._neighbors(i):
+                    nxt[j] += ai * w
+            for i, v in x.items():
+                nxt[i] += v
+            nxt = {i: (v if i in x else (1 - DECAY) * v) for i, v in nxt.items()}
+            a = dict(sorted(((i, v) for i, v in nxt.items() if v >= THETA),
+                            key=lambda kv: (-kv[1], kv[0]))[:KWTA])
+        fired = sorted(a, key=lambda i: (-a[i], i))
+        rest = sorted((i for i in sc if i not in a), key=lambda i: (-sc[i], i))
+        return [self.ids[i] for i in fired + rest]
+
+
+# 生效条件：docs 为 (entry, fm, content) 序列；返回按 (created_at, id) 升序的 (id, doc) 列表——写入先后的唯一判据单点。
+def write_order(docs):
+    def key(d):
+        e, fm = d[0], d[1]
+        ca = e.get("created_at")
+        if ca is None:
+            ca = fm.get("created_at")
+        try:
+            ca = float(ca or 0)
+        except (TypeError, ValueError):
+            ca = 0.0
+        return (ca, str(fm.get("id") or e.get("path") or ""))
+    return [(str(d[1].get("id") or d[0].get("path")), d) for d in sorted(docs, key=key)]
+
+
+# 生效条件：cg 为 MdCGOS 实例、docs 为候选域；按（索引代际, 域 id 序列）命中实例缓存即复用，否则重建；返回 (index, rebuilt)。
+def index_for(cg, docs):
+    order = write_order(docs)
+    key = (cg._index_generation(), tuple(i for i, _ in order))
+    cached = getattr(cg, "_tricue_cache", None)
+    if cached is not None and cached[0] == key:
+        return cached[1], False
+    texts = [cg._positive_body(d[0], d[2]) for _, d in order]
+    idx = TriCueIndex([i for i, _ in order], texts)
+    cg._tricue_cache = (key, idx)
+    return idx, True
+
+
+# 生效条件：scored 为本阶段 md_cg 的 (card, score) 列表、docs 为候选域、score_fn(docs) 与 _score 同形；返回融合后的 (card, 融合分) 列表与审计块。
+def fuse(cg, scored, docs, query, score_fn):
+    from .mdcg import EXACT_HIT_KEY
+    idx, rebuilt = index_for(cg, docs)
+    md = sorted((x for x in scored if x[1] > 0),
+                key=lambda x: (-x[1], -int(x[0].get(EXACT_HIT_KEY) or 0),
+                               -float(x[0]["frontmatter"].get("importance") or 0),
+                               str(x[0].get("id") or "")))
+    tc = idx.rank(query)[:LIMIT]
+    fs = collections.defaultdict(float)
+    md_rank, tc_rank = {}, {}
+    for r, (card, _) in enumerate(md, 1):
+        cid = str(card.get("id"))
+        md_rank[cid] = r
+        fs[cid] += 1.0 / (RRF_K + r)
+    for r, cid in enumerate(tc, 1):
+        tc_rank[cid] = r
+        fs[cid] += W_TRICUE / (RRF_K + r)
+    cards = {str(c.get("id")): (c, s) for c, s in scored}
+    missing = [cid for cid in tc if cid not in cards]
+    if missing:
+        by_id = {i: d for i, d in write_order(docs)}
+        for c, s in score_fn([by_id[cid] for cid in missing]):
+            cards[str(c.get("id"))] = (c, s)
+    out = [(cards[cid][0], fs[cid]) for cid in fs]
+    out += [(c, s) for cid, (c, s) in cards.items() if cid not in fs]
+    top = sorted(fs, key=lambda cid: -fs[cid])[:20]
+    audit = {"on": True, "w": W_TRICUE, "k": RRF_K, "limit": LIMIT,
+             "domain": len(idx.ids), "rebuilt": rebuilt, "added": len(missing),
+             "score_kind": "rrf_fused",
+             "top": [{"id": cid, "mdcg_rank": md_rank.get(cid), "tricue_rank": tc_rank.get(cid),
+                      "mdcg_score": cards[cid][1]} for cid in top]}
+    return out, audit
