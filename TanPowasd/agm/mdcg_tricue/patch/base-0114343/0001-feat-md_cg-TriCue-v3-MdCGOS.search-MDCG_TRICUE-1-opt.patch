index 0000000..f1259a1
--- /dev/null
+++ b/md_cg/test_tricue_rerank.py
@@ -0,0 +1,274 @@
+# -*- coding: utf-8 -*-
+"""TriCue 融合重排守卫（md_cg/tricue_rerank.py + MdCGOS.search 接线，MDCG_TRICUE opt-in）。
+
+判据面（合成小库，确定性，零模型，零网络；库建在系统临时目录）：
+  P1 缺省关：MDCG_TRICUE 未设 / "0" / "true" / "" 时 fuse 一次都不调用，meta 无 "tricue" 键，
+     且结果（id 与分）与「fuse 被替换成抛异常」时逐位相同
+  P2 打开生效：整词问句「What instrument does Dana play?」——关闭时目标轮不在前 3，
+     打开后目标轮排第一，meta["tricue"] 落键且 score_kind == "rrf_fused"
+  P3 写入邻接（AGM）：与问句零词面交集的答句，因紧跟强匹配轮写入而进入打开后的前 5；
+     关闭时它不在结果里
+  P4 候选域不越界：同文节点放在 contextual 层，search(layer="knowledge") 打开后也不出现
+  P5 正文立场：只在「# 不适用条件」段里含问句词的节点，TriCue 词法分为 0（与 md_cg 召回键同立场）
+  P6 桶阶段不接：有 context 路由且桶内命中时，打开也不融合（meta 无 "tricue"）
+  P7 确定性：同输入两次结果与融合名次逐位相同；第二次复用索引缓存（rebuilt=False）
+  P8 输入校验：TriCueIndex 的 ids / texts 长度不一致 ⇒ ValueError
+
+运行：
+  python -X utf8 -m md_cg.test_tricue_rerank             # 正向（P1–P8）
+  python -X utf8 -m md_cg.test_tricue_rerank --mutate    # 定点变异自证（每条变异恰好点红其目标判据）
+  python -X utf8 -m md_cg.test_tricue_rerank --mutate --list
+
+退出码（fail-closed）：0 全绿；1 有断言失败 / 变异未恰好点红；2 变异锚点在源码里不唯一（锚点漂移）。
+变异不写工作区：子进程在**内存里**把被测模块的源码文本做一次替换后 exec 成同名模块
+（sys.modules 注入），再跑全部判据；子进程崩溃（无红单）一律判变异失败。
+"""
+import atexit
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import types
+
+_REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, _REPO)
+
+PASS = 0
+FAIL = 0
+FAILS = []
+
+
+def check(name, cond, detail=""):
+    global PASS, FAIL
+    if cond:
+        PASS += 1
+        print(f"  OK   {name}")
+    else:
+        FAIL += 1
+        FAILS.append(name)
+        print(f"  FAIL {name}  {detail}")
+
+
+TARGET, ADJ_SEED, ADJ_ANS, NEGCOND = "dana_play", "kit_seed", "kit_answer", "neg_cond"
+Q_PLAY = "What instrument does Dana play?"
+Q_KIT = "What is the name of the kitten Alice adopted from the shelter?"
+
+
+def corpus():
+    """(id, 正文, layer, tags) 按写入先后。"""
+    fill = ["Bob: Morning! Did you sleep well after the long trip?",
+            "Alice: The bakery downtown finally reopened this week.",
+            "Bob: Congratulations on finishing the marathon.",
+            "Alice: The train was late again, so I walked.",
+            "Bob: We should repaint the fence before winter.",
+            "Alice: My cousin moved to a farm up north.",
+            "Bob: The library extended its weekend hours."]
+    rows = [("mid_0", fill[0], "knowledge", []),
+            (ADJ_SEED, "Alice: I adopted a little grey kitten from the shelter last spring.", "knowledge", []),
+            (ADJ_ANS, "Bob: Pepper suits her so well!", "knowledge", []),
+            ("mid_1", fill[1], "knowledge", []),
+            (TARGET, "Dana: I play the oboe in a small orchestra.", "knowledge", []),
+            ("mid_2", fill[2], "knowledge", []),
+            ("mid_3", fill[3], "knowledge", [])]
+    # 字二元组意义上与问句高度重叠、但没有整词「dana」「play」的干扰轮
+    for i in range(30):
+        rows.append((f"noise_{i}", f"Gina: instrumentation and display playlists at the instrumental "
+                                   f"plaza, danube daily notes {i}", "knowledge", []))
+    rows += [("mid_4", fill[4], "knowledge", []),
+             (NEGCOND, "Eve: the garden looks quiet today.\n# 不适用条件：oboe orchestra Dana play instrument",
+              "knowledge", []),
+             ("mid_5", fill[5], "knowledge", []),
+             ("ctx_dup", "Dana: I play the oboe in a small orchestra every weekend.", "contextual", []),
+             ("mid_6", fill[6], "knowledge", []),
+             ("bucket_0", "Frank: instrumental display stands at the plaza exhibition.", "knowledge",
+              ["domain:music"])]
+    return rows
+
+
+def build(root):
+    from md_cg.mdcos import MdCGOS
+    cg = MdCGOS(os.path.join(root, "mem"))
+    for nid, text, layer, tags in corpus():
+        cg.add(nid, text, layer=layer, verification_basis="data", tags=tags)
+    return cg
+
+
+def search(cg, q, env, k=5, **kw):
+    old = os.environ.get("MDCG_TRICUE")
+    try:
+        if env is None:
+            os.environ.pop("MDCG_TRICUE", None)
+        else:
+            os.environ["MDCG_TRICUE"] = env
+        r, m = cg.search(q, k=k, judge=False, record=False, **kw)
+    finally:
+        if old is None:
+            os.environ.pop("MDCG_TRICUE", None)
+        else:
+            os.environ["MDCG_TRICUE"] = old
+    return [(x[0]["id"], x[1]) for x in r], m
+
+
+def run():
+    from md_cg import tricue_rerank as tr
+    root = tempfile.mkdtemp(prefix="tricue_guard_")
+    # 删除登记在 atexit（后进先出）：库的退出期刷盘先跑完再删，免得刷盘时目录已不在
+    atexit.register(shutil.rmtree, root, True)
+    cg = build(root)
+
+    print("[P1] 缺省关")
+    calls = []
+    real = tr.fuse
+
+    def spy(*a, **kw):
+        calls.append(1)
+        raise RuntimeError("关闭态不应调用 fuse")
+    off_ref = {q: search(cg, q, None) for q in (Q_PLAY, Q_KIT)}
+    tr.fuse = spy
+    try:
+        same, nokey = True, True
+        for env in (None, "0", "true", ""):
+            for q in (Q_PLAY, Q_KIT):
+                try:
+                    r, m = search(cg, q, env)
+                except RuntimeError:
+                    r, m = None, {"tricue": "called"}
+                same &= r == off_ref[q][0]
+                nokey &= "tricue" not in m
+    finally:
+        tr.fuse = real
+    check("P1 关闭态 fuse 调用 0 次", not calls, f"calls={len(calls)}")
+    check("P1 关闭态 meta 无 tricue 键", nokey)
+    check("P1 关闭态结果逐位相同（未设/0/true/空串）", same)
+
+    print("[P2] 打开生效")
+    off, _ = search(cg, Q_PLAY, None)
+    on, m_on = search(cg, Q_PLAY, "1")
+    check("P2 关闭时目标轮不在前 3", TARGET not in [i for i, _ in off[:3]], f"off={off[:5]}")
+    check("P2 打开后目标轮排第一", [i for i, _ in on[:1]] == [TARGET], f"on={on[:5]}")
+    tc = m_on.get("tricue") or {}
+    check("P2 meta.tricue 落键且 score_kind=rrf_fused",
+          tc.get("on") is True and tc.get("score_kind") == "rrf_fused", str(tc)[:200])
+
+    print("[P3] 写入邻接（AGM）")
+    offk, _ = search(cg, Q_KIT, None)
+    onk, _ = search(cg, Q_KIT, "1")
+    check("P3 关闭时零交集答句不在结果", ADJ_ANS not in [i for i, _ in offk], f"off={offk}")
+    check("P3 打开后零交集答句进前 5", ADJ_ANS in [i for i, _ in onk[:5]], f"on={onk}")
+
+    print("[P4] 候选域不越界")
+    on4, _ = search(cg, Q_PLAY, "1", k=20, layer="knowledge")
+    check("P4 contextual 层同文节点不出现", "ctx_dup" not in [i for i, _ in on4], f"on={on4[:8]}")
+
+    print("[P5] 正文立场")
+    from md_cg.tricue_rerank import TriCueIndex
+    entries = list(cg.index["nodes"].values())      # 先取快照（H-4 契约：共享 nodes 不裸迭代）
+    docs = [d for d in cg._read_many(entries, {"scanned": 0}) if d[1].get("layer") == "knowledge"]
+    idx, _ = tr.index_for(cg, docs)
+    lex = {idx.ids[i] for i in idx.sdm.score(tr.seq_tokens(Q_PLAY))}
+    check("P5 只在不适用条件段命中的节点不得 TriCue 词法分", NEGCOND not in lex, f"lex={sorted(lex)}")
+
+    print("[P6] 桶阶段不接")
+    r6, m6 = search(cg, "instrumental display", "1", context={"tags": ["domain:music"]})
+    check("P6 桶阶段命中（前提）", str(m6.get("tier", "")).startswith("T0"), str(m6.get("tier")))
+    check("P6 桶阶段打开也不融合", "tricue" not in m6, str(m6.get("tricue"))[:120])
+
+    print("[P7] 确定性")
+    # 只比结果与融合名次；meta.tricue.rebuilt 首问为 True、复用缓存后为 False，属设计内差异
+    (r1, m1), (r2, m2) = search(cg, Q_PLAY, "1"), search(cg, Q_PLAY, "1")
+    check("P7 两次结果与融合名次逐位相同",
+          r1 == r2 and m1["tricue"]["top"] == m2["tricue"]["top"] and m2["tricue"]["rebuilt"] is False)
+
+    print("[P8] 输入校验")
+    try:
+        TriCueIndex(["a", "b"], ["x"])
+        ok = False
+    except ValueError:
+        ok = True
+    check("P8 长度不一致 ⇒ ValueError", ok)
+
+
+#: (名, 被测模块, 锚点, 替换, 期望点红的判据集合)
+MUTATIONS = [
+    ("M1 缺省改开", "md_cg.tricue_rerank", 'return os.environ.get("MDCG_TRICUE") == "1"',
+     'return os.environ.get("MDCG_TRICUE") != "0"',
+     {"P1 关闭态 fuse 调用 0 次", "P1 关闭态 meta 无 tricue 键", "P1 关闭态结果逐位相同（未设/0/true/空串）",
+      "P2 关闭时目标轮不在前 3", "P3 关闭时零交集答句不在结果"}),
+    ("M2 TriCue 路权重归零", "md_cg.tricue_rerank", "W_TRICUE = 3.0", "W_TRICUE = 0.0",
+     {"P2 打开后目标轮排第一", "P3 打开后零交集答句进前 5"}),
+    ("M3 去掉写入邻接边", "md_cg.tricue_rerank", "        if i + 1 < n:\n            yield i + 1, W_FWD",
+     "        if False:\n            yield i + 1, W_FWD", {"P3 打开后零交集答句进前 5"}),
+    ("M4 候选域换成全库", "md_cg.mdcos", "scored=_prescored(hits, scored_h), domain=docs_all)",
+     'scored=_prescored(hits, scored_h), domain=self._read_many(list(self.index["nodes"].values()), stat))',
+     {"P4 contextual 层同文节点不出现"}),
+    ("M5 正文不剥不适用条件", "md_cg.tricue_rerank", "texts = [cg._positive_body(d[0], d[2]) for _, d in order]",
+     "texts = [d[2] for _, d in order]",
+     # 不剥反例段时，反例节点在 TriCue 路成了强命中、挤到目标轮前面，故 P2 同红属语义必然
+     {"P5 只在不适用条件段命中的节点不得 TriCue 词法分", "P2 打开后目标轮排第一"}),
+    ("M6 桶阶段也融合", "md_cg.mdcos", "                if _tc_on and domain is not None:\n",
+     "                if _tc_on:\n                    domain = docs if domain is None else domain\n",
+     {"P6 桶阶段打开也不融合"}),
+]
+
+
+def _src_path(mod):
+    return os.path.join(_REPO, *mod.split(".")) + ".py"
+
+
+def _child(i):
+    """子进程：在内存里装入变异后的模块，再跑全部判据（不落盘）。"""
+    _, mod, anchor, repl, _ = MUTATIONS[i]
+    import md_cg  # 先装包（__init__ 不引入 mdcos / tricue_rerank）
+    path = _src_path(mod)
+    src = open(path, encoding="utf-8").read()
+    m = types.ModuleType(mod)
+    m.__file__ = path
+    m.__package__ = "md_cg"
+    sys.modules[mod] = m
+    setattr(md_cg, mod.split(".")[-1], m)
+    exec(compile(src.replace(anchor, repl), path, "exec"), m.__dict__)
+    run()
+
+
+def mutate(list_only=False):
+    if list_only:
+        for name, mod, *_, want in MUTATIONS:
+            print(f"{name}（{mod}） ⇒ 期望点红：{sorted(want)}")
+        return 0
+    for name, mod, anchor, _, _ in MUTATIONS:
+        n = open(_src_path(mod), encoding="utf-8").read().count(anchor)
+        if n != 1:
+            print(f"ANCHOR-MISS {name}: 锚点在 {mod} 命中 {n} 次")
+            return 2
+    bad = 0
+    for i, (name, _, _, _, want) in enumerate(MUTATIONS):
+        env = dict(os.environ, PYTHONUTF8="1")
+        env.pop("MDCG_TRICUE", None)
+        p = subprocess.run([sys.executable, "-X", "utf8", "-m", "md_cg.test_tricue_rerank", "--child", str(i)],
+                           cwd=_REPO, capture_output=True, text=True, encoding="utf-8", env=env)
+        reds = {ln[len("REDLIST "):] for ln in p.stdout.splitlines() if ln.startswith("REDLIST ")}
+        ok = bool(reds) and reds == want
+        bad += not ok
+        print(f"  {'OK  ' if ok else 'FAIL'} {name}: 红 {sorted(reds)}" + ("" if ok else f"  期望 {sorted(want)}"
+              + ("" if reds else f"  子进程 rc={p.returncode} stderr 尾：{p.stderr[-300:]}")))
+    print(f"变异 {len(MUTATIONS)} 条，未恰好点红 {bad} 条")
+    return 1 if bad else 0
+
+
+def _finish():
+    if "--json-fails" in sys.argv or "--child" in sys.argv:
+        for f in FAILS:
+            print("REDLIST " + f)
+    print(f"通过 {PASS} / 失败 {FAIL}")
+    return 1 if FAIL else 0
+
+
+if __name__ == "__main__":
+    if "--mutate" in sys.argv:
+        sys.exit(mutate("--list" in sys.argv))
+    if "--child" in sys.argv:
+        _child(int(sys.argv[sys.argv.index("--child") + 1]))
+        sys.exit(_finish())
+    run()
+    sys.exit(_finish())
